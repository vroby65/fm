#!/usr/bin/env bash
# fm: file manager a uno o due pannelli, senza librerie TUI esterne.
# Richiede Bash >= 4 (array associativi), stty e i comandi GNU di base.
set -u

usage() {
    cat <<'HELP'
Uso: fm [DIRECTORY]

File manager TUI a uno o due pannelli (Bash, senza ncurses).

 Frecce Su/Giu                   seleziona la riga (stile Lynx)
 Freccia Destra / Invio           apre dir o avvia file eseguibile
 Freccia Sinistra / Backspace     torna alla directory padre
 PgUp / PgDn / Home / End         navigazione veloce
 F2                               rinomina il file o la directory
 F3 (oppure Spazio)              seleziona/deseleziona
 F4                               edita con $EDITOR (oppure nano)
 F5                               copia nell’altro pannello (o chiede destinazione)
 F6                               sposta nell’altro pannello (o chiede destinazione)
 F7                               crea una directory
 F8                               cancella (chiede conferma)
 F10                              esci dal file manager
 Ctrl+X poi C                     finestra permessi stile MC
 Ctrl+X poi O                     finestra proprietario/gruppo
 Ctrl+S                           crea link assoluto <nome>.lnk
 Ctrl+F                           filtro per nome (vuoto per rimuoverlo)
 Tab                              cambia pannello (da 100 colonne)
 Mouse click                      seleziona / doppio click apre
 Rotella mouse                    scorre l'elenco
 r                                aggiorna la lista
 q                                esci

Opzioni d'ambiente:
 ABFM_NO_ALT_SCREEN=1             non usare lo schermo alternativo
 ABFM_NO_COLOR=1                  disabilita i colori ANSI
 ABFM_ASCII=1                     forza cornici ASCII al posto del box drawing
HELP
}

if [[ ${1:-} == --help || ${1:-} == -h ]]; then
    usage
    exit 0
fi
if (( $# > 1 )); then
    usage >&2
    exit 2
fi
if [[ ! -t 0 || ! -t 1 || ! -r /dev/tty ]]; then
    printf 'fm: eseguire in un terminale interattivo.\n' >&2
    exit 1
fi
if ! command -v stty >/dev/null 2>&1; then
    printf 'fm: stty non disponibile.\n' >&2
    exit 1
fi
if ! cwd=$(cd -P -- "${1:-.}" 2>/dev/null && pwd -P); then
    printf 'fm: directory non accessibile: %s\n' "${1:-.}" >&2
    exit 1
fi

# Manteniamo aperto /dev/tty: input e output rimangono affidabili anche in pipe.
exec 9<>/dev/tty
original_tty=$(stty -g <&9) || exit 1
alt_screen=1
[[ ${ABFM_NO_ALT_SCREEN:-0} == 1 ]] && alt_screen=0
mouse_enabled=0
declare -a entries=() targets=()
declare -A marks=()
declare -a action_keys=() action_starts=() action_ends=()
notice='Lynx: Su/Giu scegli, Destra apre, Sinistra torna. q esce.'
cursor=0
scroll=0
rows=24 cols=80 visible=12 inner=78
items_y=4
actions_y=0
last_click_ms=0
last_click_path=''
MOUSE_BTN=0; MOUSE_X=0; MOUSE_Y=0; MOUSE_ACTION=''
PENDING_CHAR=''
active_pane=0 dual_pane=0 pane_x=1 pane_width=80 filter='' resized=0
declare -a pane_dirs=("$cwd" "$cwd") pane_cursors=(1 1) pane_scrolls=(0 0) pane_filters=('' '')
declare -A pane_marks=()
# Coordinate di rendering: righe salvate per evitare redraw completi.
needs_full=1
painted_rows=0 painted_cols=0 painted_scroll=-1 painted_cursor=-1
painted_notice=''
USE_COLOR=1; USE_UNICODE=1
CLR_RESET='' CLR_BORDER='' CLR_TITLE='' CLR_STATUS='' CLR_NOTICE='' CLR_CURSOR='' CLR_ACTION=''
CLR_PANEL='' CLR_DIR='' CLR_EXEC='' CLR_LINK='' CLR_BADLINK=''
CLR_MARKED='' CLR_MARK_CURSOR='' CLR_FOOTER='' CLR_HOTKEY=''
C_TL='+' C_TR='+' C_BL='+' C_BR='+' C_H='-' C_V='|' C_LT='+' C_RT='+'
init_theme() {
    local locale=${LC_ALL:-${LC_CTYPE:-${LANG:-}}}
    USE_COLOR=1; USE_UNICODE=1
    [[ -n ${NO_COLOR:-} || ${ABFM_NO_COLOR:-0} == 1 || ${TERM:-} == dumb ]] && USE_COLOR=0
    [[ ${ABFM_ASCII:-0} == 1 ]] && USE_UNICODE=0
    [[ $locale != *UTF-8* && $locale != *utf8* && $locale != *utf-8* ]] && USE_UNICODE=0
    # Palette neutra grigia con colori per tipo file, ANSI 256 colori.
    if (( USE_COLOR )); then
        CLR_RESET=$'\033[0m'
        # Tema grigio neutro: pannello grafite, evidenziazione chiara.
        CLR_PANEL=$'\033[38;5;252;48;5;240m'
        CLR_BORDER=$'\033[38;5;252;48;5;240m'
        CLR_TITLE=$'\033[1;38;5;255;48;5;240m'
        CLR_DIR=$'\033[1;38;5;255;48;5;240m'
        CLR_EXEC=$'\033[38;5;120;48;5;240m'
        CLR_LINK=$'\033[38;5;117;48;5;240m'
        CLR_BADLINK=$'\033[38;5;210;48;5;240m'
        CLR_MARKED=$'\033[1;38;5;228;48;5;240m'
        CLR_CURSOR=$'\033[38;5;232;48;5;250m'
        CLR_MARK_CURSOR=$'\033[1;38;5;130;48;5;250m'
        CLR_STATUS=$'\033[38;5;236;48;5;250m'
        CLR_NOTICE=$'\033[38;5;255;48;5;240m'
        CLR_FOOTER=$'\033[38;5;254;48;5;236m'
        CLR_HOTKEY=$'\033[38;5;232;48;5;250m'
    fi

    if (( USE_UNICODE )); then
        C_TL='┌'; C_TR='┐'; C_BL='└'; C_BR='┘'; C_H='─'; C_V='│'; C_LT='├'; C_RT='┤'
    fi
}
cleanup() {
    trap - EXIT INT TERM HUP WINCH
    stty "$original_tty" <&9 2>/dev/null || :
    if (( mouse_enabled )); then
        printf '\033[?1000l\033[?1006l' >&9
    fi
    printf '%s\033[?25h' "$CLR_RESET" >&9
    (( alt_screen )) && printf '\033[?1049l' >&9
    exec 9>&-
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP
trap 'resized=1; needs_full=1' WINCH
stty -echo -icanon -icrnl -ixon min 1 time 0 <&9 || exit 1
init_theme
(( alt_screen )) && printf '\033[?1049h' >&9
printf '\033[?25l' >&9
printf '\033[?1000h\033[?1006h' >&9
mouse_enabled=1
shopt -s nullglob dotglob

safe() {
    local value=$1
    value=${value//[$'\001'-$'\037'$'\177']/\?}
    REPLY=$value
}

fit() {
    safe "$1"
    local str=$REPLY max=$2
    if (( ${#str} > max )); then
        if (( max > 3 )); then
            REPLY="${str:0:max-3}..."
        else
            REPLY="${str:0:max}"
        fi
    else
        REPLY=$str
    fi
}

line_text() {
    local s=$1 style=${2:-}
    fit "$s" "$inner"
    printf '%s%s%s' "$CLR_BORDER" "$C_V" "${style:-$CLR_PANEL}" >&9
    printf '%-*s' "$inner" "$REPLY" >&9
    printf '%s%s%s\r\n' "$CLR_BORDER" "$C_V" "$CLR_RESET" >&9
}
border() {
    local kind=${1:-mid} left right d
    printf -v d '%*s' "$inner" ''
    d=${d// /$C_H}
    case $kind in
        top) left=$C_TL; right=$C_TR ;;
        bottom) left=$C_BL; right=$C_BR ;;
        *) left=$C_LT; right=$C_RT ;;
    esac
    if [[ $kind == bottom ]]; then
        # Niente CRLF dalla cella finale: evita scroll e disallineamenti SGR.
        printf '%s%s%s%s%s' "$CLR_BORDER" "$left" "$d" "$right" "$CLR_RESET" >&9
    else
        printf '%s%s%s%s%s\r\n' "$CLR_BORDER" "$left" "$d" "$right" "$CLR_RESET" >&9
    fi
}

size() {
    local dimensions
    dimensions=$(stty size <&9 2>/dev/null) || dimensions='24 80'
    read -r rows cols <<< "$dimensions"
    [[ $rows =~ ^[0-9]+$ && $cols =~ ^[0-9]+$ ]] || { rows=24; cols=80; }
    dual_pane=0
    (( cols >= 100 )) && dual_pane=1
    pane_geometry "$active_pane"
    visible=$((rows-8))
}

# Lo stato del pannello attivo resta nelle variabili usate dalle operazioni.
pane_geometry() {
    pane_x=1; pane_width=$cols
    if (( dual_pane )); then
        pane_width=$((cols/2))
        if (( $1 == 1 )); then
            pane_x=$((pane_width+1))
            pane_width=$((cols-pane_width))
        fi
    fi
    inner=$((pane_width-2))
}

save_pane() {
    local key path
    pane_dirs[active_pane]=$cwd
    pane_cursors[active_pane]=$cursor
    pane_scrolls[active_pane]=$scroll
    pane_filters[active_pane]=$filter
    for key in "${!pane_marks[@]}"; do
        [[ $key == "$active_pane:"* ]] && unset 'pane_marks[$key]'
    done
    for path in "${!marks[@]}"; do
        pane_marks["$active_pane:$path"]=1
    done
}

load_pane() {
    local id=$1 key
    cwd=${pane_dirs[id]}; cursor=${pane_cursors[id]}
    scroll=${pane_scrolls[id]}; filter=${pane_filters[id]}
    reload
    for key in "${!pane_marks[@]}"; do
        [[ $key == "$id:"* ]] && marks["${key#*:}"]=1
    done
}

switch_pane() {
    (( dual_pane )) || return 0
    save_pane
    active_pane=$((1-active_pane))
    load_pane "$active_pane"
    pane_geometry "$active_pane"
    last_click_path=''; last_click_ms=0
}

filter_items() {
    if ! ask 'Filtro nome (vuoto = tutti, Esc annulla): '; then return; fi
    filter=$REPLY
    cursor=1; scroll=0
    reload
    notice="Filtro: ${filter:-tutti}"
}

now_millis() {
    # EPOCHREALTIME segue LC_NUMERIC: in italiano puo' usare la virgola!
    # Non interpretare la stringa originale come intero Bash (bug riga 194).
    local stamp=${EPOCHREALTIME:-} sec frac
    stamp=${stamp/,/.}
    if [[ $stamp =~ ^([0-9]+)\.([0-9]{1,6})$ ]]; then
        sec=${BASH_REMATCH[1]}
        frac=${BASH_REMATCH[2]}
        frac=${frac:0:3}
        while (( ${#frac} < 3 )); do frac+="0"; done
        printf '%s\n' "$((10#$sec * 1000 + 10#$frac))"
    else
        # Bash < 5 o orologio non disponibile: secondi dal printf builtin.
        printf -v sec '%(%s)T' -1
        printf '%s\n' "$((10#$sec * 1000))"
    fi
}

reload() {
    local path name
    local -a dirs=() files=()
    entries=('..')
    for path in "$cwd"/*; do
        name=${path##*/}
        [[ ${name,,} == *"${filter,,}"* ]] || continue
        [[ -d $path ]] && dirs+=("$path") || files+=("$path")
    done
    entries+=("${dirs[@]}" "${files[@]}")
    (( cursor >= ${#entries[@]} )) && cursor=$((${#entries[@]}-1))
    (( cursor < 0 )) && cursor=0
    (( scroll > cursor )) && scroll=$cursor
    # I segni di selezione sono locali alla directory visualizzata.
    marks=()
    needs_full=1
}

sync_scroll() {
    (( cursor < scroll )) && scroll=$cursor
    (( cursor >= scroll+visible )) && scroll=$((cursor-visible+1))
    (( scroll < 0 )) && scroll=0
}

render_actions() {
    local -a segs=(
        '[F2] Rinom.' '[F3] Selez.' '[F4] Edita' '[F5] Copia' '[F6] Sposta' '[F7] CreaDir' '[F8] Elimina' '[F10] Esci'
    )
    # Barra MC: tasti evidenziati su ciano, comandi su fondo nero.
    action_keys=(F2 F3 F4 F5 F6 F7 F8 F10)
    if (( inner < 105 )); then
        segs=('2Rin' '3Sel' '4Ed' '5Cop' '6Spo' '7Dir' '8Del' '10Esci')
        if (( inner < 48 )); then
            segs=('2R' '3S' '4E' '5C' '6M' '7D' '8X' '10Q')
        fi
    fi
    action_starts=()
    action_ends=()
    local seg idx used=1 prefix suffix start width
    printf '%s%s%s ' "$CLR_BORDER" "$C_V" "$CLR_FOOTER" >&9
    for idx in "${!segs[@]}"; do
        seg=${segs[idx]}
        if (( idx > 0 )); then
            printf '  ' >&9
            ((used+=2))
        fi
        start=$((used + 2))
        if [[ $seg == \[* ]]; then
            prefix=${seg%%]*}']'
            suffix=${seg#"$prefix"}
        else
            if [[ $seg == 10* ]]; then
                prefix='10'; suffix=${seg:2}
            else
                prefix=${seg:0:1}; suffix=${seg:1}
            fi
        fi
        printf '%s%s%s%s' "$CLR_HOTKEY" "$prefix" "$CLR_FOOTER" "$suffix" >&9
        ((used+=${#seg}))
        action_starts[idx]=$start
        action_ends[idx]=$((used+1))
    done
    width=$((inner-used))
    ((width > 0)) && printf '%*s' "$width" '' >&9
    printf '%s%s%s\r\n' "$CLR_BORDER" "$C_V" "$CLR_RESET" >&9
}

# Stampa la riga visibile nella posizione reale del terminale (1-based).
# Y=4 e' la prima riga, dopo cornice, titolo e separatore.
paint_entry() {
    local idx=$1 n item label selected kind row_style
    (( idx >= scroll && idx < scroll+visible )) || return 0
    n=$((idx-scroll))
    printf '\033[%d;%dH' "$((items_y+n))" "$pane_x" >&9
    if (( idx >= ${#entries[@]} )); then
        line_text ''
        return
    fi
    item=${entries[idx]}
    selected=' '
    [[ -v marks["$item"] ]] && selected='*'
    row_style=$CLR_PANEL
    kind=' '
    label=${item##*/}
    if [[ $item == '..' ]]; then
        kind='/'; label='..'; row_style=$CLR_DIR
    elif [[ -L $item ]]; then
        kind='@'
        if [[ -e $item ]]; then row_style=$CLR_LINK; else row_style=$CLR_BADLINK; fi
    elif [[ -d $item ]]; then
        kind='/'; row_style=$CLR_DIR
    elif [[ -f $item && -x $item ]]; then
        kind='*'; row_style=$CLR_EXEC
    fi
    [[ -v marks["$item"] ]] && row_style=$CLR_MARKED
    if (( idx == cursor && ${drawing_pane:-$active_pane} == active_pane )); then
        row_style=$CLR_CURSOR
        [[ -v marks["$item"] ]] && row_style=$CLR_MARK_CURSOR
    fi
    line_text " $selected $kind$label" "$row_style"
}

draw_panel() {
    local drawing_pane=$1 cwd cursor scroll filter pane_x pane_width inner needs_full
    local -a entries=()
    local -A marks=()
    local i title
    load_pane "$drawing_pane"
    pane_geometry "$drawing_pane"
    sync_scroll
    title=" $cwd"
    (( drawing_pane == active_pane )) && title=" * $cwd"
    [[ -n $filter ]] && title+=" [Filtro: $filter]"
    printf '\033[1;%dH' "$pane_x" >&9
    border top
    printf '\033[2;%dH' "$pane_x" >&9
    line_text "$title" "$CLR_TITLE"
    printf '\033[3;%dH' "$pane_x" >&9
    border mid
    for ((i=0; i<visible; i++)); do paint_entry "$((scroll+i))"; done
    printf '\033[%d;%dH' "$((visible+4))" "$pane_x" >&9
    border bottom
}

draw_dual() {
    local inner=$((cols-2))
    save_pane
    draw_panel 0
    draw_panel 1
    printf '\033[%d;1H' "$actions_y" >&9
    render_actions
    line_text ' Tab: cambia lato | Ctrl+F: filtro | F5/F6: trasferisci nel pannello opposto' "$CLR_STATUS"
    line_text " $notice" "$CLR_NOTICE"
    border bottom
}

draw_notice() {
    local inner=$((cols-2))
    printf '\033[%d;1H' "$notice_y" >&9
    line_text " $notice" "$CLR_NOTICE"
}

draw() {
    local i
    size
    if (( rows < 12 || cols < 35 )); then
        printf '\033[H\033[2JTerminale troppo piccolo (minimo 35x12).\r\n' >&9
        needs_full=1
        painted_rows=$rows; painted_cols=$cols
        return
    fi
    sync_scroll
    items_y=4
    actions_y=$((visible+5))
    help_y=$((visible+6))
    notice_y=$((visible+7))

    if (( needs_full || rows != painted_rows || cols != painted_cols || scroll != painted_scroll )); then
        # Riscrive alle posizioni fisse senza pulire tutto lo schermo.
        # Il bordo inferiore non emette CRLF, eliminando lo scroll terminale.
        if (( dual_pane )); then
            draw_dual
        else
            printf '\033[H' >&9
            border top
            line_text " fm  $cwd${filter:+ [Filtro: $filter]}" "$CLR_TITLE"
            border mid
            for ((i=0; i<visible; i++)); do
                paint_entry "$((scroll+i))"
            done
            printf '\033[%d;1H' "$((visible+4))" >&9
            border mid
            render_actions
            line_text ' Frecce: naviga | Ctrl+F: filtro | q/F10: esci' "$CLR_STATUS"
            line_text " $notice" "$CLR_NOTICE"
            border bottom
        fi
        needs_full=0
    else
        # In navigazione aggiorna solo la vecchia e la nuova riga.
        (( painted_cursor != cursor )) && paint_entry "$painted_cursor"
        paint_entry "$cursor"
        if [[ $painted_notice != "$notice" ]]; then
            draw_notice
        fi
    fi
    painted_rows=$rows; painted_cols=$cols
    painted_scroll=$scroll; painted_cursor=$cursor
    painted_notice=$notice
}

input_key() {
    local char next code='' n payload
    KEY=''
    MOUSE_BTN=0; MOUSE_X=0; MOUSE_Y=0; MOUSE_ACTION=''
    if [[ -n $PENDING_CHAR ]]; then
        char=$PENDING_CHAR; PENDING_CHAR=''
    else
        if ! IFS= read -rsn1 -u9 char; then
            # WINCH puo' interrompere read anche quando ha gia' ricevuto un tasto.
            [[ -n $char ]] || return 1
        fi
    fi
    case $char in
        $'\e')
            if ! IFS= read -rsn1 -t 0.10 -u9 next; then
                KEY='ESC'; return 0
            fi
            if [[ $next != '[' && $next != 'O' ]]; then
                # Esc seguito rapidamente da una lettera: non perdere
                # la lettera (es. Esc per annullare e subito q per uscire).
                PENDING_CHAR=$next
                KEY='ESC'
                return 0
            fi
            code=$next
            if [[ $next == '[' || $next == 'O' ]]; then
                for ((n=0; n<24; n++)); do
                    IFS= read -rsn1 -t 0.10 -u9 next || break
                    code+=$next
                    [[ $next == [a-zA-Z\~] ]] && break
                done
            fi
            if [[ $code == \[\<* ]]; then
                payload=${code#\[<}
                MOUSE_ACTION=${payload: -1}
                payload=${payload%?}
                IFS=';' read -r MOUSE_BTN MOUSE_X MOUSE_Y <<< "$payload"
                if [[ $MOUSE_BTN =~ ^[0-9]+$ && $MOUSE_X =~ ^[0-9]+$ && $MOUSE_Y =~ ^[0-9]+$ ]]; then
                    KEY='MOUSE'
                else
                    KEY='ESC'
                fi
                return 0
            fi
            case $code in
                '[A') KEY='UP';; '[B') KEY='DOWN';; '[C') KEY='RIGHT';; '[D') KEY='LEFT';; '[H'|'OH'|'[1~'|'[7~') KEY='HOME';;
                '[F'|'OF'|'[4~'|'[8~') KEY='END';;
                '[5~') KEY='PAGEUP';; '[6~') KEY='PAGEDOWN';;
                'OQ'|'[12~'|'[[B') KEY='F2';;
                'OR'|'[13~'|'[[C') KEY='F3';;
                'OS'|'[14~'|'[[D') KEY='F4';;
                '[15~'|'[5^'|'[[E') KEY='F5';;
                '[17~'|'[[F') KEY='F6';;
                '[18~'|'[[G') KEY='F7';;
                '[19~'|'[[H') KEY='F8';;
                '[21~') KEY='F10';;
                *) KEY='ESC';;
            esac
            ;;
        ''|$'\r'|$'\n') KEY='ENTER';;
        $'\177'|$'\b') KEY='BACK';;
        ' ') KEY='F3';;
        $'\023') KEY='SYMLINK';;
        $'\006') KEY='FILTER';;
        $'\t') KEY='TAB';;
        $'\030')
            # Sequenza MC: Ctrl+X poi C o O.
            IFS= read -rsn1 -u9 next || return 1
            case $next in
                c|C) KEY='CHMOD';;
                o|O) KEY='CHOWN';;
                *) KEY='BAD_CHORD';;
            esac
            ;;
        *) KEY=$char;;
    esac
}

# Inserimento in modalita' raw: niente dipendenze su read -e/readline o dialog.
ask() {
    local prompt=$1 value='' ch
    while :; do
        notice="$prompt$value"
        draw
        IFS= read -rsn1 -u9 ch || return 1
        case $ch in
            ''|$'\r'|$'\n') REPLY=$value; return 0;;
            $'\e')
                # Scarta sequenze mouse durante i prompt.
                local next tail k
                if IFS= read -rsn1 -t 0.08 -u9 next; then
                    if [[ $next == '[' ]]; then
                        IFS= read -rsn1 -t 0.08 -u9 tail || { notice='Operazione annullata.'; return 1; }
                        if [[ $tail == '<' ]]; then
                            for ((k=0; k<30; k++)); do
                                IFS= read -rsn1 -t 0.08 -u9 tail || break
                                [[ $tail == M || $tail == m ]] && break
                            done
                            continue
                        fi
                    fi
                fi
                notice='Operazione annullata.'
                return 1
                ;;
            $'\177'|$'\b') value=${value%?};;
            *)
                if [[ $ch == [[:print:]] && ${#value} -lt 200 ]]; then
                    value+=$ch
                fi
                ;;
        esac
    done
}

select_current() {
    local path=${entries[cursor]}
    if [[ $path == '..' ]]; then
        notice="La directory padre non e' selezionabile."
        return
    fi
    if [[ -v marks["$path"] ]]; then
        unset 'marks[$path]'
        notice='Elemento deselezionato.'
    else
        marks["$path"]=1
        notice='Elemento selezionato (*).'
    fi
}

collect() {
    local path
    targets=()
    for path in "${entries[@]}"; do
        [[ $path == '..' ]] && continue
        [[ -v marks["$path"] ]] && targets+=("$path")
    done
    if (( ${#targets[@]} == 0 )); then
        path=${entries[cursor]}
        [[ $path != '..' ]] && targets+=("$path")
    fi
}

rename_item() {
    local path=${entries[cursor]} name
    if [[ $path == '..' ]]; then
        notice='Seleziona prima un elemento.'
        return
    fi
    if ! ask "Nuovo nome di ${path##*/} (Esc annulla): "; then return; fi
    name=$REPLY
    if [[ -z $name || $name == '.' || $name == '..' || $name == */* ]]; then
        notice='Nome non valido.'
        return
    fi
    if [[ -e $cwd/$name || -L $cwd/$name ]]; then
        notice="Esiste gia' un elemento con quel nome."
        return
    fi
    if mv -T -- "$path" "$cwd/$name" 2>/dev/null; then
        reload
        notice="Rinominato: $name"
    else
        notice='Rinomina non riuscita.'
    fi
}

transfer_items() {
    local mode=$1 destination src dst okay=0 failed=0
    collect
    if (( ${#targets[@]} == 0 )); then
        notice='Seleziona prima un elemento.'
        return
    fi
    if (( dual_pane )); then
        destination=${pane_dirs[1-active_pane]}
        if ! destination=$(cd -P -- "$destination" 2>/dev/null && pwd -P); then
            notice='Directory del pannello opposto non accessibile.'
            return
        fi
    else
        if ! ask 'Directory di destinazione (Esc annulla): '; then return; fi
        destination=$REPLY
        [[ $destination != /* ]] && destination="$cwd/$destination"
        if [[ -z $REPLY ]] || ! destination=$(cd -P -- "$destination" 2>/dev/null && pwd -P); then
            notice='Directory di destinazione non valida.'
            return
        fi
    fi
    for src in "${targets[@]}"; do
        dst="$destination/${src##*/}"
        if [[ ! -e $src && ! -L $src ]] || [[ -e $dst || -L $dst ]]; then
            ((failed+=1)); continue
        fi
        # Non copiare o spostare una directory al proprio interno.
        if [[ -d $src && ! -L $src && "$destination/" == "$src/"* ]]; then
            ((failed+=1)); continue
        fi
        if [[ $mode == copy ]]; then
            if cp -aT -- "$src" "$dst" >/dev/null 2>&1; then
                ((okay+=1))
            else
                ((failed+=1))
            fi
        else
            if mv -T -- "$src" "$dst" >/dev/null 2>&1; then
                ((okay+=1))
            else
                ((failed+=1))
            fi
        fi
    done
    marks=()
    cursor=1
    reload
    notice="Operazione completata: $okay. Non riusciti: $failed (nessuna sovrascrittura)."
}

new_dir() {
    local name
    if ! ask 'Nome nuova directory (Esc annulla): '; then return; fi
    name=$REPLY
    if [[ -z $name || $name == '.' || $name == '..' || $name == */* ]]; then
        notice='Nome non valido.'
        return
    fi
    if [[ -e "$cwd/$name" || -L "$cwd/$name" ]]; then
        notice="Esiste gia' un elemento con quel nome."
        return
    fi
    if mkdir -- "$cwd/$name" 2>/dev/null; then
        notice="Directory creata: $name"
    else
        notice='Creazione non riuscita (permessi o nome non valido).'
    fi
    reload
}

delete_items() {
    local path yes count=0 errors=0
    collect
    if (( ${#targets[@]} == 0 )); then
        notice='Seleziona prima un elemento.'
        return
    fi
    if ! ask "Eliminare ${#targets[@]} elemento/i? s/N: "; then return; fi
    yes=$REPLY
    if [[ $yes != 's' && $yes != 'S' && $yes != 'y' && $yes != 'Y' ]]; then
        notice='Eliminazione annullata.'
        return
    fi
    for path in "${targets[@]}"; do
        if rm -rf -- "$path" 2>/dev/null; then
            ((count+=1))
        else
            ((errors+=1))
        fi
    done
    cursor=1
    reload
    notice="Eliminati: $count. Errori: $errors."
}

# Libera il terminale per eseguire un programma interattivo.
run_executable() {
    local path=${entries[cursor]}
    if [[ $path == '..' || ! -f $path || ! -x $path ]]; then
        notice="Il file selezionato non e' un eseguibile."
        return
    fi
    run_program 1 "$path"
}

edit_item() {
    local path=${entries[cursor]}
    local -a editor
    if [[ $path == '..' || ! -f $path ]]; then
        notice='Seleziona un file da editare.'
        return
    fi
    read -r -a editor <<< "${EDITOR:-nano}"
    if (( ${#editor[@]} == 0 )) || ! command -v "${editor[0]}" >/dev/null 2>&1; then
        notice='Editor non disponibile: imposta EDITOR oppure installa nano.'
        return
    fi
    run_program 0 "${editor[@]}" "$path"
    reload
}

# Passa il terminale al comando e lo ripristina al termine.
run_program() {
    local wait_for_enter=$1 status
    shift
    printf '\033[?1000l\033[?1006l\033[?25h%s' "$CLR_RESET" >&9
    (( alt_screen )) && printf '\033[?1049l' >&9
    stty "$original_tty" <&9 || return
    printf '\r\nfm: esecuzione di %s\r\n' "${1##*/}" >&9
    # Invocazione diretta senza eval e senza interpolare il nome.
    (cd -- "$cwd" && "$@") <&9 >&9 2>&9
    status=$?
    if (( wait_for_enter )); then
        printf '\r\n[Uscita: %d] Premi Invio per tornare al file manager...' "$status" >&9
        IFS= read -r -u9 _unused || :
    fi
    stty -echo -icanon -icrnl -ixon min 1 time 0 <&9 || return
    (( alt_screen )) && printf '\033[?1049h' >&9
    printf '\033[?25l\033[?1000h\033[?1006h' >&9
    needs_full=1
    notice="Eseguito: ${1##*/} (codice $status)."
}

# Finestre modali con bordi e colori MC, senza dialog/ncurses.
# Tutti i movimenti sono assoluti e non producono scroll del terminale.
modal_frame() {
    local title=$1 i d
    size
    modal_w=$((cols-4))
    (( modal_w > 58 )) && modal_w=58
    modal_h=12
    modal_x=$(((cols-modal_w)/2+1))
    modal_y=$(((rows-modal_h)/2+1))
    printf -v d '%*s' "$((modal_w-2))" ''
    d=${d// /$C_H}
    printf '\033[%d;%dH%s%s%s%s%s' "$modal_y" "$modal_x" "$CLR_BORDER" "$C_TL" "$d" "$C_TR" "$CLR_RESET" >&9
    for ((i=1; i<modal_h-1; i++)); do
        printf '\033[%d;%dH%s%s%s%*s%s%s%s' \
            "$((modal_y+i))" "$modal_x" "$CLR_BORDER" "$C_V" "$CLR_PANEL" \
            "$((modal_w-2))" '' "$CLR_BORDER" "$C_V" "$CLR_RESET" >&9
    done
    printf '\033[%d;%dH%s%s%s%s%s' \
        "$((modal_y+modal_h-1))" "$modal_x" "$CLR_BORDER" "$C_BL" "$d" "$C_BR" "$CLR_RESET" >&9
    modal_line 1 " $title" "$CLR_TITLE"
}

modal_line() {
    local line=$1 content=$2 style=${3:-$CLR_PANEL}
    fit "$content" "$((modal_w-4))"
    printf '\033[%d;%dH%s%-*s%s' "$((modal_y+line))" "$((modal_x+2))" \
        "$style" "$((modal_w-4))" "$REPLY" "$CLR_RESET" >&9
}

chmod_dialog() {
    local base_mode=$1 new_mode=$2 focus=$3 digits=$4
    local row col check mask value label i rowtext
    modal_frame 'Permessi (chmod)'
    modal_line 2 "Corrente: $base_mode     Nuovo: $new_mode"
    modal_line 3 '             Lett.   Scritt.  Esec.'
    for ((row=0; row<3; row++)); do
        case $row in 0) label='Utente';; 1) label='Gruppo';; 2) label='Altri ';; esac
        rowtext="$label      "
        for ((col=0; col<3; col++)); do
            i=$((row*3+col))
            mask=$((1 << (8-i)))
            check=' '
            (( perms & mask )) && check='x'
            if (( i == focus )); then
                rowtext+="<$check>      "
            else
                rowtext+="[$check]      "
            fi
        done
        modal_line "$((4+row))" "$rowtext"
    done
    modal_line 7 "Cella attiva: $((focus/3+1)) / $((focus%3+1))"
    if [[ -n $digits ]]; then
        modal_line 8 "Ottale digitato: $digits" "$CLR_MARKED"
    else
        modal_line 8 'Frecce: naviga    Spazio: cambia' "$CLR_STATUS"
    fi
    modal_line 9 'Oppure digita 755, 0644 o simili'
    modal_line 10 'Invio: Applica       Esc: Annulla' "$CLR_TITLE"
}

chmod_items() {
    local path base_mode mode digits='' focus=0 perms mask key new_mode
    local changed=0 failed=0
    collect
    if (( ${#targets[@]} == 0 )); then notice='Nessun elemento selezionato.'; return; fi
    base_mode=''
    for path in "${targets[@]}"; do
        if [[ ! -L $path ]]; then
            base_mode=$(stat -c %a -- "$path" 2>/dev/null) || :
            break
        fi
    done
    if [[ ! $base_mode =~ ^[0-7]{3,4}$ ]]; then
        notice='Nessun file valido: chmod non modifica i link simbolici.'
        return
    fi
    perms=$((8#$base_mode))
    needs_full=1
    while :; do
        printf -v new_mode '%04o' "$perms"
        chmod_dialog "$base_mode" "$new_mode" "$focus" "$digits"
        if ! input_key; then notice='chmod annullato.'; needs_full=1; return; fi
        case $KEY in
            UP) focus=$(((focus+6)%9));;
            DOWN) focus=$(((focus+3)%9));;
            LEFT) focus=$(((focus+8)%9));;
            RIGHT) focus=$(((focus+1)%9));;
            F3)
                mask=$((1 << (8-focus)))
                perms=$((perms ^ mask))
                digits=''
                ;;
            [0-9])
                if (( ${#digits} < 4 )); then digits+=$KEY; fi
                ;;
            ENTER)
                if [[ -n $digits ]]; then
                    if [[ ! $digits =~ ^[0-7]{3,4}$ ]]; then
                        notice='Modo ottale non valido: usa 3 o 4 cifre da 0 a 7.'
                        needs_full=1
                        return
                    fi
                    mode=$digits
                else
                    mode=$new_mode
                fi
                break
                ;;
            ESC|F10)
                notice='Modifica permessi annullata.'
                needs_full=1
                return
                ;;
            MOUSE)
                # Tre righe di caselle (4..6) nella finestra.
                local r c
                r=$((MOUSE_Y-modal_y-4))
                c=$((MOUSE_X-modal_x))
                if [[ $MOUSE_ACTION == M ]] && (( MOUSE_BTN == 0 && r>=0 && r<3 && c>=8 && c<37 )); then
                    if (( c<18 )); then focus=$((r*3))
                    elif (( c<28 )); then focus=$((r*3+1))
                    else focus=$((r*3+2))
                    fi
                    mask=$((1 << (8-focus)))
                    perms=$((perms ^ mask))
                    digits=''
                fi
                ;;
        esac
    done
    needs_full=1
    for path in "${targets[@]}"; do
        if [[ -L $path ]]; then
            ((failed+=1))
        elif chmod -- "$mode" "$path" 2>/dev/null; then
            ((changed+=1))
        else
            ((failed+=1))
        fi
    done
    reload
    notice="chmod $mode: modificati $changed, non riusciti $failed."
}

chown_dialog() {
    local current=$1 owner=$2 group=$3 focus=$4
    modal_frame 'Proprietario e gruppo (chown)'
    modal_line 2 "Elementi selezionati: ${#targets[@]}"
    modal_line 3 "Attuale: $current"
    modal_line 4 'Proprietario:'
    if (( focus == 0 )); then
        modal_line 5 "> ${owner:-[invariato]}_" "$CLR_CURSOR"
    else
        modal_line 5 "  ${owner:-[invariato]}" "$CLR_PANEL"
    fi
    modal_line 6 'Gruppo:'
    if (( focus == 1 )); then
        modal_line 7 "> ${group:-[invariato]}_" "$CLR_CURSOR"
    else
        modal_line 7 "  ${group:-[invariato]}" "$CLR_PANEL"
    fi
    modal_line 8 'Tab / Frecce: cambia campo; Backspace elimina'
    modal_line 9 'Digita utente:gruppo per compilare entrambi'
    modal_line 10 'Invio: Applica       Esc: Annulla' "$CLR_TITLE"
}

chown_items() {
    local path current owner='' group='' focus=0 key spec
    local changed=0 failed=0
    collect
    if (( ${#targets[@]} == 0 )); then notice='Nessun elemento selezionato.'; return; fi
    current=$(stat -c '%U:%G' -- "${targets[0]}" 2>/dev/null) || current='sconosciuto'
    needs_full=1
    while :; do
        chown_dialog "$current" "$owner" "$group" "$focus"
        if ! input_key; then notice='chown annullato.'; needs_full=1; return; fi
        key=$KEY
        case $key in
            UP|DOWN|LEFT|RIGHT|$'\t')
                focus=$((1-focus))
                ;;
            BACK)
                if (( focus==0 )); then owner=${owner%?}; else group=${group%?}; fi
                ;;
            ':')
                focus=1
                ;;
            ENTER)
                if [[ -z $owner && -z $group ]]; then
                    notice='Nessun proprietario o gruppo specificato.'
                    needs_full=1
                    return
                fi
                spec=$owner
                [[ -n $group ]] && spec="$owner:$group"
                break
                ;;
            ESC|F10)
                notice='Modifica proprietario annullata.'
                needs_full=1
                return
                ;;
            MOUSE)
                if [[ $MOUSE_ACTION == M && $MOUSE_BTN == 0 ]]; then
                    if (( MOUSE_Y == modal_y + 5 )); then focus=0
                    elif (( MOUSE_Y == modal_y + 7 )); then focus=1
                    fi
                fi
                ;;
            *)
                if [[ $key == [[:print:]] && ${#key} == 1 && $key != [[:space:]] ]]; then
                    if (( focus==0 )); then
                        (( ${#owner} < 128 )) && owner+=$key
                    else
                        (( ${#group} < 128 )) && group+=$key
                    fi
                fi
                ;;
        esac
    done
    needs_full=1
    # Chiamata diretta senza sudo né shell; eventuali errori per permessi
    # sono riportati dal contatore, senza richiedere password nella TUI.
    for path in "${targets[@]}"; do
        if chown -- "$spec" "$path" 2>/dev/null; then
            ((changed+=1))
        else
            ((failed+=1))
        fi
    done
    reload
    notice="chown $spec: modificati $changed, non riusciti $failed."
}

create_symlink() {
    local path=${entries[cursor]} name
    if [[ $path == '..' ]]; then
        notice='Seleziona un file o una directory per il link.'
        return
    fi
    name="${path##*/}.lnk"
    if [[ -e $cwd/$name || -L $cwd/$name ]]; then
        notice="Esiste gia' un file o link con questo nome."
        return
    fi
    # Destinazione assoluta: il link resta valido dopo aver spostato
    # il collegamento in un altra directory (finche il target esiste).
    if ln -s -- "$path" "$cwd/$name" 2>/dev/null; then
        reload
        notice="Creato link $name -> $path"
    else
        notice='Creazione link non riuscita (permessi?).'
    fi
}

enter_dir() {
    local path=${entries[cursor]}
    if [[ $path == '..' ]]; then
        cwd=$(cd -P -- "$cwd/.." && pwd -P)
    elif [[ -d $path ]]; then
        if ! cwd=$(cd -P -- "$path" 2>/dev/null && pwd -P); then
            notice='Impossibile entrare nella directory.'
            return
        fi
    elif [[ -f $path && -x $path ]]; then
        run_executable
        return
    else
        notice="Non e' una directory o un file eseguibile."
        return
    fi
    cursor=1; scroll=0
    reload
    notice="Directory: $cwd"
}

handle_mouse() {
    local idx i x y now path relx
    x=$MOUSE_X
    y=$MOUSE_Y
    if (( dual_pane && y >= items_y && y < items_y+visible )); then
        if (( (x > cols/2) != active_pane )); then switch_pane; fi
    fi
    if (( MOUSE_BTN == 64 )); then
        ((cursor > 0)) && ((cursor-=1))
        notice='Rotella su.'
        return
    fi
    if (( MOUSE_BTN == 65 )); then
        ((cursor + 1 < ${#entries[@]})) && ((cursor+=1))
        notice='Rotella giu.'
        return
    fi
    [[ $MOUSE_ACTION != M ]] && return
    (( MOUSE_BTN != 0 )) && return
    if (( x > pane_x && x < pane_x+pane_width-1 && y >= items_y && y < items_y + visible )); then
        idx=$((scroll + y - items_y))
        if (( idx >= 0 && idx < ${#entries[@]} )); then
            cursor=$idx
            # La colonna 3 contiene il simbolo di marcatura (*).
            if (( x == pane_x+2 )) && [[ ${entries[idx]} != '..' ]]; then
                select_current
                return
            fi
            path=${entries[idx]}
            now=$(now_millis)
            if [[ $path == "$last_click_path" ]] && (( now - last_click_ms < 450 )); then
                last_click_ms=0
                last_click_path=''
                enter_dir
                return
            fi
            last_click_ms=$now
            last_click_path=$path
            notice='Riga selezionata con mouse.'
        fi
        return
    fi
    if (( y == actions_y )); then
        for i in "${!action_keys[@]}"; do
            if (( x >= action_starts[i] && x <= action_ends[i] )); then
                KEY=${action_keys[i]}
                return
            fi
        done
    fi
}

perform_key() {
    case $1 in
        UP|k) ((cursor>0)) && ((cursor-=1));;
        DOWN|j) ((cursor+1<${#entries[@]})) && ((cursor+=1));;
        PAGEUP) ((cursor-=visible)); ((cursor<0)) && cursor=0;;
        PAGEDOWN) ((cursor+=visible)); ((cursor>=${#entries[@]})) && cursor=$((${#entries[@]}-1));;
        HOME) cursor=0;;
        END) cursor=$((${#entries[@]}-1));;
        ENTER|RIGHT|l) enter_dir;;
        LEFT|h|BACK) cwd=$(cd -P -- "$cwd/.." && pwd -P); cursor=1; scroll=0; reload;;
        TAB) switch_pane;;
        FILTER) filter_items;;
        F2) rename_item;;
        F3) select_current;;
        F4) edit_item;;
        F5) transfer_items copy;;
        F6) transfer_items move;;
        F7) new_dir;;
        F8) delete_items;;
        CHMOD) chmod_items;;
        CHOWN) chown_items;;
        SYMLINK) create_symlink;;
        BAD_CHORD) notice='Ctrl+X: usare C per permessi, O per proprietario/gruppo.';;
        r|R) reload; notice='Elenco aggiornato.';;
        ESC) notice='Premi q per uscire.';;
        F10|q|Q) return 1;;
        *) ;;
    esac
    return 0
}

reload
(( ${#entries[@]} > 1 )) && cursor=1
while :; do
    draw
    if ! input_key; then
        if (( resized )); then resized=0; continue; fi
        break
    fi
    if (( resized )); then resized=0; draw; fi
    if (( rows < 12 || cols < 35 )); then
        [[ $KEY == q || $KEY == Q ]] && break
        continue
    fi
    if [[ $KEY == MOUSE ]]; then
        KEY=''
        handle_mouse
        if [[ $KEY == F10 ]]; then break; fi
        [[ -n $KEY ]] && perform_key "$KEY" || true
        continue
    fi
    if ! perform_key "$KEY"; then
        break
    fi
done
