#!/usr/bin/env bash
# fm: file manager a uno o due pannelli, senza librerie TUI esterne.
# Richiede Bash >= 4 (array associativi), stty e i comandi GNU di base.
set -u

usage() {
    cat <<'HELP'
Uso: fm [DIRECTORY]

File manager TUI a uno o due pannelli (Bash, senza ncurses).

 Frecce Su/Giu                   seleziona la riga (stile Lynx)
 Freccia Destra / Invio           apre dir o avvia file eseguibile
 Freccia Sinistra / Backspace     torna al padre sulla cartella lasciata
 PgUp / PgDn / Home / End         navigazione veloce
 F1                               menu comandi di Midnight Commander
 F2                               rinomina il file o la directory
 F3 / Ins / Spazio                seleziona/deseleziona e passa alla riga seguente
 F4                               edita con $EDITOR (oppure nano)
 F5                               copia nell’altro pannello (o chiede destinazione)
 F6                               sposta nell’altro pannello (o chiede destinazione)
 F7                               crea una directory
 F8                               cancella (chiede conferma)
 F10                              esci dal file manager
 Esc poi 1...9 / 0 (entro 0,5 s)  equivale a F1...F9 / F10 (F9 non assegnato)
 Ctrl+X poi C                     permessi, proprietario e gruppo
 Ctrl+X poi S                     crea un link simbolico (anche Ctrl+S)
 Ctrl+S                           crea link assoluto <nome>.lnk
 Ctrl+F                           cerca mentre digiti; Invio apre il risultato
 Ctrl+H                           mostra/nasconde file e cartelle nascosti
 Tab                              cambia pannello (da 100 colonne)
 Mouse click                      seleziona / doppio click apre
 Rotella mouse                    scorre l'elenco
 r                                aggiorna la lista

Opzioni d'ambiente:
 ABFM_NO_ALT_SCREEN=1             non usare lo schermo alternativo
 ABFM_NO_COLOR=1                  disabilita i colori ANSI
 ABFM_ASCII=1                     forza cornici ASCII al posto del box drawing
HELP
}

if [[ ${1:-} == --help || ${1:-} == -h ]]; then
    usage
    exit 0
fi
if (( $# > 1 )); then
    usage >&2
    exit 2
fi
if [[ ! -t 0 || ! -t 1 || ! -r /dev/tty ]]; then
    printf 'fm: eseguire in un terminale interattivo.\n' >&2
    exit 1
fi
if ! command -v stty >/dev/null 2>&1; then
    printf 'fm: stty non disponibile.\n' >&2
    exit 1
fi
if ! cwd=$(cd -P -- "${1:-.}" 2>/dev/null && pwd -P); then
    printf 'fm: directory non accessibile: %s\n' "${1:-.}" >&2
    exit 1
fi

# Manteniamo aperto /dev/tty: input e output rimangono affidabili anche in pipe.
exec 9<>/dev/tty
original_tty=$(stty -g <&9) || exit 1
alt_screen=1
[[ ${ABFM_NO_ALT_SCREEN:-0} == 1 ]] && alt_screen=0
mouse_enabled=0
declare -a entries=() targets=()
declare -A marks=()
declare -a action_keys=() action_starts=() action_ends=()
notice='Lynx: Su/Giu scegli, Destra apre, Sinistra torna. F10 esce.'
cursor=0
scroll=0
rows=24 cols=80 visible=12 inner=78
items_y=4
actions_y=0
last_click_ms=0
last_click_path=''
MOUSE_BTN=0; MOUSE_X=0; MOUSE_Y=0; MOUSE_ACTION=''
PENDING_CHAR=''
active_pane=0 dual_pane=0 pane_x=1 pane_width=80 filter='' filter_editing=0 show_hidden=1 resized=0
# Stato delle due viste; la cronologia e' distinta per pannello e cartella.
declare -a pane_dirs=("$cwd" "$cwd") pane_cursors=(1 1) pane_scrolls=(0 0) pane_filters=('' '') pane_hidden=(1 1)
declare -A pane_marks=() directory_focus=() directory_scroll=() directory_marks=()
# Origine dell'ultima marcatura esplicita, usata da F5/F6 a pannello unico.
connections_root='@connections'
connections_dir=${XDG_CONFIG_HOME:-$HOME/.config}/fm/connections
declare -A connection_names=() connection_protocols=() connection_addresses=()
declare -A remote_labels=() remote_protocols=() archive_sources=() archive_cache=()
archive_pending_cache=''
declare -a selection_sources=('' '')
# Coordinate di rendering: righe salvate per evitare redraw completi.
needs_full=1
painted_rows=0 painted_cols=0 painted_scroll=-1 painted_cursor=-1
painted_notice='' painted_status=''
USE_COLOR=1; USE_UNICODE=1
CLR_RESET='' CLR_BORDER='' CLR_HEADER='' CLR_TITLE='' CLR_STATUS='' CLR_NOTICE='' CLR_CURSOR=''
CLR_PANEL='' CLR_DIR='' CLR_EXEC='' CLR_LINK='' CLR_BADLINK=''
CLR_DIALOG='' CLR_DIALOG_TITLE='' CLR_DIALOG_FOCUS=''
CLR_MARKED='' CLR_MARK_CURSOR='' CLR_FOOTER='' CLR_HOTKEY=''
C_TL='+' C_TR='+' C_BL='+' C_BR='+' C_H='-' C_V='|' C_LT='+' C_RT='+'
init_theme() {
    local locale=${LC_ALL:-${LC_CTYPE:-${LANG:-}}}
    USE_COLOR=1; USE_UNICODE=1
    [[ -n ${NO_COLOR:-} || ${ABFM_NO_COLOR:-0} == 1 || ${TERM:-} == dumb ]] && USE_COLOR=0
    [[ ${ABFM_ASCII:-0} == 1 ]] && USE_UNICODE=0
    [[ $locale != *UTF-8* && $locale != *utf8* && $locale != *utf-8* ]] && USE_UNICODE=0
    # Palette del riferimento con colori per tipo file, ANSI 256 colori.
    if (( USE_COLOR )); then
        CLR_RESET=$'\033[0m'
        CLR_DIALOG=$'\033[0;38;5;252;48;5;239m'
        CLR_DIALOG_TITLE=$'\033[1;38;5;180;48;5;239m'
        CLR_DIALOG_FOCUS=$'\033[1;38;5;228;48;5;23m'
        # Pannello grigio scuro, testo giallo tenue e cursore petrolio.
        CLR_PANEL=$'\033[38;5;144;48;5;237m'
        CLR_BORDER=$'\033[38;5;144;48;5;237m'
        CLR_HEADER=$'\033[1;33;48;5;237m'
        CLR_TITLE=$'\033[1;38;5;144;48;5;237m'
        CLR_DIR=$'\033[1;38;5;144;48;5;237m'
        CLR_EXEC=$'\033[38;5;120;48;5;237m'
        CLR_LINK=$'\033[38;5;117;48;5;237m'
        CLR_BADLINK=$'\033[38;5;210;48;5;237m'
        CLR_MARKED=$'\033[1;38;5;228;48;5;237m'
        CLR_CURSOR=$'\033[38;5;252;48;5;23m'
        CLR_MARK_CURSOR=$'\033[1;38;5;228;48;5;23m'
        CLR_STATUS=$'\033[38;5;236;48;5;250m'
        CLR_NOTICE=$'\033[38;5;255;48;5;237m'
        CLR_FOOTER=$'\033[38;5;254;48;5;236m'
        CLR_HOTKEY=$'\033[38;5;252;48;5;23m'
    fi

    if (( USE_UNICODE )); then
        C_TL='┌'; C_TR='┐'; C_BL='└'; C_BR='┘'; C_H='─'; C_V='│'; C_LT='├'; C_RT='┤'
    fi
}
cleanup() {
    trap - EXIT INT TERM HUP WINCH
    local archive_root
    [[ -n $archive_pending_cache ]] && rm -rf -- "$archive_pending_cache"
    for archive_root in "${!archive_cache[@]}"; do
        if gio mount -u "$archive_root" >/dev/null 2>&1; then
            rm -rf -- "${archive_cache[$archive_root]}"
        fi
    done
    stty "$original_tty" <&9 2>/dev/null || :
    if (( mouse_enabled )); then
        printf '\033[?1000l\033[?1006l' >&9
    fi
    printf '%s\033[?25h' "$CLR_RESET" >&9
    (( alt_screen )) && printf '\033[?1049l' >&9
    exec 9>&-
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP
trap 'resized=1; needs_full=1' WINCH
stty -echo -icanon -icrnl -ixon min 1 time 0 <&9 || exit 1
init_theme
(( alt_screen )) && printf '\033[?1049h' >&9
printf '\033[?25l' >&9
printf '\033[?1000h\033[?1006h' >&9
mouse_enabled=1
shopt -s nullglob dotglob

safe() {
    local value=$1
    value=${value//[$'\001'-$'\037'$'\177']/\?}
    REPLY=$value
}

fit() {
    safe "$1"
    local str=$REPLY max=$2
    if (( ${#str} > max )); then
        if (( max > 3 )); then
            REPLY="${str:0:max-3}..."
        else
            REPLY="${str:0:max}"
        fi
    else
        REPLY=$str
    fi
}

line_text() {
    local s=$1 style=${2:-}
    fit "$s" "$inner"
    printf '%s%s%s' "$CLR_BORDER" "$C_V" "${style:-$CLR_PANEL}" >&9
    printf '%-*s' "$inner" "$REPLY" >&9
    printf '%s%s%s\r\n' "$CLR_BORDER" "$C_V" "$CLR_RESET" >&9
}
border() {
    local kind=${1:-mid} left right d
    printf -v d '%*s' "$inner" ''
    d=${d// /$C_H}
    case $kind in
        top) left=$C_TL; right=$C_TR ;;
        bottom) left=$C_BL; right=$C_BR ;;
        *) left=$C_LT; right=$C_RT ;;
    esac
    if [[ $kind == bottom ]]; then
        # Niente CRLF dalla cella finale: evita scroll e disallineamenti SGR.
        printf '%s%s%s%s%s' "$CLR_BORDER" "$left" "$d" "$right" "$CLR_RESET" >&9
    else
        printf '%s%s%s%s%s\r\n' "$CLR_BORDER" "$left" "$d" "$right" "$CLR_RESET" >&9
    fi
}

size() {
    local dimensions
    dimensions=$(stty size <&9 2>/dev/null) || dimensions='24 80'
    read -r rows cols <<< "$dimensions"
    [[ $rows =~ ^[0-9]+$ && $cols =~ ^[0-9]+$ ]] || { rows=24; cols=80; }
    dual_pane=0
    (( cols >= 100 )) && dual_pane=1
    pane_geometry "$active_pane"
    visible=$((rows-8))
}

# Lo stato del pannello attivo resta nelle variabili usate dalle operazioni.
pane_geometry() {
    pane_x=1; pane_width=$cols
    if (( dual_pane )); then
        pane_width=$((cols/2))
        if (( $1 == 1 )); then
            pane_x=$((pane_width+1))
            pane_width=$((cols-pane_width))
        fi
    fi
    inner=$((pane_width-2))
}

save_pane() {
    local key path
    pane_dirs[active_pane]=$cwd
    pane_cursors[active_pane]=$cursor
    pane_scrolls[active_pane]=$scroll
    pane_filters[active_pane]=$filter
    pane_hidden[active_pane]=$show_hidden
    for key in "${!pane_marks[@]}"; do
        [[ $key == "$active_pane:"* ]] && unset 'pane_marks[$key]'
    done
    for path in "${!marks[@]}"; do
        pane_marks["$active_pane:$path"]=1
    done
}

load_pane() {
    local id=$1 key
    cwd=${pane_dirs[id]}; cursor=${pane_cursors[id]}
    scroll=${pane_scrolls[id]}; filter=${pane_filters[id]}
    show_hidden=${pane_hidden[id]}
    reload
    for key in "${!pane_marks[@]}"; do
        [[ $key == "$id:"* ]] && marks["${key#*:}"]=1
    done
}

switch_pane() {
    (( dual_pane )) || return 0
    filter_editing=0
    save_pane
    active_pane=$((1-active_pane))
    load_pane "$active_pane"
    pane_geometry "$active_pane"
    last_click_path=''; last_click_ms=0
}

filter_items() {
    filter_editing=1
    filter=''; cursor=1; scroll=0
    reload
    notice='Filtro: digita per cercare; Invio apre, Esc annulla.'
}

clear_filter() {
    filter_editing=0
    [[ -n $filter ]] || return 0
    local current=${entries[cursor]} offset=$((cursor-scroll)) path i
    local -a selected=("${!marks[@]}")
    filter=''
    reload
    for path in "${selected[@]}"; do marks["$path"]=1; done
    for i in "${!entries[@]}"; do
        if [[ ${entries[i]} == "$current" ]]; then cursor=$i; break; fi
    done
    # Mantieni l'elemento sulla stessa riga anche per il secondo clic del mouse.
    scroll=$((cursor-offset))
    (( scroll < 0 )) && scroll=0
    notice='Filtro rimosso.'
}

now_millis() {
    # EPOCHREALTIME segue LC_NUMERIC: in italiano puo' usare la virgola!
    # Non interpretare la stringa originale come intero Bash (bug riga 194).
    local stamp=${EPOCHREALTIME:-} sec frac
    stamp=${stamp/,/.}
    if [[ $stamp =~ ^([0-9]+)\.([0-9]{1,6})$ ]]; then
        sec=${BASH_REMATCH[1]}
        frac=${BASH_REMATCH[2]}
        frac=${frac:0:3}
        while (( ${#frac} < 3 )); do frac+="0"; done
        printf '%s\n' "$((10#$sec * 1000 + 10#$frac))"
    else
        # Bash < 5 o orologio non disponibile: secondi dal printf builtin.
        printf -v sec '%(%s)T' -1
        printf '%s\n' "$((10#$sec * 1000))"
    fi
}

reload() {
    local path name
    local -a dirs=() files=()
    entries=('..')
    if [[ $cwd == "$connections_root" ]]; then
        entries=('local' 'ssh' 'ftp')
        load_saved_connections
    else
        for path in "$cwd"/*; do
            name=${path##*/}
            if (( !show_hidden )) && [[ $name == .* ]]; then continue; fi
            [[ ${name,,} == *"${filter,,}"* ]] || continue
            [[ -d $path ]] && dirs+=("$path") || files+=("$path")
        done
        entries+=("${dirs[@]}" "${files[@]}")
    fi
    (( cursor >= ${#entries[@]} )) && cursor=$((${#entries[@]}-1))
    (( cursor < 0 )) && cursor=0
    (( scroll > cursor )) && scroll=$cursor
    # I segni di selezione sono locali alla directory visualizzata.
    marks=()
    needs_full=1
}

sync_scroll() {
    (( cursor < scroll )) && scroll=$cursor
    (( cursor >= scroll+visible )) && scroll=$((cursor-visible+1))
    (( scroll < 0 )) && scroll=0
}

render_actions() {
    local -a segs=(
        '[F1] Menu' '[F2] Rinom.' '[F3] Selez.' '[F4] Edita' '[F5] Copia' '[F6] Sposta' '[F7] CreaDir' '[F8] Elimina' '[F10] Esci'
    )
    # Barra MC: tasti evidenziati su ciano, comandi su fondo nero.
    action_keys=(F1 F2 F3 F4 F5 F6 F7 F8 F10)
    if (( inner < 113 )); then
        segs=('1Menu' '2Rin' '3Sel' '4Ed' '5Cop' '6Spo' '7Dir' '8Del' '10Esci')
        if (( inner < 55 )); then
            segs=('1U' '2R' '3S' '4E' '5C' '6M' '7D' '8X' '10Q')
        fi
    fi
    action_starts=()
    action_ends=()
    local seg idx used=1 prefix suffix start width gap=2
    (( inner < 55 )) && gap=1
    printf '%s%s%s ' "$CLR_BORDER" "$C_V" "$CLR_FOOTER" >&9
    for idx in "${!segs[@]}"; do
        seg=${segs[idx]}
        if (( idx > 0 )); then
            printf '%*s' "$gap" '' >&9
            ((used+=gap))
        fi
        start=$((used + 2))
        if [[ $seg == \[* ]]; then
            prefix=${seg%%]*}']'
            suffix=${seg#"$prefix"}
        else
            if [[ $seg == 10* ]]; then
                prefix='10'; suffix=${seg:2}
            else
                prefix=${seg:0:1}; suffix=${seg:1}
            fi
        fi
        printf '%s%s%s%s' "$CLR_HOTKEY" "$prefix" "$CLR_FOOTER" "$suffix" >&9
        ((used+=${#seg}))
        action_starts[idx]=$start
        action_ends[idx]=$((used+1))
    done
    width=$((inner-used))
    ((width > 0)) && printf '%*s' "$width" '' >&9
    printf '%s%s%s\r\n' "$CLR_BORDER" "$C_V" "$CLR_RESET" >&9
}

# Le colonne mantengono la stessa posizione anche con nomi lunghi.
entry_columns() {
    local name=$1 bytes=$2 modified=$3 style=$4 name_width=$((inner-28))
    fit "$name" "$name_width"
    name=$REPLY
    fit "$bytes" 10
    printf -v name '%-*s%s%10s%s%-16s' "$name_width" "$name" "$C_V" "$REPLY" "$C_V" "$modified"
    line_text "$name" "$style"
}

column_header() {
    entry_columns ' Nome' 'Dimensione' 'Ultima modifica' "$CLR_HEADER"
}

# Stampa la riga visibile nella posizione reale del terminale (1-based).
# Y=4 e' la prima riga, dopo cornice, titolo e intestazioni.
paint_entry() {
    local idx=$1 n item label selected kind row_style metadata bytes modified epoch
    (( idx >= scroll && idx < scroll+visible )) || return 0
    n=$((idx-scroll))
    printf '\033[%d;%dH' "$((items_y+n))" "$pane_x" >&9
    if (( idx >= ${#entries[@]} )); then
        entry_columns '' '' '' "$CLR_PANEL"
        return
    fi
    item=${entries[idx]}
    selected=' '
    [[ -v marks["$item"] ]] && selected='*'
    row_style=$CLR_PANEL
    kind=' '
    label=${item##*/}
    if [[ $cwd == "$connections_root" ]]; then
        case $item in
            local) label='Questo PC';; ssh) label='SSH';; ftp) label='FTP';;
            profile:*) label=${connection_names[${item#profile:}]:-Connessione};;
        esac
        kind='/'; row_style=$CLR_DIR
    elif [[ $item == '..' ]]; then
        kind='/'; label='..'; row_style=$CLR_DIR
    elif [[ -L $item ]]; then
        kind='@'
        if [[ -e $item ]]; then row_style=$CLR_LINK; else row_style=$CLR_BADLINK; fi
    elif [[ -d $item ]]; then
        kind='/'; row_style=$CLR_DIR
    elif [[ -f $item && -x $item ]]; then
        kind='*'; row_style=$CLR_EXEC
    fi
    [[ -v marks["$item"] ]] && row_style=$CLR_MARKED
    if (( idx == cursor && ${drawing_pane:-$active_pane} == active_pane )); then
        row_style=$CLR_CURSOR
        [[ -v marks["$item"] ]] && row_style=$CLR_MARK_CURSOR
    fi
    bytes='-'; modified='-'
    if [[ $cwd == "$connections_root" ]]; then
        bytes=''; modified=''
    elif [[ $item == '..' ]]; then
        bytes='UP--DIR'
    elif metadata=$(stat -c '%s %Y' -- "$item" 2>/dev/null); then
        read -r bytes epoch <<< "$metadata"
        if (( ${#bytes} > 10 )); then bytes=$(numfmt --to=iec --suffix=B "$bytes"); fi
        printf -v modified '%(%d/%m/%Y %H:%M)T' "$epoch"
    fi
    entry_columns " $selected $kind$label" "$bytes" "$modified" "$row_style"
}

draw_panel() {
    local drawing_pane=$1 cwd cursor scroll filter show_hidden pane_x pane_width inner needs_full
    local -a entries=()
    local -A marks=()
    local i title
    load_pane "$drawing_pane"
    pane_geometry "$drawing_pane"
    sync_scroll
    display_path "$cwd"
    title=" $REPLY"
    (( drawing_pane == active_pane )) && title=" * $REPLY"
    [[ -n $filter ]] && title+=" [Filtro: $filter]"
    printf '\033[1;%dH' "$pane_x" >&9
    border top
    printf '\033[2;%dH' "$pane_x" >&9
    line_text "$title" "$CLR_TITLE"
    printf '\033[3;%dH' "$pane_x" >&9
    column_header
    for ((i=0; i<visible; i++)); do paint_entry "$((scroll+i))"; done
    printf '\033[%d;%dH' "$((visible+4))" "$pane_x" >&9
    border bottom
}

selection_status() {
    local path=${entries[cursor]} target
    if [[ $cwd != "$connections_root" && -L $path ]] && target=$(readlink -- "$path"); then
        safe "$target"
        REPLY=" Link -> $REPLY"
    elif (( dual_pane )); then
        REPLY=' Tab: cambia lato | Ctrl+F: filtro | F5/F6: trasferisci nel pannello opposto'
    else
        REPLY=' Frecce: naviga | Ctrl+F: filtro | F10: esci'
    fi
}

draw_dual() {
    local inner=$((cols-2))
    save_pane
    draw_panel 0
    draw_panel 1
    printf '\033[%d;1H' "$actions_y" >&9
    render_actions
    line_text "$status_text" "$CLR_STATUS"
    line_text " $notice" "$CLR_NOTICE"
    border bottom
}

draw_notice() {
    local inner=$((cols-2))
    printf '\033[%d;1H' "$notice_y" >&9
    line_text " $notice" "$CLR_NOTICE"
}

draw() {
    local i status_text
    size
    if (( rows < 12 || cols < 35 )); then
        printf '\033[H\033[2JTerminale troppo piccolo (minimo 35x12).\r\n' >&9
        needs_full=1
        painted_rows=$rows; painted_cols=$cols
        return
    fi
    sync_scroll
    items_y=4
    actions_y=$((visible+5))
    notice_y=$((visible+7))
    selection_status; status_text=$REPLY

    if (( needs_full || rows != painted_rows || cols != painted_cols )); then
        # Riscrive alle posizioni fisse senza pulire tutto lo schermo.
        # Il bordo inferiore non emette CRLF, eliminando lo scroll terminale.
        if (( dual_pane )); then
            draw_dual
        else
            printf '\033[H' >&9
            border top
            display_path "$cwd"
            line_text " fm  $REPLY${filter:+ [Filtro: $filter]}" "$CLR_TITLE"
            column_header
            for ((i=0; i<visible; i++)); do
                paint_entry "$((scroll+i))"
            done
            printf '\033[%d;1H' "$((visible+4))" >&9
            border mid
            render_actions
            line_text "$status_text" "$CLR_STATUS"
            line_text " $notice" "$CLR_NOTICE"
            border bottom
        fi
        needs_full=0
    else
        if (( scroll != painted_scroll )); then
            # Scorre solo l'elenco attivo, senza ricaricare l'altro pannello.
            for ((i=0; i<visible; i++)); do paint_entry "$((scroll+i))"; done
        else
            # In navigazione aggiorna solo la vecchia e la nuova riga.
            (( painted_cursor != cursor )) && paint_entry "$painted_cursor"
            paint_entry "$cursor"
        fi
        if [[ $painted_status != "$status_text" ]]; then
            printf '\033[%d;1H' "$((notice_y-1))" >&9
            line_text "$status_text" "$CLR_STATUS"
        fi
        if [[ $painted_notice != "$notice" ]]; then
            draw_notice
        fi
    fi
    painted_rows=$rows; painted_cols=$cols
    painted_scroll=$scroll; painted_cursor=$cursor
    painted_notice=$notice; painted_status=$status_text
}

input_key() {
    local char next code='' n payload
    KEY=''
    MOUSE_BTN=0; MOUSE_X=0; MOUSE_Y=0; MOUSE_ACTION=''
    if [[ -n $PENDING_CHAR ]]; then
        char=$PENDING_CHAR; PENDING_CHAR=''
    else
        if ! IFS= read -rsn1 -u9 char; then
            # WINCH puo' interrompere read anche quando ha gia' ricevuto un tasto.
            [[ -n $char ]] || return 1
        fi
    fi
    case $char in
        $'\e')
            if ! IFS= read -rsn1 -t 0.50 -u9 next; then
                KEY='ESC'; return 0
            fi
            if [[ $next == [0-9] ]]; then
                if [[ $next == 0 ]]; then KEY='F10'; else KEY="F$next"; fi
                return 0
            fi
            if [[ $next != '[' && $next != 'O' ]]; then
                # Esc seguito rapidamente da una lettera: non perdere
                # la lettera digitata subito dopo Esc.
                PENDING_CHAR=$next
                KEY='ESC'
                return 0
            fi
            code=$next
            if [[ $next == '[' || $next == 'O' ]]; then
                for ((n=0; n<24; n++)); do
                    IFS= read -rsn1 -t 0.10 -u9 next || break
                    code+=$next
                    [[ $next == [a-zA-Z\~] ]] && break
                done
            fi
            if [[ $code == \[\<* ]]; then
                payload=${code#\[<}
                MOUSE_ACTION=${payload: -1}
                payload=${payload%?}
                IFS=';' read -r MOUSE_BTN MOUSE_X MOUSE_Y <<< "$payload"
                if [[ $MOUSE_BTN =~ ^[0-9]+$ && $MOUSE_X =~ ^[0-9]+$ && $MOUSE_Y =~ ^[0-9]+$ ]]; then
                    KEY='MOUSE'
                else
                    KEY='ESC'
                fi
                return 0
            fi
            case $code in
                '[A') KEY='UP';; '[B') KEY='DOWN';; '[C') KEY='RIGHT';; '[D') KEY='LEFT';; '[H'|'OH'|'[1~'|'[7~') KEY='HOME';;
                '[F'|'OF'|'[4~'|'[8~') KEY='END';;
                '[2~') KEY='F3';;
                '[3~') KEY='DELETE';;
                '[5~') KEY='PAGEUP';; '[6~') KEY='PAGEDOWN';;
                'OP'|'[11~'|'[[A') KEY='F1';;
                'OQ'|'[12~'|'[[B') KEY='F2';;
                'OR'|'[13~'|'[[C') KEY='F3';;
                'OS'|'[14~'|'[[D') KEY='F4';;
                '[15~'|'[5^'|'[[E') KEY='F5';;
                '[17~'|'[[F') KEY='F6';;
                '[18~'|'[[G') KEY='F7';;
                '[19~'|'[[H') KEY='F8';;
                '[21~') KEY='F10';;
                *) KEY='ESC';;
            esac
            ;;
        ''|$'\r'|$'\n') KEY='ENTER';;
        $'\177') KEY='BACK';;
        $'\b') KEY='HIDDEN';;
        ' ') if (( filter_editing )); then KEY=' '; else KEY='F3'; fi;;
        $'\023') KEY='SYMLINK';;
        $'\006') KEY='FILTER';;
        $'\t') KEY='TAB';;
        $'\030')
            IFS= read -rsn1 -u9 next || return 1
            case $next in
                c|C) KEY='ATTRIBUTES';;
                s|S) KEY='SYMLINK';;
                *) KEY='BAD_CHORD';;
            esac
            ;;
        *) KEY=$char;;
    esac
}

# Inserimento in modalita' raw: niente dipendenze su read -e/readline o dialog.
ask() {
    local prompt=$1 value='' ch
    while :; do
        notice="$prompt$value"
        draw
        IFS= read -rsn1 -u9 ch || return 1
        case $ch in
            ''|$'\r'|$'\n') REPLY=$value; return 0;;
            $'\e')
                # Scarta sequenze mouse durante i prompt.
                local next tail k
                if IFS= read -rsn1 -t 0.08 -u9 next; then
                    if [[ $next == '[' ]]; then
                        IFS= read -rsn1 -t 0.08 -u9 tail || { notice='Operazione annullata.'; return 1; }
                        if [[ $tail == '<' ]]; then
                            for ((k=0; k<30; k++)); do
                                IFS= read -rsn1 -t 0.08 -u9 tail || break
                                [[ $tail == M || $tail == m ]] && break
                            done
                            continue
                        fi
                    fi
                fi
                notice='Operazione annullata.'
                return 1
                ;;
            $'\177'|$'\b') value=${value%?};;
            *)
                if [[ $ch == [[:print:]] && ${#value} -lt 200 ]]; then
                    value+=$ch
                fi
                ;;
        esac
    done
}

select_current() {
    local path=${entries[cursor]}
    if [[ $path == '..' || $cwd == "$connections_root" ]]; then
        notice="La directory padre non e' selezionabile."
        return
    fi
    if [[ -v marks["$path"] ]]; then
        unset 'marks[$path]'
        notice='Elemento deselezionato.'
    else
        marks["$path"]=1
        notice='Elemento selezionato (*).'
    fi
    selection_sources[active_pane]=$cwd
}

collect() {
    local path key scope=${1:-current}
    local -a saved_targets=()
    targets=()
    for path in "${entries[@]}"; do
        [[ $path == '..' ]] && continue
        [[ -v marks["$path"] ]] && targets+=("$path")
    done
    # A pannello unico la selezione esplicita resta nella sua cartella di origine.
    if [[ $scope == transfer ]] && (( !dual_pane )) &&
       [[ -n ${selection_sources[active_pane]} && ${selection_sources[active_pane]} != "$cwd" ]]; then
        for key in "${!directory_marks[@]}"; do
            if [[ $key == "$active_pane:"* && ${directory_marks[$key]} == "${selection_sources[active_pane]}" ]]; then
                saved_targets+=("${key#*:}")
            fi
        done
        (( ${#saved_targets[@]} )) && targets=("${saved_targets[@]}")
    fi
    if (( ${#targets[@]} == 0 )); then
        path=${entries[cursor]}
        [[ $path != '..' ]] && targets+=("$path")
    fi
}

rename_item() {
    local path=${entries[cursor]} name file_error=''
    if [[ $path == '..' ]]; then
        notice='Seleziona prima un elemento.'
        return
    fi
    if ! rename_dialog "${path##*/}"; then return; fi
    name=$REPLY
    if [[ -z $name || $name == '.' || $name == '..' || $name == */* ]]; then
        notice='Nome non valido.'
        return
    fi
    if [[ $name == "${path##*/}" ]]; then notice='Nome invariato.'; return; fi
    if [[ -e $cwd/$name || -L $cwd/$name ]]; then
        notice="Esiste gia' un elemento con quel nome."
        return
    fi
    if file_command mv -T -- "$path" "$cwd/$name"; then
        reload
        notice="Rinominato: $name"
    else
        notice="Rinomina non riuscita: $file_error"
    fi
}

transfer_items() {
    local mode=$1 destination src dst source_root='' destination_root='' ftp_endpoint=0 ftp_move=0 file_error='' reason='' okay=0 failed=0
    local -a transfer_command=(mv -T)
    [[ $mode == copy ]] && transfer_command=(cp -aT)
    collect transfer
    if (( ${#targets[@]} == 0 )); then
        notice='Seleziona prima un elemento.'
        return
    fi
    if (( dual_pane )); then
        destination=${pane_dirs[1-active_pane]}
        if [[ $destination == "$connections_root" ]]; then
            notice='Apri una cartella nel pannello di destinazione.'; return
        fi
        if ! destination=$(cd -P -- "$destination" 2>/dev/null && pwd -P); then
            notice='Directory del pannello opposto non accessibile.'
            return
        fi
    else
        local prompt='Directory di destinazione (Esc annulla): ' default=''
        if [[ ${targets[0]%/*} != "$cwd" ]]; then
            prompt='Destinazione (Invio = cartella corrente, Esc annulla): '
            default=$cwd
        fi
        if ! ask "$prompt"; then return; fi
        destination=${REPLY:-$default}
        if [[ -z $destination ]]; then notice='Directory di destinazione non valida.'; return; fi
        [[ $destination != /* ]] && destination="$cwd/$destination"
        if ! destination=$(cd -P -- "$destination" 2>/dev/null && pwd -P); then
            notice='Directory di destinazione non valida.'
            return
        fi
    fi
    if is_archive_path "$destination"; then
        notice='Archivio di destinazione in sola lettura.'; return
    fi
    if [[ $mode == move ]]; then
        for src in "${targets[@]}"; do
            if is_archive_path "$src"; then notice='Archivio in sola lettura: usa F5 per copiare i contenuti.'; return; fi
        done
    fi
    if is_remote_path "${targets[0]}"; then
        source_root=$REPLY
        [[ ${remote_protocols[$REPLY]} == ftp ]] && ftp_endpoint=1
    fi
    if is_remote_path "$destination"; then
        destination_root=$REPLY
        [[ ${remote_protocols[$REPLY]} == ftp ]] && ftp_endpoint=1
    fi
    # FTP non garantisce attributi Unix. Tra mount diversi, elimina solo dopo una copia riuscita.
    if (( ftp_endpoint )) && { [[ $mode == copy ]] || [[ $source_root != "$destination_root" ]]; }; then
        transfer_command=(cp -RT '--no-preserve=mode,ownership,timestamps')
        [[ $mode == move ]] && ftp_move=1
    fi
    for src in "${targets[@]}"; do
        dst="$destination/${src##*/}"
        if [[ $src == "$dst" ]]; then
            reason=${reason:-"Stessa cartella di origine e destinazione."}
            ((failed+=1)); continue
        fi
        if [[ ! -e $src && ! -L $src ]]; then
            reason=${reason:-"Origine non disponibile: ${src##*/}"}
            ((failed+=1)); continue
        fi
        if [[ -e $dst || -L $dst ]]; then
            reason=${reason:-"Nome gia' presente nella destinazione: ${src##*/}"}
            ((failed+=1)); continue
        fi
        # Non copiare o spostare una directory al proprio interno.
        if [[ -d $src && ! -L $src && "$destination/" == "$src/"* ]]; then
            reason=${reason:-"Destinazione interna alla cartella da trasferire."}
            ((failed+=1)); continue
        fi
        if file_command "${transfer_command[@]}" -- "$src" "$dst"; then
            if (( ftp_move )) && ! file_command rm -rf -- "$src"; then
                reason=${reason:-$file_error}; ((failed+=1)); continue
            fi
            ((okay+=1))
        else
            reason=${reason:-$file_error}
            ((failed+=1))
        fi
    done
    for src in "${targets[@]}"; do unset 'directory_marks[$active_pane:$src]'; done
    selection_sources[active_pane]=''
    marks=()
    cursor=1
    reload
    notice="${reason:+$reason }Operazione completata: $okay. Non riusciti: $failed (nessuna sovrascrittura)."
}

new_dir() {
    local name file_error=''
    if ! ask 'Nome nuova directory (Esc annulla): '; then return; fi
    name=$REPLY
    if [[ -z $name || $name == '.' || $name == '..' || $name == */* ]]; then
        notice='Nome non valido.'
        return
    fi
    if [[ -e "$cwd/$name" || -L "$cwd/$name" ]]; then
        notice="Esiste gia' un elemento con quel nome."
        return
    fi
    if file_command mkdir -- "$cwd/$name"; then
        notice="Directory creata: $name"
    else
        notice="Creazione non riuscita: $file_error"
    fi
    reload
}

delete_items() {
    local path yes file_error='' reason='' count=0 errors=0
    collect
    if (( ${#targets[@]} == 0 )); then
        notice='Seleziona prima un elemento.'
        return
    fi
    if ! ask "Eliminare ${#targets[@]} elemento/i? s/N: "; then return; fi
    yes=$REPLY
    if [[ $yes != 's' && $yes != 'S' && $yes != 'y' && $yes != 'Y' ]]; then
        notice='Eliminazione annullata.'
        return
    fi
    for path in "${targets[@]}"; do
        if file_command rm -rf -- "$path"; then
            ((count+=1))
        else
            reason=${reason:-$file_error}
            ((errors+=1))
        fi
    done
    cursor=1
    reload
    notice="${reason:+$reason }Eliminati: $count. Errori: $errors."
}

# Libera il terminale per eseguire un programma interattivo.
run_executable() {
    local path=${entries[cursor]}
    if [[ $path == '..' || ! -f $path || ! -x $path ]]; then
        notice="Il file selezionato non e' un eseguibile."
        return
    fi
    run_program 1 "$path"
}

edit_item() {
    local path=${entries[cursor]}
    local -a editor
    if [[ $path == '..' || ! -f $path ]]; then
        notice='Seleziona un file da editare.'
        return
    fi
    read -r -a editor <<< "${EDITOR:-nano}"
    if (( ${#editor[@]} == 0 )) || ! command -v "${editor[0]}" >/dev/null 2>&1; then
        notice='Editor non disponibile: imposta EDITOR oppure installa nano.'
        return
    fi
    run_program 0 "${editor[@]}" "$path"
    reload
}

# Passa il terminale al comando e lo ripristina al termine.
run_program() {
    local wait_for_enter=$1 status run_cwd=$cwd
    shift
    local program_name=${run_program_label:-${1##*/}}
    printf '\033[?1000l\033[?1006l\033[?25h%s' "$CLR_RESET" >&9
    (( alt_screen )) && printf '\033[?1049l' >&9
    stty "$original_tty" <&9 || return
    printf '\r\nfm: esecuzione di %s\r\n' "$program_name" >&9
    # Invocazione diretta senza eval e senza interpolare il nome.
    [[ $run_cwd == "$connections_root" ]] && run_cwd=/
    (cd -- "$run_cwd" && "$@") <&9 >&9 2>&9
    status=$?
    if (( wait_for_enter )); then
        printf '\r\n[Uscita: %d] Premi Invio per tornare al file manager...' "$status" >&9
        IFS= read -r -u9 _unused || :
    fi
    stty -echo -icanon -icrnl -ixon min 1 time 0 <&9 || return
    (( alt_screen )) && printf '\033[?1049h' >&9
    printf '\033[?25l\033[?1000h\033[?1006h' >&9
    needs_full=1
    notice="Eseguito: $program_name (codice $status)."
    return "$status"
}

# sudo gestisce la password sul terminale: fm non la legge né la conserva.
file_command() {
    local error status
    file_error=''
    if error=$(LC_ALL=C "$@" 2>&1); then return 0; fi
    if [[ $error == *'Operation not permitted'* || $error == *'Permission denied'* ]]; then
        local argument
        for argument in "$@"; do
            if is_archive_path "$argument"; then file_error='Archivio in sola lettura.'; return 1; fi
            if is_remote_path "$argument"; then file_error='Permessi negati sul server remoto.'; return 1; fi
        done
        trap ':' INT
        run_program 0 sudo -- "$@"
        status=$?
        trap 'exit 130' INT
        (( status != 0 )) && file_error='Operazione sudo annullata o non riuscita.'
        return "$status"
    fi
    safe "$error"
    file_error=$REPLY
    return 1
}

# Finestre modali con la palette del tema MC modarin256-thin.
modal_frame() {
    local title=$1 i d
    if (( resized )); then resized=0; needs_full=1; draw; fi
    size
    modal_w=$((cols-4))
    (( modal_w > ${2:-78} )) && modal_w=${2:-78}
    modal_h=${3:-20}
    (( modal_h > rows )) && modal_h=$rows
    modal_x=$(((cols-modal_w)/2+1))
    modal_y=$(((rows-modal_h)/2+1))
    modal_buttons_x=$(((modal_w-25)/2))
    modal_buttons_row=$((modal_h-3))
    printf -v d '%*s' "$((modal_w-2))" ''
    d=${d// /$C_H}
    printf '\033[%d;%dH%s%s%s%s%s' "$modal_y" "$modal_x" "$CLR_DIALOG" "$C_TL" "$d" "$C_TR" "$CLR_RESET" >&9
    for ((i=1; i<modal_h-1; i++)); do
        printf '\033[%d;%dH%s%s%*s%s%s' "$((modal_y+i))" "$modal_x" \
            "$CLR_DIALOG" "$C_V" "$((modal_w-2))" '' "$C_V" "$CLR_RESET" >&9
    done
    printf '\033[%d;%dH%s%s%s%s%s' "$((modal_y+modal_h-1))" "$modal_x" \
        "$CLR_DIALOG" "$C_BL" "$d" "$C_BR" "$CLR_RESET" >&9
    fit " $title " "$((modal_w-4))"
    modal_text 0 "$(((modal_w-${#REPLY})/2))" "${#REPLY}" "$REPLY" "$CLR_DIALOG_TITLE"
}

modal_text() {
    local line=$1 column=$2 width=$3 content=$4 style=${5:-$CLR_DIALOG}
    fit "$content" "$width"
    printf '\033[%d;%dH%s%-*s%s' "$((modal_y+line))" "$((modal_x+column))" \
        "$style" "$width" "$REPLY" "$CLR_RESET" >&9
}

modal_line() {
    modal_text "$1" 2 "$((modal_w-4))" "$2" "${3:-$CLR_DIALOG}"
}

modal_rule() {
    local line=$1 d
    printf -v d '%*s' "$((modal_w-2))" ''
    modal_text "$line" 0 "$modal_w" "$C_LT${d// /$C_H}$C_RT"
}

modal_box() {
    local x=$1 width=$2 title=$3 bottom=$4 top=${5:-3} i d
    printf -v d '%*s' "$((width-2))" ''
    modal_text "$top" "$x" "$width" "$C_TL${d// /$C_H}$C_TR"
    modal_text "$top" "$((x+2))" "$((width-4))" " $title " "$CLR_DIALOG_TITLE"
    for ((i=top+1; i<bottom; i++)); do
        modal_text "$i" "$x" 1 "$C_V"
        modal_text "$i" "$((x+width-1))" 1 "$C_V"
    done
    modal_text "$bottom" "$x" "$width" "$C_BL${d// /$C_H}$C_BR"
}

modal_buttons() {
    local focus=$1 label=${2:-Imposta} line=$modal_buttons_row x=$modal_buttons_x
    modal_text "$line" "$x" 13 "[ $label ]" "$CLR_DIALOG"
    modal_text "$line" "$((x+14))" 11 '[ Annulla ]' "$CLR_DIALOG"
    (( focus == 0 )) && modal_text "$line" "$x" 13 "[<$label>]" "$CLR_DIALOG_FOCUS"
    (( focus == 1 )) && modal_text "$line" "$((x+14))" 11 '[<Annulla>]' "$CLR_DIALOG_FOCUS"
    return 0
}

# Disegno e hitbox usano le stesse coordinate calcolate da modal_frame.
modal_button_at() {
    local x=$((MOUSE_X-modal_x-modal_buttons_x))
    REPLY=''
    (( MOUSE_Y == modal_y+modal_buttons_row )) || return 1
    if (( x>=0 && x<13 )); then REPLY='apply'
    elif (( x>=14 && x<25 )); then REPLY='cancel'
    else return 1; fi
}

modal_cancel() {
    notice=$1
    needs_full=1
}

# Menu personale MC: condizioni valutate senza eseguire codice shell.
menu_condition() {
    local expression=$1 kind arg term negate op='|' result=0 path flag i=0
    local -a words=()
    expression=${expression//!/ ! }
    read -r -a words <<< "$expression"
    while (( i < ${#words[@]} )); do
        negate=0
        while [[ ${words[i]:-} == '!' ]]; do negate=$((1-negate)); ((i+=1)); done
        kind=${words[i]:-}; arg=${words[i+1]:-}; ((i+=2)); term=0
        path=$menu_file
        [[ $kind == [FDT] ]] && path=$other_file
        case $kind in
            f|F|d|D)
                case $kind in f) path=$menu_name;; F) path=$other_name;; d) path=$cwd;; D) path=$other_dir;; esac
                if (( menu_shell_patterns )); then
                    # shellcheck disable=SC2053
                    [[ $path == $arg ]] && term=1
                else [[ $path =~ $arg ]] && term=1; fi
                ;;
            t|T)
                for ((flag=0; flag<${#arg}; flag++)); do
                    case ${arg:flag:1} in
                        n) [[ ! -d $path ]] && term=1;; r) [[ -f $path ]] && term=1;;
                        d) [[ -d $path ]] && term=1;; l) [[ -L $path ]] && term=1;;
                        c) [[ -c $path ]] && term=1;; b) [[ -b $path ]] && term=1;;
                        f) [[ -p $path ]] && term=1;; s) [[ -S $path ]] && term=1;;
                        x) [[ -x $path ]] && term=1;;
                        t) if [[ $kind == t ]]; then (( ${#menu_tagged[@]} )) && term=1
                           else (( ${#other_tagged[@]} )) && term=1; fi;;
                    esac
                done
                ;;
            x) [[ -x $arg ]] && term=1;;
            *) return 1;;
        esac
        (( negate )) && term=$((1-term))
        if [[ $op == '&' ]]; then result=$((result && term)); else result=$((result || term)); fi
        op=${words[i]:-}; ((i+=1))
        [[ $op == '|' || $op == '&' ]] || break
    done
    (( result ))
}

menu_other_panel() {
    local cwd cursor scroll filter show_hidden needs_full path
    local -a entries=()
    local -A marks=()
    load_pane "$((1-active_pane))"
    other_dir=$cwd; other_name=${entries[cursor]##*/}; other_file=${entries[cursor]}
    [[ $other_file == '..' ]] && other_file="$cwd/.."
    for path in "${entries[@]}"; do
        [[ -v marks["$path"] ]] && other_tagged+=("${path##*/}")
    done
}

load_user_menu() {
    local line prefix expression include=1 default=0 idx=-1
    while IFS= read -r line || [[ -n $line ]]; do
        [[ $line == \#* ]] && continue
        if [[ $line == shell_patterns=* ]]; then menu_shell_patterns=${line#*=}; continue; fi
        if [[ $line =~ ^([+=]+)\??[[:space:]]*(.*)$ ]]; then
            prefix=${BASH_REMATCH[1]}; expression=${BASH_REMATCH[2]}
            local matches=0
            menu_condition "$expression" && matches=1
            [[ $prefix == *+* ]] && include=$matches
            [[ $prefix == *=* ]] && default=$matches
            idx=-1
        elif [[ $line == [[:space:]]* || -z $line ]]; then
            (( idx >= 0 )) && menu_scripts[idx]+="$line"$'\n'
        elif [[ $line =~ ^([^[:space:]])[[:space:]]+(.+)$ ]]; then
            if (( include )); then
                idx=${#menu_keys[@]}
                menu_keys+=("${BASH_REMATCH[1]}"); menu_labels+=("${BASH_REMATCH[2]}"); menu_scripts+=('')
                (( default && menu_default < 0 )) && menu_default=$idx
            else idx=-1; fi
            include=1; default=0
        fi
    done < "$menu_source"
}

expand_user_command() {
    local body=$1 i char rest prompt value quote path
    local -a values=()
    menu_script=''; menu_view=0; menu_unmark=0; menu_other_unmark=0
    for ((i=0; i<${#body}; i++)); do
        char=${body:i:1}
        if [[ $char != '%' ]]; then menu_script+=$char; continue; fi
        ((i+=1)); char=${body:i:1}; quote=1; values=()
        if [[ $char == [01] ]]; then quote=$char; ((i+=1)); char=${body:i:1}; fi
        case $char in
            '%') menu_script+='%'; continue;;
            '{')
                rest=${body:i+1}; prompt=${rest%%\}*}
                if ! ask "$prompt: "; then return 1; fi
                values=("$REPLY"); ((i+=${#prompt}+1))
                ;;
            v)
                if [[ ${body:i:4} != view ]]; then notice='Macro MC non supportata: %v'; return 1; fi
                menu_view=1; ((i+=3))
                if [[ ${body:i+1:1} == '{' ]]; then rest=${body:i+2}; rest=${rest%%\}*}; ((i+=${#rest}+2)); fi
                continue
                ;;
            f|p) values=("$menu_name");; d) values=("$cwd");;
            F|P) values=("$other_name");; D) values=("$other_dir");;
            s) values=("${menu_tagged[@]}"); (( ${#values[@]} )) || values=("$menu_name");;
            S) values=("${other_tagged[@]}"); (( ${#values[@]} )) || values=("$other_name");;
            t|u) values=("${menu_tagged[@]}"); [[ $char == u ]] && menu_unmark=1;;
            T|U) values=("${other_tagged[@]}"); [[ $char == U ]] && menu_other_unmark=1;;
            *) notice="Macro MC non supportata: %$char"; return 1;;
        esac
        value=''
        for path in "${values[@]}"; do
            if (( quote )); then printf -v rest '%q' "$path"; else rest=$path; fi
            value+="${value:+ }$rest"
        done
        menu_script+=$value
    done
}

user_menu() {
    local menu_source=${XDG_CONFIG_HOME:-$HOME/.config}/mc/menu
    [[ -r $menu_source ]] || menu_source=/etc/mc/mc.menu
    if [[ ! -r $menu_source ]]; then notice='Menu MC non trovato.'; return; fi
    local menu_file=${entries[cursor]} menu_name=${entries[cursor]##*/} path key i choice=0 offset=0 capacity focus=0
    local other_file=$menu_file other_name=$menu_name other_dir=$cwd menu_shell_patterns=1 menu_default=-1
    local menu_script menu_view menu_unmark menu_other_unmark clicked=-1 click_time=0 now
    local -a menu_keys=() menu_labels=() menu_scripts=() menu_tagged=() other_tagged=() pager=()
    [[ $menu_file == '..' ]] && menu_file="$cwd/.."
    for path in "${entries[@]}"; do
        [[ -v marks["$path"] ]] && menu_tagged+=("${path##*/}")
    done
    if (( dual_pane )); then menu_other_panel; else other_file=$menu_file; fi
    load_user_menu
    if (( !${#menu_keys[@]} )); then notice='Nessun comando MC disponibile per la selezione.'; return; fi
    (( menu_default >= 0 )) && choice=$menu_default
    needs_full=1
    while :; do
        modal_frame 'Menu comandi (MC)' 78 24
        capacity=$((modal_h-6))
        (( choice < offset )) && offset=$choice
        (( choice >= offset+capacity )) && offset=$((choice-capacity+1))
        modal_line 1 "$menu_source" "$CLR_DIALOG_TITLE"
        for ((i=0; i<capacity && i+offset<${#menu_keys[@]}; i++)); do
            local style=$CLR_DIALOG
            (( i+offset == choice && focus == 0 )) && style=$CLR_DIALOG_FOCUS
            modal_line "$((i+2))" " ${menu_keys[i+offset]}  ${menu_labels[i+offset]}" "$style"
        done
        modal_rule "$((modal_h-4))"
        modal_buttons "$((focus-1))" 'Esegui'
        modal_line "$((modal_h-2))" 'Frecce/Pg: scegli  Invio: esegui  Esc: annulla'
        if ! input_key; then needs_full=1; return; fi
        key=$KEY
        case $key in
            UP) focus=0; (( choice>0 )) && ((choice-=1));;
            DOWN) focus=0; (( choice+1<${#menu_keys[@]} )) && ((choice+=1));;
            HOME) focus=0; choice=0;; END) focus=0; choice=$((${#menu_keys[@]}-1));;
            PAGEUP) focus=0; ((choice-=capacity)); ((choice<0)) && choice=0;;
            PAGEDOWN) focus=0; ((choice+=capacity)); ((choice>=${#menu_keys[@]})) && choice=$((${#menu_keys[@]}-1));;
            TAB) focus=$(((focus+1)%3));;
            ESC|F10) modal_cancel 'Menu comandi annullato.'; return;;
            ENTER) if (( focus == 2 )); then needs_full=1; return; fi; break;;
            MOUSE)
                local x=$((MOUSE_X-modal_x)) y=$((MOUSE_Y-modal_y))
                if (( MOUSE_BTN == 64 )); then focus=0; ((choice>0)) && ((choice-=1))
                elif (( MOUSE_BTN == 65 )); then focus=0; ((choice+1<${#menu_keys[@]})) && ((choice+=1))
                elif [[ $MOUSE_ACTION == M && $MOUSE_BTN == 0 ]] && (( x>0 && x<modal_w-1 )); then
                    if (( y>=2 && y<2+capacity && y-2+offset<${#menu_keys[@]} )); then
                        choice=$((y-2+offset)); focus=0; now=$(now_millis)
                        if (( clicked == choice && now-click_time<450 )); then break; fi
                        clicked=$choice; click_time=$now
                    elif modal_button_at; then
                        if [[ $REPLY == apply ]]; then break; fi
                        needs_full=1; return
                    fi
                fi
                ;;
            *)
                local found=0
                for i in "${!menu_keys[@]}"; do
                    if [[ $key == "${menu_keys[i]}" ]]; then choice=$i; found=1; break; fi
                done
                (( found )) && break
                ;;
        esac
    done
    needs_full=1
    if ! expand_user_command "${menu_scripts[choice]}"; then return; fi
    (( menu_unmark )) && marks=()
    if (( menu_other_unmark )); then
        for key in "${!pane_marks[@]}"; do [[ $key == "$((1-active_pane)):"* ]] && unset 'pane_marks[$key]'; done
    fi
    if (( menu_view )); then
        read -r -a pager <<< "${PAGER:-less}"
        if command -v "${pager[0]}" >/dev/null 2>&1; then
            run_program 0 bash -c 'set -o pipefail; bash -c "$1" | "${@:2}"' fm-menu "$menu_script" "${pager[@]}"
        else run_program 1 bash -c "$menu_script"; fi
    else run_program 1 bash -c "$menu_script"; fi
    local -a selected_paths=("${!marks[@]}")
    reload
    for path in "${selected_paths[@]}"; do [[ -e $path || -L $path ]] && marks["$path"]=1; done
}

rename_dialog() {
    local original=$1 name=$1 pos=0 selected=1 focus=0 offset=0 width key x y style
    while :; do
        modal_frame 'Rinomina' 66 12
        width=$((modal_w-8))
        (( pos < offset )) && offset=$pos
        (( pos >= offset+width )) && offset=$((pos-width+1))
        modal_line 1 'Nome attuale:' "$CLR_DIALOG_TITLE"
        modal_line 2 "$original"
        modal_line 4 'Nuovo nome:' "$CLR_DIALOG_TITLE"
        style=$CLR_DIALOG
        (( focus == 0 )) && style=$CLR_CURSOR
        modal_text 5 4 "$width" "${name:offset:width}" "$style"
        if (( selected && focus == 0 )); then
            modal_text 5 4 "$(( ${#name}<width ? ${#name} : width ))" "${name:0:width}" "$CLR_DIALOG_FOCUS"
        fi
        modal_line 7 'Invio: rinomina  Tab: pulsanti  Esc: annulla'
        modal_rule 8
        modal_buttons "$((focus-1))" 'Rinomina'
        if (( focus == 0 )); then
            printf '\033[%d;%dH\033[?25h' "$((modal_y+5))" "$((modal_x+4+pos-offset))" >&9
        fi
        if ! input_key; then
            printf '\033[?25l' >&9
            modal_cancel 'Rinomina annullata.'; return 1
        fi
        printf '\033[?25l' >&9
        key=$KEY
        case $key in
            TAB) focus=$(((focus+1)%3));;
            ESC|F10) modal_cancel 'Rinomina annullata.'; return 1;;
            ENTER)
                if (( focus == 2 )); then modal_cancel 'Rinomina annullata.'; return 1; fi
                REPLY=$name; needs_full=1; return 0
                ;;
            LEFT)
                if (( focus == 0 )); then
                    if (( selected )); then pos=0; elif (( pos>0 )); then ((pos-=1)); fi
                    selected=0
                fi
                ;;
            RIGHT)
                if (( focus == 0 )); then
                    if (( selected )); then pos=${#name}; elif (( pos<${#name} )); then ((pos+=1)); fi
                    selected=0
                fi
                ;;
            HOME) pos=0; selected=0;;
            END) pos=${#name}; selected=0;;
            BACK|DELETE)
                if (( focus == 0 )); then
                    if (( selected )); then name=''; pos=0
                    elif [[ $key == BACK ]] && (( pos>0 )); then
                        name="${name:0:pos-1}${name:pos}"; ((pos-=1))
                    elif [[ $key == DELETE ]]; then name="${name:0:pos}${name:pos+1}"
                    fi
                    selected=0
                fi
                ;;
            $'\025') if (( focus == 0 )); then name=''; pos=0; selected=0; fi;;
            MOUSE)
                x=$((MOUSE_X-modal_x)); y=$((MOUSE_Y-modal_y))
                if [[ $MOUSE_ACTION == M && $MOUSE_BTN == 0 ]]; then
                    if (( y == 5 && x>=4 && x<modal_w-4 )); then
                        focus=0; selected=0; pos=$((offset+x-4))
                        (( pos>${#name} )) && pos=${#name}
                    elif modal_button_at; then
                        if [[ $REPLY == apply ]]; then
                            focus=1; PENDING_CHAR=$'\r'
                        else
                            modal_cancel 'Rinomina annullata.'; return 1
                        fi
                    fi
                fi
                ;;
            *)
                [[ $key == F3 ]] && key=' '
                if (( focus == 0 )) && [[ ${#key} == 1 && $key == [[:print:]] ]]; then
                    if (( selected )); then name=''; pos=0; offset=0; selected=0; fi
                    name="${name:0:pos}$key${name:pos}"; ((pos+=1))
                elif [[ $key == ' ' ]] && (( focus>0 )); then PENDING_CHAR=$'\r'
                fi
                ;;
        esac
    done
}

