#!/usr/bin/env bash
# fm: one- or two-pane file manager without external TUI libraries.
# Requires Bash >= 4 (associative arrays), stty and basic GNU commands.
set -u

usage() {
    cat <<'HELP'
Usage: fm [DIRECTORY]

One- or two-pane TUI file manager (Bash, no ncurses).

 Up / Down arrows                select a row (Lynx style)
 Right arrow / Enter             open directory/file (MIME) or run executable
 Left arrow / Backspace          go to parent, highlighting the directory left
 PgUp / PgDn / Home / End         navigate quickly
 F1                              Midnight Commander commands menu
 F2                              rename file or directory
 F3 / Ins / Space                select/unselect and advance to the next row
 F4                              edit with $EDITOR (or nano)
 F5                              copy to other pane (or ask for destination)
 F6                              move to other pane (or ask for destination)
 F7                              create a directory
 Ctrl+X S with connections root  bookmark the directory in the other pane
 F2 / F8 in Connections          rename / delete only the profile or shortcut
 F8                              delete (asks for confirmation)
 F10                             quit the file manager
 ?                               help and shortcuts (scrollable window)
 Esc then 1...9 / 0 (within 0.5s) same as F1...F9 / F10 (F9 unassigned)
 Ctrl+X then C                   permissions, owner and group
 Ctrl+X then S                   create a symbolic link (also Ctrl+S)
 Ctrl+S                          create absolute link <name>.lnk
 Ctrl+F                          filter dialog for file name and content text
 Ctrl+H                          show/hide hidden files and directories
 Tab                             switch pane (from 100 columns)
 Mouse click                     select / double-click to open
 Mouse wheel                     scroll the list
 r                               refresh the list

Environment options:
 ABFM_NO_ALT_SCREEN=1             do not use the alternate screen
 ABFM_NO_COLOR=1                  disable ANSI colors
 ABFM_ASCII=1                     use ASCII frames instead of box drawing
HELP
}

if [[ ${1:-} == --help || ${1:-} == -h ]]; then
    usage
    exit 0
fi
if (( $# > 1 )); then
    usage >&2
    exit 2
fi
if [[ ! -t 0 || ! -t 1 || ! -r /dev/tty ]]; then
    printf 'fm: run in an interactive terminal.\n' >&2
    exit 1
fi
if ! command -v stty >/dev/null 2>&1; then
    printf 'fm: stty is not available.\n' >&2
    exit 1
fi
if ! cwd=$(cd -P -- "${1:-.}" 2>/dev/null && pwd -P); then
    printf 'fm: cannot access directory: %s\n' "${1:-.}" >&2
    exit 1
fi

# Keep /dev/tty open: input and output remain reliable even with pipes.
exec 9<>/dev/tty
original_tty=$(stty -g <&9) || exit 1
alt_screen=1
[[ ${ABFM_NO_ALT_SCREEN:-0} == 1 ]] && alt_screen=0
mouse_enabled=0
declare -a entries=() targets=()
declare -A marks=()
declare -a action_keys=() action_starts=() action_ends=()
notice='Lynx: Up/Down select, Right opens, Left goes back. F10 exits.'
cursor=0
scroll=0
rows=24 cols=80 visible=12 inner=78
items_y=4
actions_y=0
last_click_ms=0
last_click_path=''
MOUSE_BTN=0; MOUSE_X=0; MOUSE_Y=0; MOUSE_ACTION=''
PENDING_CHAR=''
active_pane=0 dual_pane=0 pane_x=1 pane_width=80 filter='' content_filter='' show_hidden=1 resized=0
# State of both views; history is separate for each pane and directory.
declare -a pane_dirs=("$cwd" "$cwd") pane_cursors=(1 1) pane_scrolls=(0 0) pane_filters=('' '') pane_contents=('' '') pane_hidden=(1 1)
declare -A search_cache=() search_counts=()
declare -A pane_marks=() directory_focus=() directory_scroll=() directory_marks=()
# Source of the last explicit selection, used by F5/F6 in single-pane mode.
connections_root='@connections'
connections_dir=${XDG_CONFIG_HOME:-$HOME/.config}/fm/connections
shortcuts_dir=${XDG_CONFIG_HOME:-$HOME/.config}/fm/shortcuts
declare -A connection_names=() connection_protocols=() connection_addresses=()
declare -A remote_labels=() remote_protocols=() remote_addresses=() archive_sources=() archive_cache=()
archive_pending_cache=''
declare -a selection_sources=('' '')
# Rendering coordinates: remember rows to avoid full redraws.
needs_full=1
painted_rows=0 painted_cols=0 painted_scroll=-1 painted_cursor=-1
painted_notice='' painted_status=''
USE_COLOR=1; USE_UNICODE=1
CLR_RESET='' CLR_BORDER='' CLR_HEADER='' CLR_TITLE='' CLR_STATUS='' CLR_NOTICE='' CLR_CURSOR=''
CLR_PANEL='' CLR_DIR='' CLR_EXEC='' CLR_LINK='' CLR_BADLINK=''
CLR_DIALOG='' CLR_DIALOG_TITLE='' CLR_DIALOG_FOCUS=''
CLR_MARKED='' CLR_MARK_CURSOR='' CLR_FOOTER='' CLR_HOTKEY=''
C_TL='+' C_TR='+' C_BL='+' C_BR='+' C_H='-' C_V='|' C_LT='+' C_RT='+'
init_theme() {
    local locale=${LC_ALL:-${LC_CTYPE:-${LANG:-}}}
    USE_COLOR=1; USE_UNICODE=1
    [[ -n ${NO_COLOR:-} || ${ABFM_NO_COLOR:-0} == 1 || ${TERM:-} == dumb ]] && USE_COLOR=0
    [[ ${ABFM_ASCII:-0} == 1 ]] && USE_UNICODE=0
    [[ $locale != *UTF-8* && $locale != *utf8* && $locale != *utf-8* ]] && USE_UNICODE=0
    # Reference palette with file type colors, ANSI 256 colors.
    if (( USE_COLOR )); then
        CLR_RESET=$'\033[0m'
        CLR_DIALOG=$'\033[0;38;5;252;48;5;239m'
        CLR_DIALOG_TITLE=$'\033[1;38;5;180;48;5;239m'
        CLR_DIALOG_FOCUS=$'\033[1;38;5;228;48;5;23m'
        # Dark gray pane, muted yellow text and teal cursor.
        CLR_PANEL=$'\033[38;5;144;48;5;237m'
        CLR_BORDER=$'\033[38;5;144;48;5;237m'
        CLR_HEADER=$'\033[1;33;48;5;237m'
        CLR_TITLE=$'\033[1;38;5;144;48;5;237m'
        CLR_DIR=$'\033[1;38;5;144;48;5;237m'
        CLR_EXEC=$'\033[38;5;120;48;5;237m'
        CLR_LINK=$'\033[38;5;117;48;5;237m'
        CLR_BADLINK=$'\033[38;5;210;48;5;237m'
        CLR_MARKED=$'\033[1;38;5;228;48;5;237m'
        CLR_CURSOR=$'\033[38;5;252;48;5;23m'
        CLR_MARK_CURSOR=$'\033[1;38;5;228;48;5;23m'
        CLR_STATUS=$'\033[38;5;236;48;5;250m'
        CLR_NOTICE=$'\033[38;5;255;48;5;237m'
        CLR_FOOTER=$'\033[38;5;254;48;5;236m'
        CLR_HOTKEY=$'\033[38;5;252;48;5;23m'
    fi

    if (( USE_UNICODE )); then
        C_TL='┌'; C_TR='┐'; C_BL='└'; C_BR='┘'; C_H='─'; C_V='│'; C_LT='├'; C_RT='┤'
    fi
}
cleanup() {
    trap - EXIT INT TERM HUP WINCH
    local archive_root
    [[ -n $archive_pending_cache ]] && rm -rf -- "$archive_pending_cache"
    for archive_root in "${!archive_cache[@]}"; do
        if gio mount -u "$archive_root" >/dev/null 2>&1; then
            rm -rf -- "${archive_cache[$archive_root]}"
        fi
    done
    stty "$original_tty" <&9 2>/dev/null || :
    if (( mouse_enabled )); then
        printf '\033[?1000l\033[?1006l' >&9
    fi
    printf '%s\033[?25h' "$CLR_RESET" >&9
    (( alt_screen )) && printf '\033[?1049l' >&9
    exec 9>&-
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP
trap 'resized=1; needs_full=1' WINCH
stty -echo -icanon -icrnl -ixon min 1 time 0 <&9 || exit 1
init_theme
(( alt_screen )) && printf '\033[?1049h' >&9
printf '\033[?25l' >&9
printf '\033[?1000h\033[?1006h' >&9
mouse_enabled=1
shopt -s nullglob dotglob

safe() {
    local value=$1
    value=${value//[$'\001'-$'\037'$'\177']/\?}
    REPLY=$value
}

fit() {
    safe "$1"
    local str=$REPLY max=$2
    if (( ${#str} > max )); then
        if (( max > 3 )); then
            REPLY="${str:0:max-3}..."
        else
            REPLY="${str:0:max}"
        fi
    else
        REPLY=$str
    fi
}

line_text() {
    local s=$1 style=${2:-}
    fit "$s" "$inner"
    printf '%s%s%s' "$CLR_BORDER" "$C_V" "${style:-$CLR_PANEL}" >&9
    printf '%-*s' "$inner" "$REPLY" >&9
    printf '%s%s%s\r\n' "$CLR_BORDER" "$C_V" "$CLR_RESET" >&9
}
border() {
    local kind=${1:-mid} left right d
    printf -v d '%*s' "$inner" ''
    d=${d// /$C_H}
    case $kind in
        top) left=$C_TL; right=$C_TR ;;
        bottom) left=$C_BL; right=$C_BR ;;
        *) left=$C_LT; right=$C_RT ;;
    esac
    if [[ $kind == bottom ]]; then
        # No CRLF from the final cell: avoid scrolling and SGR misalignment.
        printf '%s%s%s%s%s' "$CLR_BORDER" "$left" "$d" "$right" "$CLR_RESET" >&9
    else
        printf '%s%s%s%s%s\r\n' "$CLR_BORDER" "$left" "$d" "$right" "$CLR_RESET" >&9
    fi
}

size() {
    local dimensions
    dimensions=$(stty size <&9 2>/dev/null) || dimensions='24 80'
    read -r rows cols <<< "$dimensions"
    [[ $rows =~ ^[0-9]+$ && $cols =~ ^[0-9]+$ ]] || { rows=24; cols=80; }
    dual_pane=0
    (( cols >= 100 )) && dual_pane=1
    pane_geometry "$active_pane"
    visible=$((rows-8))
}

# The active pane state stays in the variables used by file operations.
pane_geometry() {
    pane_x=1; pane_width=$cols
    if (( dual_pane )); then
        pane_width=$((cols/2))
        if (( $1 == 1 )); then
            pane_x=$((pane_width+1))
            pane_width=$((cols-pane_width))
        fi
    fi
    inner=$((pane_width-2))
}

save_pane() {
    local key path
    pane_dirs[active_pane]=$cwd
    pane_cursors[active_pane]=$cursor
    pane_scrolls[active_pane]=$scroll
    pane_filters[active_pane]=$filter
    pane_contents[active_pane]=$content_filter
    pane_hidden[active_pane]=$show_hidden
    for key in "${!pane_marks[@]}"; do
        [[ $key == "$active_pane:"* ]] && unset 'pane_marks[$key]'
    done
    for path in "${!marks[@]}"; do
        pane_marks["$active_pane:$path"]=1
    done
}

load_pane() {
    local id=$1 key
    cwd=${pane_dirs[id]}; cursor=${pane_cursors[id]}
    scroll=${pane_scrolls[id]}; filter=${pane_filters[id]}
    content_filter=${pane_contents[id]}
    show_hidden=${pane_hidden[id]}
    reload cached "$id"
    for key in "${!pane_marks[@]}"; do
        [[ $key == "$id:"* ]] && marks["${key#*:}"]=1
    done
}

switch_pane() {
    (( dual_pane )) || return 0
    save_pane
    active_pane=$((1-active_pane))
    load_pane "$active_pane"
    pane_geometry "$active_pane"
    last_click_path=''; last_click_ms=0
}

filter_items() {
    local name=$filter text=$content_filter focus=0 pos=${#filter} key value width offset style i x y
    while :; do
        modal_frame 'Filter' 72 12
        width=$((modal_w-8))
        for i in 0 1; do
            if (( i == 0 )); then value=$name; else value=$text; fi
            style=$CLR_DIALOG; offset=0
            if (( focus == i )); then
                style=$CLR_CURSOR
                (( pos>=width )) && offset=$((pos-width+1))
            fi
            if (( i == 0 )); then modal_line 1 'File name:' "$CLR_DIALOG_TITLE"
            else modal_line 4 'Content text:' "$CLR_DIALOG_TITLE"; fi
            modal_text "$((2+i*3))" 4 "$width" "${value:offset:width}" "$style"
        done
        modal_line 7 'Tab: field  Enter: search  Esc: cancel'
        modal_rule 8
        modal_buttons "$((focus-2))" 'Search'
        if (( focus<2 )); then
            offset=0; (( pos>=width )) && offset=$((pos-width+1))
            printf '\033[%d;%dH\033[?25h' "$((modal_y+2+focus*3))" "$((modal_x+4+pos-offset))" >&9
        fi
        if ! input_key; then
            printf '\033[?25l' >&9
            modal_cancel 'Filter cancelled.'; return
        fi
        printf '\033[?25l' >&9
        key=$KEY
        case $key in
            ESC|F10) modal_cancel 'Filter cancelled.'; return;;
            TAB|UP|DOWN)
                if [[ $key == TAB ]]; then focus=$(((focus+1)%4)); else focus=$((1-focus%2)); fi
                if (( focus == 0 )); then pos=${#name}; else pos=${#text}; fi
                ;;
            ENTER)
                if (( focus==3 )); then modal_cancel 'Filter cancelled.'; return; fi
                filter=$name; content_filter=$text; cursor=1; scroll=0
                notice='Searching the current directory...'; needs_full=1
                printf '\033[%d;1H%s' "$((rows-1))" "$notice" >&9
                reload
                notice="Results: $((${#entries[@]}-1)). Enter opens, Esc clears the filter."
                return
                ;;
            MOUSE)
                x=$((MOUSE_X-modal_x)); y=$((MOUSE_Y-modal_y))
                if [[ $MOUSE_ACTION == M && $MOUSE_BTN == 0 ]]; then
                    if (( x>=4 && x<modal_w-4 && (y==2 || y==5) )); then
                        focus=$(((y-2)/3))
                        if (( focus==0 )); then pos=${#name}; else pos=${#text}; fi
                    elif modal_button_at; then
                        if [[ $REPLY == apply ]]; then focus=2; PENDING_CHAR=$'\r'
                        else modal_cancel 'Filter cancelled.'; return; fi
                    fi
                fi
                ;;
            *)
                if (( focus>=2 )); then
                    [[ $key == F3 ]] && PENDING_CHAR=$'\r'
                    continue
                fi
                if (( focus==0 )); then value=$name; else value=$text; fi
                case $key in
                    LEFT) ((pos>0)) && ((pos-=1));;
                    RIGHT) ((pos<${#value})) && ((pos+=1));;
                    HOME) pos=0;; END) pos=${#value};;
                    BACK) if ((pos>0)); then value="${value:0:pos-1}${value:pos}"; ((pos-=1)); fi;;
                    DELETE) value="${value:0:pos}${value:pos+1}";;
                    $'\025') value=''; pos=0;;
                    *)
                        [[ $key == F3 ]] && key=' '
                        if [[ ${#key} == 1 && $key == [[:print:]] ]] && (( ${#value}<200 )); then
                            value="${value:0:pos}$key${value:pos}"; ((pos+=1))
                        fi
                        ;;
                esac
                if (( focus==0 )); then name=$value; else text=$value; fi
                ;;
        esac
    done
}

clear_filter() {
    [[ -n $filter || -n $content_filter ]] || return 0
    local current=${entries[cursor]} offset=$((cursor-scroll)) path i
    local -a selected=("${!marks[@]}")
    filter=''; content_filter=''
    reload
    for path in "${selected[@]}"; do marks["$path"]=1; done
    for i in "${!entries[@]}"; do
        if [[ ${entries[i]} == "$current" ]]; then cursor=$i; break; fi
    done
    # Keep the item on the same row for the second mouse click too.
    scroll=$((cursor-offset))
    (( scroll < 0 )) && scroll=0
    notice='Filter cleared.'
}

now_millis() {
    # EPOCHREALTIME follows LC_NUMERIC: Italian locales may use a comma!
    # Do not interpret the original string as a Bash integer (former line 194 bug).
    local stamp=${EPOCHREALTIME:-} sec frac
    stamp=${stamp/,/.}
    if [[ $stamp =~ ^([0-9]+)\.([0-9]{1,6})$ ]]; then
        sec=${BASH_REMATCH[1]}
        frac=${BASH_REMATCH[2]}
        frac=${frac:0:3}
        while (( ${#frac} < 3 )); do frac+="0"; done
        printf '%s\n' "$((10#$sec * 1000 + 10#$frac))"
    else
        # Bash < 5 or clock unavailable: seconds from the printf builtin.
        printf -v sec '%(%s)T' -1
        printf '%s\n' "$((10#$sec * 1000))"
    fi
}

reload() {
    local path name i cache_pane=${2:-$active_pane}
    local -a dirs=() files=()
    entries=('..')
    if [[ $cwd == "$connections_root" ]]; then
        entries=('local' 'ssh' 'ftp')
        load_saved_connections
        for path in "$shortcuts_dir"/*; do
            [[ -L $path ]] && entries+=("$path")
        done
    elif [[ ${1:-} == cached && ( -n $filter || -n $content_filter ) && -v search_counts[$cache_pane] ]]; then
        for ((i=0; i<search_counts[$cache_pane]; i++)); do
            entries+=("${search_cache[$cache_pane:$i]}")
        done
    else
        for path in "$cwd"/*; do
            name=${path##*/}
            if (( !show_hidden )) && [[ $name == .* ]]; then continue; fi
            [[ ${name,,} == *"${filter,,}"* ]] || continue
            if [[ -n $content_filter ]]; then
                [[ -f $path && ! -L $path ]] || continue
                grep -iIFq -- "$content_filter" "$path" 2>/dev/null || continue
            fi
            [[ -d $path ]] && dirs+=("$path") || files+=("$path")
        done
        entries+=("${dirs[@]}" "${files[@]}")
        if [[ -n $filter || -n $content_filter ]]; then
            search_counts[$cache_pane]=$((${#entries[@]}-1))
            for ((i=1; i<${#entries[@]}; i++)); do search_cache[$cache_pane:$((i-1))]=${entries[i]}; done
        fi
    fi
    (( cursor >= ${#entries[@]} )) && cursor=$((${#entries[@]}-1))
    (( cursor < 0 )) && cursor=0
    (( scroll > cursor )) && scroll=$cursor
    # Selection marks are local to the displayed directory.
    marks=()
    needs_full=1
}

sync_scroll() {
    (( cursor < scroll )) && scroll=$cursor
    (( cursor >= scroll+visible )) && scroll=$((cursor-visible+1))
    (( scroll < 0 )) && scroll=0
}

render_actions() {
    local -a segs=(
        '[F1] Menu' '[F2] Rename' '[F3] Select' '[F4] Edit' '[F5] Copy' '[F6] Move' '[F7] Mkdir' '[F8] Delete' '[F10] Quit'
    )
    # MC bar: highlighted keys on teal, commands on a dark background.
    action_keys=(F1 F2 F3 F4 F5 F6 F7 F8 F10)
    if (( inner < 113 )); then
        segs=('1Menu' '2Ren' '3Sel' '4Ed' '5Cpy' '6Mov' '7Dir' '8Del' '10Quit')
        if (( inner < 55 )); then
            segs=('1U' '2R' '3S' '4E' '5C' '6M' '7D' '8X' '10Q')
        fi
    fi
    action_starts=()
    action_ends=()
    local seg idx used=1 prefix suffix start width gap=2
    (( inner < 55 )) && gap=1
    printf '%s%s%s ' "$CLR_BORDER" "$C_V" "$CLR_FOOTER" >&9
    for idx in "${!segs[@]}"; do
        seg=${segs[idx]}
        if (( idx > 0 )); then
            printf '%*s' "$gap" '' >&9
            ((used+=gap))
        fi
        start=$((used + 2))
        if [[ $seg == \[* ]]; then
            prefix=${seg%%]*}']'
            suffix=${seg#"$prefix"}
        else
            if [[ $seg == 10* ]]; then
                prefix='10'; suffix=${seg:2}
            else
                prefix=${seg:0:1}; suffix=${seg:1}
            fi
        fi
        printf '%s%s%s%s' "$CLR_HOTKEY" "$prefix" "$CLR_FOOTER" "$suffix" >&9
        ((used+=${#seg}))
        action_starts[idx]=$start
        action_ends[idx]=$((used+1))
    done
    width=$((inner-used))
    ((width > 0)) && printf '%*s' "$width" '' >&9
    printf '%s%s%s\r\n' "$CLR_BORDER" "$C_V" "$CLR_RESET" >&9
}

# Columns keep the same position even with long names.
entry_columns() {
    local name=$1 bytes=$2 modified=$3 style=$4 name_width=$((inner-28))
    fit "$name" "$name_width"
    name=$REPLY
    fit "$bytes" 10
    printf -v name '%-*s%s%10s%s%-16s' "$name_width" "$name" "$C_V" "$REPLY" "$C_V" "$modified"
    line_text "$name" "$style"
}

column_header() {
    entry_columns ' Name' 'Size' 'Last modified' "$CLR_HEADER"
}

# Print the visible row at its actual terminal position (1-based).
# Y=4 is the first row, after the frame, title and headings.
paint_entry() {
    local idx=$1 n item label selected kind row_style metadata bytes modified epoch
    (( idx >= scroll && idx < scroll+visible )) || return 0
    n=$((idx-scroll))
    printf '\033[%d;%dH' "$((items_y+n))" "$pane_x" >&9
    if (( idx >= ${#entries[@]} )); then
        entry_columns '' '' '' "$CLR_PANEL"
        return
    fi
    item=${entries[idx]}
    selected=' '
    [[ -v marks["$item"] ]] && selected='*'
    row_style=$CLR_PANEL
    kind=' '
    label=${item##*/}
    if [[ $cwd == "$connections_root" ]]; then
        case $item in
            local) label='This PC';; ssh) label='SSH';; ftp) label='FTP';;
            profile:*) label=${connection_names[${item#profile:}]:-Connection};;
        esac
        kind='/'; row_style=$CLR_DIR
        if [[ $item == "$shortcuts_dir/"* ]]; then
            kind='@'; row_style=$CLR_LINK
            local shortcut_target
            shortcut_target=$(readlink -- "$item")
            [[ -d $item || $shortcut_target == sftp://* || $shortcut_target == ftp://* ]] || row_style=$CLR_BADLINK
        fi
    elif [[ $item == '..' ]]; then
        kind='/'; label='..'; row_style=$CLR_DIR
    elif [[ -L $item ]]; then
        kind='@'
        if [[ -e $item ]]; then row_style=$CLR_LINK; else row_style=$CLR_BADLINK; fi
    elif [[ -d $item ]]; then
        kind='/'; row_style=$CLR_DIR
    elif [[ -f $item && -x $item ]]; then
        kind='*'; row_style=$CLR_EXEC
    fi
    [[ -v marks["$item"] ]] && row_style=$CLR_MARKED
    if (( idx == cursor && ${drawing_pane:-$active_pane} == active_pane )); then
        row_style=$CLR_CURSOR
        [[ -v marks["$item"] ]] && row_style=$CLR_MARK_CURSOR
    fi
    bytes='-'; modified='-'
    if [[ $cwd == "$connections_root" ]]; then
        bytes=''; modified=''
    elif [[ $item == '..' ]]; then
        bytes='UP--DIR'
    elif metadata=$(stat -c '%s %Y' -- "$item" 2>/dev/null); then
        read -r bytes epoch <<< "$metadata"
        if (( ${#bytes} > 10 )); then bytes=$(numfmt --to=iec --suffix=B "$bytes"); fi
        printf -v modified '%(%d/%m/%Y %H:%M)T' "$epoch"
    fi
    entry_columns " $selected $kind$label" "$bytes" "$modified" "$row_style"
}

draw_panel() {
    local drawing_pane=$1 cwd cursor scroll filter content_filter show_hidden pane_x pane_width inner needs_full
    local -a entries=()
    local -A marks=()
    local i title
    load_pane "$drawing_pane"
    pane_geometry "$drawing_pane"
    sync_scroll
    display_path "$cwd"
    title=" $REPLY"
    (( drawing_pane == active_pane )) && title=" * $REPLY"
    [[ -n $filter || -n $content_filter ]] && title+=" [Filter: $filter${content_filter:+ | Text: $content_filter}]"
    printf '\033[1;%dH' "$pane_x" >&9
    border top
    printf '\033[2;%dH' "$pane_x" >&9
    line_text "$title" "$CLR_TITLE"
    printf '\033[3;%dH' "$pane_x" >&9
    column_header
    for ((i=0; i<visible; i++)); do paint_entry "$((scroll+i))"; done
    printf '\033[%d;%dH' "$((visible+4))" "$pane_x" >&9
    border bottom
}

selection_status() {
    local path=${entries[cursor]} target
    if [[ $path == /* && -L $path ]] && target=$(readlink -- "$path"); then
        safe "$target"
        REPLY=" Link -> $REPLY"
    elif [[ $cwd == "$connections_root" ]]; then
        REPLY=' Ctrl+X S: bookmark from other pane | F2/F8: edit | ?: help'
    elif (( dual_pane )); then
        REPLY=' Tab: switch pane | ?: Help and shortcuts | Ctrl+F: filter | F5/F6: transfer to other pane'
    else
        REPLY=' Arrows: navigate | Ctrl+F: filter | ?: help | F10: quit'
    fi
}

draw_dual() {
    local inner=$((cols-2))
    save_pane
    draw_panel 0
    draw_panel 1
    printf '\033[%d;1H' "$actions_y" >&9
    render_actions
    line_text "$status_text" "$CLR_STATUS"
    line_text " $notice" "$CLR_NOTICE"
    border bottom
}

draw_notice() {
    local inner=$((cols-2))
    printf '\033[%d;1H' "$notice_y" >&9
    line_text " $notice" "$CLR_NOTICE"
}

draw() {
    local i status_text
    size
    if (( rows < 12 || cols < 35 )); then
        printf '\033[H\033[2JTerminal too small (minimum 35x12).\r\n' >&9
        needs_full=1
        painted_rows=$rows; painted_cols=$cols
        return
    fi
    sync_scroll
    items_y=4
    actions_y=$((visible+5))
    notice_y=$((visible+7))
    selection_status; status_text=$REPLY

    if (( needs_full || rows != painted_rows || cols != painted_cols )); then
        # Rewrite at fixed positions without clearing the entire screen.
        # The bottom border emits no CRLF, preventing terminal scrolling.
        if (( dual_pane )); then
            draw_dual
        else
            printf '\033[H' >&9
            border top
            display_path "$cwd"
            line_text " fm  $REPLY${filter:+ [Name: $filter]}${content_filter:+ [Text: $content_filter]}" "$CLR_TITLE"
            column_header
            for ((i=0; i<visible; i++)); do
                paint_entry "$((scroll+i))"
            done
            printf '\033[%d;1H' "$((visible+4))" >&9
            border mid
            render_actions
            line_text "$status_text" "$CLR_STATUS"
            line_text " $notice" "$CLR_NOTICE"
            border bottom
        fi
        needs_full=0
    else
        if (( scroll != painted_scroll )); then
            # Scroll only the active list, without reloading the other pane.
            for ((i=0; i<visible; i++)); do paint_entry "$((scroll+i))"; done
        else
            # During navigation, update only the old and new rows.
            (( painted_cursor != cursor )) && paint_entry "$painted_cursor"
            paint_entry "$cursor"
        fi
        if [[ $painted_status != "$status_text" ]]; then
            printf '\033[%d;1H' "$((notice_y-1))" >&9
            line_text "$status_text" "$CLR_STATUS"
        fi
        if [[ $painted_notice != "$notice" ]]; then
            draw_notice
        fi
    fi
    painted_rows=$rows; painted_cols=$cols
    painted_scroll=$scroll; painted_cursor=$cursor
    painted_notice=$notice; painted_status=$status_text
}

input_key() {
    local char next code='' n payload
    KEY=''
    MOUSE_BTN=0; MOUSE_X=0; MOUSE_Y=0; MOUSE_ACTION=''
    if [[ -n $PENDING_CHAR ]]; then
        char=$PENDING_CHAR; PENDING_CHAR=''
    else
        if ! IFS= read -rsn1 -u9 char; then
            # WINCH may interrupt read even after it has received a key.
            [[ -n $char ]] || return 1
        fi
    fi
    case $char in
        $'\e')
            if ! IFS= read -rsn1 -t 0.50 -u9 next; then
                KEY='ESC'; return 0
            fi
            if [[ $next == [0-9] ]]; then
                if [[ $next == 0 ]]; then KEY='F10'; else KEY="F$next"; fi
                return 0
            fi
            if [[ $next != '[' && $next != 'O' ]]; then
                # Esc quickly followed by a letter: keep
                # the letter typed immediately after Esc.
                PENDING_CHAR=$next
                KEY='ESC'
                return 0
            fi
            code=$next
            if [[ $next == '[' || $next == 'O' ]]; then
                for ((n=0; n<24; n++)); do
                    IFS= read -rsn1 -t 0.10 -u9 next || break
                    code+=$next
                    [[ $next == [a-zA-Z\~] ]] && break
                done
            fi
            if [[ $code == \[\<* ]]; then
                payload=${code#\[<}
                MOUSE_ACTION=${payload: -1}
                payload=${payload%?}
                IFS=';' read -r MOUSE_BTN MOUSE_X MOUSE_Y <<< "$payload"
                if [[ $MOUSE_BTN =~ ^[0-9]+$ && $MOUSE_X =~ ^[0-9]+$ && $MOUSE_Y =~ ^[0-9]+$ ]]; then
                    KEY='MOUSE'
                else
                    KEY='ESC'
                fi
                return 0
            fi
            case $code in
                '[A') KEY='UP';; '[B') KEY='DOWN';; '[C') KEY='RIGHT';; '[D') KEY='LEFT';; '[H'|'OH'|'[1~'|'[7~') KEY='HOME';;
                '[F'|'OF'|'[4~'|'[8~') KEY='END';;
                '[2~') KEY='F3';;
                '[3~') KEY='DELETE';;
                '[5~') KEY='PAGEUP';; '[6~') KEY='PAGEDOWN';;
                'OP'|'[11~'|'[[A') KEY='F1';;
                'OQ'|'[12~'|'[[B') KEY='F2';;
                'OR'|'[13~'|'[[C') KEY='F3';;
                'OS'|'[14~'|'[[D') KEY='F4';;
                '[15~'|'[5^'|'[[E') KEY='F5';;
                '[17~'|'[[F') KEY='F6';;
                '[18~'|'[[G') KEY='F7';;
                '[19~'|'[[H') KEY='F8';;
                '[21~') KEY='F10';;
                *) KEY='ESC';;
            esac
            ;;
        ''|$'\r'|$'\n') KEY='ENTER';;
        $'\177') KEY='BACK';;
        $'\b') KEY='HIDDEN';;
        ' ') KEY='F3';;
        $'\023') KEY='SYMLINK';;
        $'\006') KEY='FILTER';;
        $'\t') KEY='TAB';;
        $'\030')
            IFS= read -rsn1 -u9 next || return 1
            case $next in
                c|C) KEY='ATTRIBUTES';;
                s|S) KEY='SYMLINK';;
                *) KEY='BAD_CHORD';;
            esac
            ;;
        *) KEY=$char;;
    esac
}

# Raw mode input: no dependencies on read -e/readline or dialog.
ask() {
    local prompt=$1 value='' ch
    while :; do
        notice="$prompt$value"
        draw
        IFS= read -rsn1 -u9 ch || return 1
        case $ch in
            ''|$'\r'|$'\n') REPLY=$value; return 0;;
            $'\e')
                # Discard mouse sequences during prompts.
                local next tail k
                if IFS= read -rsn1 -t 0.08 -u9 next; then
                    if [[ $next == '[' ]]; then
                        IFS= read -rsn1 -t 0.08 -u9 tail || { notice='Operation cancelled.'; return 1; }
                        if [[ $tail == '<' ]]; then
                            for ((k=0; k<30; k++)); do
                                IFS= read -rsn1 -t 0.08 -u9 tail || break
                                [[ $tail == M || $tail == m ]] && break
                            done
                            continue
                        fi
                    fi
                fi
                notice='Operation cancelled.'
                return 1
                ;;
            $'\177'|$'\b') value=${value%?};;
            *)
                if [[ $ch == [[:print:]] && ${#value} -lt 200 ]]; then
                    value+=$ch
                fi
                ;;
        esac
    done
}

select_current() {
    local path=${entries[cursor]}
    if [[ $path == '..' || $cwd == "$connections_root" ]]; then
        notice="The parent directory cannot be selected."
        return
    fi
    if [[ -v marks["$path"] ]]; then
        unset 'marks[$path]'
        notice='Item unselected.'
    else
        marks["$path"]=1
        notice='Item selected (*).'
    fi
    selection_sources[active_pane]=$cwd
}

collect() {
    local path key scope=${1:-current}
    local -a saved_targets=()
    targets=()
    for path in "${entries[@]}"; do
        [[ $path == '..' ]] && continue
        [[ -v marks["$path"] ]] && targets+=("$path")
    done
    # In single-pane mode, explicit selections remain in their source directory.
    if [[ $scope == transfer ]] && (( !dual_pane )) &&
       [[ -n ${selection_sources[active_pane]} && ${selection_sources[active_pane]} != "$cwd" ]]; then
        for key in "${!directory_marks[@]}"; do
            if [[ $key == "$active_pane:"* && ${directory_marks[$key]} == "${selection_sources[active_pane]}" ]]; then
                saved_targets+=("${key#*:}")
            fi
        done
        (( ${#saved_targets[@]} )) && targets=("${saved_targets[@]}")
    fi
    if (( ${#targets[@]} == 0 )); then
        path=${entries[cursor]}
        [[ $path != '..' ]] && targets+=("$path")
    fi
}

rename_item() {
    local path=${entries[cursor]} name file_error='' destination=$cwd
    [[ $cwd == "$connections_root" ]] && destination=$shortcuts_dir
    if [[ $path == '..' ]]; then
        notice='Select an item first.'
        return
    fi
    if ! rename_dialog "${path##*/}"; then return; fi
    name=$REPLY
    if [[ -z $name || $name == '.' || $name == '..' || $name == */* ]]; then
        notice='Invalid name.'
        return
    fi
    if [[ $name == "${path##*/}" ]]; then notice='Name unchanged.'; return; fi
    if [[ -e $destination/$name || -L $destination/$name ]]; then
        notice="An item with that name already exists."
        return
    fi
    if file_command mv -T -- "$path" "$destination/$name"; then
        reload
        notice="Renamed: $name"
    else
        notice="Rename failed: $file_error"
    fi
}

transfer_items() {
    local mode=$1 destination src dst source_root='' destination_root='' ftp_endpoint=0 ftp_move=0 file_error='' reason='' okay=0 failed=0
    local -a transfer_command=(mv -T)
    [[ $mode == copy ]] && transfer_command=(cp -aT)
    collect transfer
    if (( ${#targets[@]} == 0 )); then
        notice='Select an item first.'
        return
    fi
    if (( dual_pane )); then
        destination=${pane_dirs[1-active_pane]}
        if [[ $destination == "$connections_root" ]]; then
            notice='Open a directory in the destination pane.'; return
        fi
        if ! destination=$(cd -P -- "$destination" 2>/dev/null && pwd -P); then
            notice='Cannot access the other pane directory.'
            return
        fi
    else
        local prompt='Destination directory (Esc cancels): ' default=''
        if [[ ${targets[0]%/*} != "$cwd" ]]; then
            prompt='Destination (Enter = current directory, Esc cancels): '
            default=$cwd
        fi
        if ! ask "$prompt"; then return; fi
        destination=${REPLY:-$default}
        if [[ -z $destination ]]; then notice='Invalid destination directory.'; return; fi
        [[ $destination != /* ]] && destination="$cwd/$destination"
        if ! destination=$(cd -P -- "$destination" 2>/dev/null && pwd -P); then
            notice='Invalid destination directory.'
            return
        fi
    fi
    if is_archive_path "$destination"; then
        notice='Destination archive is read-only.'; return
    fi
    if [[ $mode == move ]]; then
        for src in "${targets[@]}"; do
            if is_archive_path "$src"; then notice='Read-only archive: use F5 to copy its contents.'; return; fi
        done
    fi
    if is_remote_path "${targets[0]}"; then
        source_root=$REPLY
        [[ ${remote_protocols[$REPLY]} == ftp ]] && ftp_endpoint=1
    fi
    if is_remote_path "$destination"; then
        destination_root=$REPLY
        [[ ${remote_protocols[$REPLY]} == ftp ]] && ftp_endpoint=1
    fi
    # FTP does not guarantee Unix attributes. Across mounts, delete only after a successful copy.
    if (( ftp_endpoint )) && { [[ $mode == copy ]] || [[ $source_root != "$destination_root" ]]; }; then
        transfer_command=(cp -RT '--no-preserve=mode,ownership,timestamps')
        [[ $mode == move ]] && ftp_move=1
    fi
    for src in "${targets[@]}"; do
        dst="$destination/${src##*/}"
        if [[ $src == "$dst" ]]; then
            reason=${reason:-"Source and destination are the same directory."}
            ((failed+=1)); continue
        fi
        if [[ ! -e $src && ! -L $src ]]; then
            reason=${reason:-"Source unavailable: ${src##*/}"}
            ((failed+=1)); continue
        fi
        if [[ -e $dst || -L $dst ]]; then
            reason=${reason:-"Name already exists at destination: ${src##*/}"}
            ((failed+=1)); continue
        fi
        # Do not copy or move a directory inside itself.
        if [[ -d $src && ! -L $src && "$destination/" == "$src/"* ]]; then
            reason=${reason:-"Destination is inside the source directory."}
            ((failed+=1)); continue
        fi
        if file_command "${transfer_command[@]}" -- "$src" "$dst"; then
            if (( ftp_move )) && ! file_command rm -rf -- "$src"; then
                reason=${reason:-$file_error}; ((failed+=1)); continue
            fi
            ((okay+=1))
        else
            reason=${reason:-$file_error}
            ((failed+=1))
        fi
    done
    for src in "${targets[@]}"; do unset 'directory_marks[$active_pane:$src]'; done
    selection_sources[active_pane]=''
    marks=()
    cursor=1
    reload
    notice="${reason:+$reason }Completed: $okay. Failed: $failed (no overwrites)."
}

new_dir() {
    local name file_error=''
    if ! ask 'New directory name (Esc cancels): '; then return; fi
    name=$REPLY
    if [[ -z $name || $name == '.' || $name == '..' || $name == */* ]]; then
        notice='Invalid name.'
        return
    fi
    if [[ -e "$cwd/$name" || -L "$cwd/$name" ]]; then
        notice="An item with that name already exists."
        return
    fi
    if file_command mkdir -- "$cwd/$name"; then
        notice="Directory created: $name"
    else
        notice="Creation failed: $file_error"
    fi
    reload
}

delete_items() {
    local path yes file_error='' reason='' count=0 errors=0
    collect
    if (( ${#targets[@]} == 0 )); then
        notice='Select an item first.'
        return
    fi
    if ! ask "Delete ${#targets[@]} item(s)? y/N: "; then return; fi
    yes=$REPLY
    if [[ $yes != 'y' && $yes != 'Y' ]]; then
        notice='Deletion cancelled.'
        return
    fi
    for path in "${targets[@]}"; do
        if file_command rm -rf -- "$path"; then
            ((count+=1))
        else
            reason=${reason:-$file_error}
            ((errors+=1))
        fi
    done
    cursor=1
    reload
    notice="${reason:+$reason }Deleted: $count. Errors: $errors."
}

# Release the terminal to run an interactive program.
run_executable() {
    local path=${entries[cursor]}
    if [[ $path == '..' || ! -f $path || ! -x $path ]]; then
        notice="The selected file is not executable."
        return
    fi
    run_program 1 "$path"
}

open_document() {
    local path=$1 error_file error
    if ! command -v gio >/dev/null 2>&1; then
        notice='MIME opening unavailable: install gio (libglib2.0-bin).'
        return
    fi
    error_file=$(mktemp) || return
    if gio open "$path" </dev/null >/dev/null 2>"$error_file"; then
        safe "${path##*/}"
        notice="Open requested: $REPLY"
    else
        error=$(<"$error_file")
        safe "$error"
        notice="Open failed: $REPLY"
    fi
    rm -f -- "$error_file"
}

edit_item() {
    local path=${entries[cursor]}
    local -a editor
    if [[ $path == '..' || ! -f $path ]]; then
        notice='Select a file to edit.'
        return
    fi
    read -r -a editor <<< "${EDITOR:-nano}"
    if (( ${#editor[@]} == 0 )) || ! command -v "${editor[0]}" >/dev/null 2>&1; then
        notice='Editor unavailable: set EDITOR or install nano.'
        return
    fi
    run_program 0 "${editor[@]}" "$path"
    reload
}

# Pass the terminal to the command and restore it afterward.
run_program() {
    local wait_for_enter=$1 status run_cwd=$cwd
    shift
    local program_name=${run_program_label:-${1##*/}}
    printf '\033[?1000l\033[?1006l\033[?25h%s' "$CLR_RESET" >&9
    (( alt_screen )) && printf '\033[?1049l' >&9
    stty "$original_tty" <&9 || return
    printf '\r\nfm: esecuzione di %s\r\n' "$program_name" >&9
    # Invoke directly without eval or interpolating the name.
    [[ $run_cwd == "$connections_root" ]] && run_cwd=/
    (cd -- "$run_cwd" && "$@") <&9 >&9 2>&9
    status=$?
    if (( wait_for_enter )); then
        printf '\r\n[Exit: %d] Press Enter to return to the file manager...' "$status" >&9
        IFS= read -r -u9 _unused || :
    fi
    stty -echo -icanon -icrnl -ixon min 1 time 0 <&9 || return
    (( alt_screen )) && printf '\033[?1049h' >&9
    printf '\033[?25l\033[?1000h\033[?1006h' >&9
    needs_full=1
    search_counts=()
    notice="Executed: $program_name (exit code $status)."
    return "$status"
}

# sudo handles the password in the terminal: fm never reads or stores it.
file_command() {
    local error status
    file_error=''
    search_counts=()
    if error=$(LC_ALL=C "$@" 2>&1); then return 0; fi
    if [[ $error == *'Operation not permitted'* || $error == *'Permission denied'* ]]; then
        local argument
        for argument in "$@"; do
            if is_archive_path "$argument"; then file_error='Read-only archive.'; return 1; fi
            if is_remote_path "$argument"; then file_error='Permessi negati sul server remoto.'; return 1; fi
        done
        trap ':' INT
        run_program 0 sudo -- "$@"
        status=$?
        trap 'exit 130' INT
        (( status != 0 )) && file_error='Sudo operation cancelled or failed.'
        return "$status"
    fi
    safe "$error"
    file_error=$REPLY
    return 1
}

# Modal windows using the MC modarin256-thin theme palette.
modal_frame() {
    local title=$1 i d
    if (( resized )); then resized=0; needs_full=1; draw; fi
    size
    modal_w=$((cols-4))
    (( modal_w > ${2:-78} )) && modal_w=${2:-78}
    modal_h=${3:-20}
    (( modal_h > rows )) && modal_h=$rows
    modal_x=$(((cols-modal_w)/2+1))
    modal_y=$(((rows-modal_h)/2+1))
    modal_buttons_x=$(((modal_w-25)/2))
    modal_buttons_row=$((modal_h-3))
    printf -v d '%*s' "$((modal_w-2))" ''
    d=${d// /$C_H}
    printf '\033[%d;%dH%s%s%s%s%s' "$modal_y" "$modal_x" "$CLR_DIALOG" "$C_TL" "$d" "$C_TR" "$CLR_RESET" >&9
    for ((i=1; i<modal_h-1; i++)); do
        printf '\033[%d;%dH%s%s%*s%s%s' "$((modal_y+i))" "$modal_x" \
            "$CLR_DIALOG" "$C_V" "$((modal_w-2))" '' "$C_V" "$CLR_RESET" >&9
    done
    printf '\033[%d;%dH%s%s%s%s%s' "$((modal_y+modal_h-1))" "$modal_x" \
        "$CLR_DIALOG" "$C_BL" "$d" "$C_BR" "$CLR_RESET" >&9
    fit " $title " "$((modal_w-4))"
    modal_text 0 "$(((modal_w-${#REPLY})/2))" "${#REPLY}" "$REPLY" "$CLR_DIALOG_TITLE"
}

modal_text() {
    local line=$1 column=$2 width=$3 content=$4 style=${5:-$CLR_DIALOG}
    fit "$content" "$width"
    printf '\033[%d;%dH%s%-*s%s' "$((modal_y+line))" "$((modal_x+column))" \
        "$style" "$width" "$REPLY" "$CLR_RESET" >&9
}

modal_line() {
    modal_text "$1" 2 "$((modal_w-4))" "$2" "${3:-$CLR_DIALOG}"
}

modal_rule() {
    local line=$1 d
    printf -v d '%*s' "$((modal_w-2))" ''
    modal_text "$line" 0 "$modal_w" "$C_LT${d// /$C_H}$C_RT"
}

modal_box() {
    local x=$1 width=$2 title=$3 bottom=$4 top=${5:-3} i d
    printf -v d '%*s' "$((width-2))" ''
    modal_text "$top" "$x" "$width" "$C_TL${d// /$C_H}$C_TR"
    modal_text "$top" "$((x+2))" "$((width-4))" " $title " "$CLR_DIALOG_TITLE"
    for ((i=top+1; i<bottom; i++)); do
        modal_text "$i" "$x" 1 "$C_V"
        modal_text "$i" "$((x+width-1))" 1 "$C_V"
    done
    modal_text "$bottom" "$x" "$width" "$C_BL${d// /$C_H}$C_BR"
}

modal_buttons() {
    local focus=$1 label=${2:-Apply} line=$modal_buttons_row x=$modal_buttons_x
    modal_text "$line" "$x" 13 "[ $label ]" "$CLR_DIALOG"
    modal_text "$line" "$((x+14))" 11 '[ Cancel ]' "$CLR_DIALOG"
    (( focus == 0 )) && modal_text "$line" "$x" 13 "[<$label>]" "$CLR_DIALOG_FOCUS"
    (( focus == 1 )) && modal_text "$line" "$((x+14))" 11 '[<Cancel>]' "$CLR_DIALOG_FOCUS"
    return 0
}

# Drawing and hitboxes share the coordinates calculated by modal_frame.
modal_button_at() {
    local x=$((MOUSE_X-modal_x-modal_buttons_x))
    REPLY=''
    (( MOUSE_Y == modal_y+modal_buttons_row )) || return 1
    if (( x>=0 && x<13 )); then REPLY='apply'
    elif (( x>=14 && x<25 )); then REPLY='cancel'
    else return 1; fi
}

modal_cancel() {
    notice=$1
    needs_full=1
}

show_help() {
    local offset=0 capacity limit i button_x
    local -a help_lines=()
    needs_full=1
    while :; do
        modal_frame 'Help' 90 26
        mapfile -t help_lines < <(usage | fold -s -w "$((modal_w-4))")
        capacity=$((modal_h-5))
        limit=$((${#help_lines[@]}-capacity))
        (( limit < 0 )) && limit=0
        (( offset > limit )) && offset=$limit
        (( offset < 0 )) && offset=0
        for ((i=0; i<capacity && i+offset<${#help_lines[@]}; i++)); do
            modal_line "$((i+1))" "${help_lines[i+offset]}"
        done
        modal_rule "$((modal_h-4))"
        modal_line "$((modal_h-3))" 'Arrows/Pg/Home/End: scroll'
        button_x=$(((modal_w-10)/2))
        modal_text "$((modal_h-2))" "$button_x" 10 '[ Close ]' "$CLR_DIALOG_FOCUS"
        if ! input_key; then needs_full=1; return; fi
        case $KEY in
            UP) ((offset-=1));; DOWN) ((offset+=1));;
            PAGEUP) ((offset-=capacity));; PAGEDOWN) ((offset+=capacity));;
            HOME) offset=0;; END) offset=$limit;;
            ENTER|ESC|F10|'?') needs_full=1; return;;
            MOUSE)
                if (( MOUSE_BTN == 64 )); then ((offset-=1))
                elif (( MOUSE_BTN == 65 )); then ((offset+=1))
                elif [[ $MOUSE_ACTION == M && $MOUSE_BTN == 0 ]] &&
                     (( MOUSE_Y == modal_y+modal_h-2 && MOUSE_X >= modal_x+button_x && MOUSE_X < modal_x+button_x+10 )); then
                    needs_full=1; return
                fi
                ;;
        esac
    done
}

# Personal MC menu: evaluate conditions without executing shell code.
menu_condition() {
    local expression=$1 kind arg term negate op='|' result=0 path flag i=0
    local -a words=()
    expression=${expression//!/ ! }
    read -r -a words <<< "$expression"
    while (( i < ${#words[@]} )); do
        negate=0
        while [[ ${words[i]:-} == '!' ]]; do negate=$((1-negate)); ((i+=1)); done
        kind=${words[i]:-}; arg=${words[i+1]:-}; ((i+=2)); term=0
        path=$menu_file
        [[ $kind == [FDT] ]] && path=$other_file
        case $kind in
            f|F|d|D)
                case $kind in f) path=$menu_name;; F) path=$other_name;; d) path=$cwd;; D) path=$other_dir;; esac
                if (( menu_shell_patterns )); then
                    # shellcheck disable=SC2053
                    [[ $path == $arg ]] && term=1
                else [[ $path =~ $arg ]] && term=1; fi
                ;;
            t|T)
                for ((flag=0; flag<${#arg}; flag++)); do
                    case ${arg:flag:1} in
                        n) [[ ! -d $path ]] && term=1;; r) [[ -f $path ]] && term=1;;
                        d) [[ -d $path ]] && term=1;; l) [[ -L $path ]] && term=1;;
                        c) [[ -c $path ]] && term=1;; b) [[ -b $path ]] && term=1;;
                        f) [[ -p $path ]] && term=1;; s) [[ -S $path ]] && term=1;;
                        x) [[ -x $path ]] && term=1;;
                        t) if [[ $kind == t ]]; then (( ${#menu_tagged[@]} )) && term=1
                           else (( ${#other_tagged[@]} )) && term=1; fi;;
                    esac
                done
                ;;
            x) [[ -x $arg ]] && term=1;;
            *) return 1;;
        esac
        (( negate )) && term=$((1-term))
        if [[ $op == '&' ]]; then result=$((result && term)); else result=$((result || term)); fi
        op=${words[i]:-}; ((i+=1))
        [[ $op == '|' || $op == '&' ]] || break
    done
    (( result ))
}

menu_other_panel() {
    local cwd cursor scroll filter content_filter show_hidden needs_full path
    local -a entries=()
    local -A marks=()
    load_pane "$((1-active_pane))"
    other_dir=$cwd; other_name=${entries[cursor]##*/}; other_file=${entries[cursor]}
    [[ $other_file == '..' ]] && other_file="$cwd/.."
    for path in "${entries[@]}"; do
        [[ -v marks["$path"] ]] && other_tagged+=("${path##*/}")
    done
}

load_user_menu() {
    local line prefix expression include=1 default=0 idx=-1
    while IFS= read -r line || [[ -n $line ]]; do
        [[ $line == \#* ]] && continue
        if [[ $line == shell_patterns=* ]]; then menu_shell_patterns=${line#*=}; continue; fi
        if [[ $line =~ ^([+=]+)\??[[:space:]]*(.*)$ ]]; then
            prefix=${BASH_REMATCH[1]}; expression=${BASH_REMATCH[2]}
            local matches=0
            menu_condition "$expression" && matches=1
            [[ $prefix == *+* ]] && include=$matches
            [[ $prefix == *=* ]] && default=$matches
            idx=-1
        elif [[ $line == [[:space:]]* || -z $line ]]; then
            (( idx >= 0 )) && menu_scripts[idx]+="$line"$'\n'
        elif [[ $line =~ ^([^[:space:]])[[:space:]]+(.+)$ ]]; then
            if (( include )); then
                idx=${#menu_keys[@]}
                menu_keys+=("${BASH_REMATCH[1]}"); menu_labels+=("${BASH_REMATCH[2]}"); menu_scripts+=('')
                (( default && menu_default < 0 )) && menu_default=$idx
            else idx=-1; fi
            include=1; default=0
        fi
    done < "$menu_source"
}

expand_user_command() {
    local body=$1 i char rest prompt value quote path
    local -a values=()
    menu_script=''; menu_view=0; menu_unmark=0; menu_other_unmark=0
    for ((i=0; i<${#body}; i++)); do
        char=${body:i:1}
        if [[ $char != '%' ]]; then menu_script+=$char; continue; fi
        ((i+=1)); char=${body:i:1}; quote=1; values=()
        if [[ $char == [01] ]]; then quote=$char; ((i+=1)); char=${body:i:1}; fi
        case $char in
            '%') menu_script+='%'; continue;;
            '{')
                rest=${body:i+1}; prompt=${rest%%\}*}
                if ! ask "$prompt: "; then return 1; fi
                values=("$REPLY"); ((i+=${#prompt}+1))
                ;;
            v)
                if [[ ${body:i:4} != view ]]; then notice='Unsupported MC macro: %v'; return 1; fi
                menu_view=1; ((i+=3))
                if [[ ${body:i+1:1} == '{' ]]; then rest=${body:i+2}; rest=${rest%%\}*}; ((i+=${#rest}+2)); fi
                continue
                ;;
            f|p) values=("$menu_name");; d) values=("$cwd");;
            F|P) values=("$other_name");; D) values=("$other_dir");;
            s) values=("${menu_tagged[@]}"); (( ${#values[@]} )) || values=("$menu_name");;
            S) values=("${other_tagged[@]}"); (( ${#values[@]} )) || values=("$other_name");;
            t|u) values=("${menu_tagged[@]}"); [[ $char == u ]] && menu_unmark=1;;
            T|U) values=("${other_tagged[@]}"); [[ $char == U ]] && menu_other_unmark=1;;
            *) notice="Unsupported MC macro: %$char"; return 1;;
        esac
        value=''
        for path in "${values[@]}"; do
            if (( quote )); then printf -v rest '%q' "$path"; else rest=$path; fi
            value+="${value:+ }$rest"
        done
        menu_script+=$value
    done
}

user_menu() {
    local menu_source=${XDG_CONFIG_HOME:-$HOME/.config}/mc/menu
    [[ -r $menu_source ]] || menu_source=/etc/mc/mc.menu
    if [[ ! -r $menu_source ]]; then notice='MC menu not found.'; return; fi
    local menu_file=${entries[cursor]} menu_name=${entries[cursor]##*/} path key i choice=0 offset=0 capacity focus=0
    local other_file=$menu_file other_name=$menu_name other_dir=$cwd menu_shell_patterns=1 menu_default=-1
    local menu_script menu_view menu_unmark menu_other_unmark clicked=-1 click_time=0 now
    local -a menu_keys=() menu_labels=() menu_scripts=() menu_tagged=() other_tagged=() pager=()
    [[ $menu_file == '..' ]] && menu_file="$cwd/.."
    for path in "${entries[@]}"; do
        [[ -v marks["$path"] ]] && menu_tagged+=("${path##*/}")
    done
    if (( dual_pane )); then menu_other_panel; else other_file=$menu_file; fi
    load_user_menu
    if (( !${#menu_keys[@]} )); then notice='No MC commands available for the selection.'; return; fi
    (( menu_default >= 0 )) && choice=$menu_default
    needs_full=1
    while :; do
        modal_frame 'Commands menu (MC)' 78 24
        capacity=$((modal_h-6))
        (( choice < offset )) && offset=$choice
        (( choice >= offset+capacity )) && offset=$((choice-capacity+1))
        modal_line 1 "$menu_source" "$CLR_DIALOG_TITLE"
        for ((i=0; i<capacity && i+offset<${#menu_keys[@]}; i++)); do
            local style=$CLR_DIALOG
            (( i+offset == choice && focus == 0 )) && style=$CLR_DIALOG_FOCUS
            modal_line "$((i+2))" " ${menu_keys[i+offset]}  ${menu_labels[i+offset]}" "$style"
        done
        modal_rule "$((modal_h-4))"
        modal_buttons "$((focus-1))" 'Run'
        modal_line "$((modal_h-2))" 'Arrows/Pg: select  Enter: run  Esc: cancel'
        if ! input_key; then needs_full=1; return; fi
        key=$KEY
        case $key in
            UP) focus=0; (( choice>0 )) && ((choice-=1));;
            DOWN) focus=0; (( choice+1<${#menu_keys[@]} )) && ((choice+=1));;
            HOME) focus=0; choice=0;; END) focus=0; choice=$((${#menu_keys[@]}-1));;
            PAGEUP) focus=0; ((choice-=capacity)); ((choice<0)) && choice=0;;
            PAGEDOWN) focus=0; ((choice+=capacity)); ((choice>=${#menu_keys[@]})) && choice=$((${#menu_keys[@]}-1));;
            TAB) focus=$(((focus+1)%3));;
            ESC|F10) modal_cancel 'Commands menu cancelled.'; return;;
            ENTER) if (( focus == 2 )); then needs_full=1; return; fi; break;;
            MOUSE)
                local x=$((MOUSE_X-modal_x)) y=$((MOUSE_Y-modal_y))
                if (( MOUSE_BTN == 64 )); then focus=0; ((choice>0)) && ((choice-=1))
                elif (( MOUSE_BTN == 65 )); then focus=0; ((choice+1<${#menu_keys[@]})) && ((choice+=1))
                elif [[ $MOUSE_ACTION == M && $MOUSE_BTN == 0 ]] && (( x>0 && x<modal_w-1 )); then
                    if (( y>=2 && y<2+capacity && y-2+offset<${#menu_keys[@]} )); then
                        choice=$((y-2+offset)); focus=0; now=$(now_millis)
                        if (( clicked == choice && now-click_time<450 )); then break; fi
                        clicked=$choice; click_time=$now
                    elif modal_button_at; then
                        if [[ $REPLY == apply ]]; then break; fi
                        needs_full=1; return
                    fi
                fi
                ;;
            *)
                local found=0
                for i in "${!menu_keys[@]}"; do
                    if [[ $key == "${menu_keys[i]}" ]]; then choice=$i; found=1; break; fi
                done
                (( found )) && break
                ;;
        esac
    done
    needs_full=1
    if ! expand_user_command "${menu_scripts[choice]}"; then return; fi
    (( menu_unmark )) && marks=()
    if (( menu_other_unmark )); then
        for key in "${!pane_marks[@]}"; do [[ $key == "$((1-active_pane)):"* ]] && unset 'pane_marks[$key]'; done
    fi
    if (( menu_view )); then
        read -r -a pager <<< "${PAGER:-less}"
        if command -v "${pager[0]}" >/dev/null 2>&1; then
            run_program 0 bash -c 'set -o pipefail; bash -c "$1" | "${@:2}"' fm-menu "$menu_script" "${pager[@]}"
        else run_program 1 bash -c "$menu_script"; fi
    else run_program 1 bash -c "$menu_script"; fi
    local -a selected_paths=("${!marks[@]}")
    reload
    for path in "${selected_paths[@]}"; do [[ -e $path || -L $path ]] && marks["$path"]=1; done
}

rename_dialog() {
    local original=$1 name=$1 pos=0 selected=1 focus=0 offset=0 width key x y style
    while :; do
        modal_frame 'Rename' 66 12
        width=$((modal_w-8))
        (( pos < offset )) && offset=$pos
        (( pos >= offset+width )) && offset=$((pos-width+1))
        modal_line 1 'Current name:' "$CLR_DIALOG_TITLE"
        modal_line 2 "$original"
        modal_line 4 'New name:' "$CLR_DIALOG_TITLE"
        style=$CLR_DIALOG
        (( focus == 0 )) && style=$CLR_CURSOR
        modal_text 5 4 "$width" "${name:offset:width}" "$style"
        if (( selected && focus == 0 )); then
            modal_text 5 4 "$(( ${#name}<width ? ${#name} : width ))" "${name:0:width}" "$CLR_DIALOG_FOCUS"
        fi
        modal_line 7 'Enter: rename  Tab: buttons  Esc: cancel'
        modal_rule 8
        modal_buttons "$((focus-1))" 'Rename'
        if (( focus == 0 )); then
            printf '\033[%d;%dH\033[?25h' "$((modal_y+5))" "$((modal_x+4+pos-offset))" >&9
        fi
        if ! input_key; then
            printf '\033[?25l' >&9
            modal_cancel 'Rename cancelled.'; return 1
        fi
        printf '\033[?25l' >&9
        key=$KEY
        case $key in
            TAB) focus=$(((focus+1)%3));;
            ESC|F10) modal_cancel 'Rename cancelled.'; return 1;;
            ENTER)
                if (( focus == 2 )); then modal_cancel 'Rename cancelled.'; return 1; fi
                REPLY=$name; needs_full=1; return 0
                ;;
            LEFT)
                if (( focus == 0 )); then
                    if (( selected )); then pos=0; elif (( pos>0 )); then ((pos-=1)); fi
                    selected=0
                fi
                ;;
            RIGHT)
                if (( focus == 0 )); then
                    if (( selected )); then pos=${#name}; elif (( pos<${#name} )); then ((pos+=1)); fi
                    selected=0
                fi
                ;;
            HOME) pos=0; selected=0;;
            END) pos=${#name}; selected=0;;
            BACK|DELETE)
                if (( focus == 0 )); then
                    if (( selected )); then name=''; pos=0
                    elif [[ $key == BACK ]] && (( pos>0 )); then
                        name="${name:0:pos-1}${name:pos}"; ((pos-=1))
                    elif [[ $key == DELETE ]]; then name="${name:0:pos}${name:pos+1}"
                    fi
                    selected=0
                fi
                ;;
            $'\025') if (( focus == 0 )); then name=''; pos=0; selected=0; fi;;
            MOUSE)
                x=$((MOUSE_X-modal_x)); y=$((MOUSE_Y-modal_y))
                if [[ $MOUSE_ACTION == M && $MOUSE_BTN == 0 ]]; then
                    if (( y == 5 && x>=4 && x<modal_w-4 )); then
                        focus=0; selected=0; pos=$((offset+x-4))
                        (( pos>${#name} )) && pos=${#name}
                    elif modal_button_at; then
                        if [[ $REPLY == apply ]]; then
                            focus=1; PENDING_CHAR=$'\r'
                        else
                            modal_cancel 'Rename cancelled.'; return 1
                        fi
                    fi
                fi
                ;;
            *)
                [[ $key == F3 ]] && key=' '
                if (( focus == 0 )) && [[ ${#key} == 1 && $key == [[:print:]] ]]; then
                    if (( selected )); then name=''; pos=0; offset=0; selected=0; fi
                    name="${name:0:pos}$key${name:pos}"; ((pos+=1))
                elif [[ $key == ' ' ]] && (( focus>0 )); then PENDING_CHAR=$'\r'
                fi
                ;;
        esac
    done
}

attributes_dialog() {
    local row col i mask check label cell_x style column idx count start name
    local list_top=9 bottom list_x
    modal_frame 'Permissions and owner' 78 24
    bottom=$((modal_h-6))
    # On short terminals, Tab alternates the grid and lists in the same window.
    if (( modal_h < 20 )); then list_top=3; fi
    modal_line 1 "File: ${targets[0]##*/} (${#targets[@]} selected)"
    modal_line 2 "Mode: ${digits:-$new_mode}  ${owner:-${current%:*}}:${group:-${current#*:}}" "$CLR_DIALOG_TITLE"
    if (( modal_h >= 20 || focus == 0 || focus >= 3 )); then
        modal_line 3 '           Read   Write  Exec'
        for ((row=0; row<3; row++)); do
            case $row in 0) label='User';; 1) label='Group';; 2) label='Others';; esac
            modal_line "$((4+row))" "$label"
            for ((col=0; col<3; col++)); do
                i=$((row*3+col)); mask=$((1 << (8-i)))
                check=' '; (( perms & mask )) && check='x'
                cell_x=$((13+col*7)); style=$CLR_DIALOG
                (( focus == 0 && i == cell )) && style=$CLR_DIALOG_FOCUS
                modal_text "$((4+row))" "$cell_x" 3 "[$check]" "$style"
            done
        done
        modal_line 7 "Octal: ${digits:-$new_mode} (type 755 or 0644)" "$CLR_DIALOG_TITLE"
    fi
    list_count=$((bottom-list_top-1)); list_w=$(((modal_w-6)/2))
    list_y=$((list_top+1))
    if (( modal_h >= 20 || focus == 1 || focus == 2 )); then
        for ((column=0; column<2; column++)); do
            list_x=$((2+column*(list_w+1)))
            if (( column == 0 )); then
                modal_box "$list_x" "$list_w" 'Users' "$bottom" "$list_top"
                idx=$user_index; count=${#user_names[@]}
            else
                modal_box "$list_x" "$list_w" 'Groups' "$bottom" "$list_top"
                idx=$group_index; count=${#group_names[@]}
            fi
            start=$((idx-list_count/2))
            (( start > count-list_count )) && start=$((count-list_count))
            (( start < 0 )) && start=0
            if (( column == 0 )); then user_start=$start; else group_start=$start; fi
            for ((i=0; i<list_count && start+i<count; i++)); do
                if (( column == 0 )); then name=${user_names[start+i]}; else name=${group_names[start+i]}; fi
                style=$CLR_DIALOG
                (( start+i == idx && focus == column+1 )) && style=$CLR_DIALOG_FOCUS
                modal_text "$((list_y+i))" "$((list_x+1))" "$((list_w-2))" " $name" "$style"
            done
            (( start > 0 )) && modal_text "$list_y" "$((list_x+list_w-1))" 1 '^'
            (( start+list_count < count )) && modal_text "$((bottom-1))" "$((list_x+list_w-1))" 1 'v'
        done
    fi
    modal_line "$((modal_h-5))" 'Tab: permissions / user / group / buttons'
    # Leave space for the grid on terminals with only 12 rows.
    (( modal_h >= 14 || focus == 1 || focus == 2 )) && modal_rule "$((modal_h-4))"
    modal_buttons "$((focus-3))"
}

attributes_items() {
    local path current owner='' group='' focus=0 cell=0 key spec='' mode='' digits='' new_mode
    local base_mode perms i failed=0 chmod_changed=0 chown_changed=0
    local chmod_dirty=0 file_error='' summary=''
    local user_index=0 group_index=0 user_start=0 group_start=0 list_count list_w list_y
    local -a user_names=() group_names=()
    collect
    if (( ${#targets[@]} == 0 )); then notice='No items selected.'; return; fi
    base_mode=$(stat -c %a -- "${targets[0]}" 2>/dev/null) || return
    current=$(stat -c '%U:%G' -- "${targets[0]}" 2>/dev/null) || return
    perms=$((8#$base_mode))
    mapfile -t user_names < <(getent passwd | cut -d: -f1 | LC_ALL=C sort -u)
    mapfile -t group_names < <(getent group | cut -d: -f1 | LC_ALL=C sort -u)
    (( ${#user_names[@]} )) || user_names=("${current%:*}")
    (( ${#group_names[@]} )) || group_names=("${current#*:}")
    for i in "${!user_names[@]}"; do [[ ${user_names[i]} == "${current%:*}" ]] && user_index=$i; done
    for i in "${!group_names[@]}"; do [[ ${group_names[i]} == "${current#*:}" ]] && group_index=$i; done
    needs_full=1
    while :; do
        printf -v new_mode '%04o' "$perms"
        attributes_dialog
        if ! input_key; then modal_cancel 'Attribute changes cancelled.'; return; fi
        key=$KEY
        case $key in
            TAB) focus=$(((focus+1)%5));;
            UP|DOWN|LEFT|RIGHT|PAGEUP|PAGEDOWN|HOME|END)
                if (( focus == 0 )); then
                    case $key in
                        UP) cell=$(((cell+6)%9));;
                        DOWN) cell=$(((cell+3)%9));;
                        LEFT) cell=$(((cell+8)%9));;
                        RIGHT) cell=$(((cell+1)%9));;
                    esac
                elif [[ $key == LEFT || $key == RIGHT ]]; then
                    if [[ $key == LEFT ]]; then focus=$(((focus+4)%5)); else focus=$(((focus+1)%5)); fi
                elif (( focus == 1 || focus == 2 )); then
                    local index count step=1
                    if (( focus == 1 )); then index=$user_index; count=${#user_names[@]}
                    else index=$group_index; count=${#group_names[@]}; fi
                    case $key in PAGEUP|PAGEDOWN) step=$list_count;; esac
                    case $key in
                        UP|PAGEUP) ((index-=step));;
                        DOWN|PAGEDOWN) ((index+=step));;
                        HOME) index=0;;
                        END) index=$((count-1));;
                    esac
                    (( index < 0 )) && index=0
                    (( index >= count )) && index=$((count-1))
                    if (( focus == 1 )); then user_index=$index; owner=${user_names[index]}
                    else group_index=$index; group=${group_names[index]}; fi
                fi
                ;;
            F3)
                if (( focus == 0 )); then
                    perms=$((perms ^ (1 << (8-cell)))); digits=''; chmod_dirty=1
                elif (( focus >= 3 )); then PENDING_CHAR=$'\r'; fi
                ;;
            BACK)
                case $focus in 0) digits=${digits%?};; 1) owner=${owner%?};; 2) group=${group%?};; esac
                ;;
            ':') focus=2;;
            ENTER)
                if (( focus == 4 )); then modal_cancel 'Attribute changes cancelled.'; return; fi
                if [[ -n $digits && ! $digits =~ ^[0-7]{3,4}$ ]]; then
                    notice='Invalid octal mode: use 3 or 4 digits from 0 to 7.'; needs_full=1; return
                fi
                if (( chmod_dirty )) || [[ -n $digits ]]; then mode=${digits:-$new_mode}; fi
                spec=$owner; [[ -n $group ]] && spec="$owner:$group"
                break
                ;;
            ESC|F10)
                modal_cancel 'Attribute changes cancelled.'; return
                ;;
            MOUSE)
                if [[ $MOUSE_ACTION == M && $MOUSE_BTN == 0 ]]; then
                    local x=$((MOUSE_X-modal_x)) y=$((MOUSE_Y-modal_y)) index
                    if (( y>=4 && y<=6 && x>=13 && x<30 && (x-13)%7<3 && (modal_h>=20 || focus==0 || focus>=3) )); then
                        cell=$(((y-4)*3+(x-13)/7)); focus=0
                        perms=$((perms ^ (1 << (8-cell)))); digits=''; chmod_dirty=1
                    elif (( y>=list_y && y<modal_h-6 && (modal_h>=20 || focus==1 || focus==2) )); then
                        if (( x>2 && x<2+list_w-1 )); then
                            index=$((user_start+y-list_y))
                            if (( index<${#user_names[@]} )); then focus=1; user_index=$index; owner=${user_names[index]}; fi
                        elif (( x>3+list_w && x<2+2*list_w )); then
                            index=$((group_start+y-list_y))
                            if (( index<${#group_names[@]} )); then focus=2; group_index=$index; group=${group_names[index]}; fi
                        fi
                    elif modal_button_at; then
                        if [[ $REPLY == apply ]]; then
                            focus=3; PENDING_CHAR=$'\r'
                        else
                            modal_cancel 'Attribute changes cancelled.'; return
                        fi
                    fi
                fi
                ;;
            *)
                if [[ $key == [[:print:]] && ${#key} == 1 && $key != [[:space:]] ]]; then
                    case $focus in
                        0) if [[ $key == [0-9] ]] && (( ${#digits}<4 )); then digits+=$key; fi;;
                        1) (( ${#owner}<128 )) && owner+=$key;;
                        2) (( ${#group}<128 )) && group+=$key;;
                    esac
                fi
                ;;
        esac
    done
    needs_full=1
    # chown may clear setuid/setgid: apply chmod after ownership.
    for path in "${targets[@]}"; do
        if [[ -n $spec ]]; then
            if file_command chown -- "$spec" "$path"; then ((chown_changed+=1)); else ((failed+=1)); fi
        fi
        if [[ -n $mode ]]; then
            if [[ -L $path ]]; then ((failed+=1))
            elif file_command chmod -- "$mode" "$path"; then ((chmod_changed+=1))
            else ((failed+=1)); fi
        fi
    done
    [[ -n $spec ]] && summary="chown $spec: changed $chown_changed. "
    [[ -n $mode ]] && summary+="chmod $mode: changed $chmod_changed. "
    reload
    notice="${file_error:+$file_error }${summary:-No changes. }Failed: $failed."
}

create_symlink() {
    if [[ $cwd == "$connections_root" ]]; then
        if (( !dual_pane )); then notice='Open two panes to add a bookmark.'; return; fi
        if [[ ${pane_dirs[1-active_pane]} == "$connections_root" ]]; then
            notice='Select a directory in the pane opposite the connections root.'; return
        fi
    fi
    if (( dual_pane )) && [[ $cwd == "$connections_root" || ${pane_dirs[1-active_pane]} == "$connections_root" ]]; then
        add_shortcut
        return
    fi
    local path=${entries[cursor]} name file_error=''
    if [[ $path == '..' ]]; then
        notice='Select a file or directory for the link.'
        return
    fi
    name="${path##*/}.lnk"
    if [[ -e $cwd/$name || -L $cwd/$name ]]; then
        notice="A file or link with this name already exists."
        return
    fi
    # Absolute target: the link remains valid after moving
    # the link to another directory (as long as the target exists).
    if file_command ln -s -- "$path" "$cwd/$name"; then
        reload
        notice="Created link $name -> $path"
    else
        notice="Link creation failed: $file_error"
    fi
}

# GVfs connections expose a FUSE path to normal fm operations.
# REPLY receives the mount root to distinguish protocols and transfers within a mount.
is_archive_path() {
    local root
    for root in "${!archive_sources[@]}"; do
        if [[ $1 == "$root" || $1 == "$root/"* ]]; then REPLY=$root; return 0; fi
    done
    return 1
}

is_archive_file() {
    case ${1,,} in
        *.zip|*.tar|*.tar.gz|*.tgz|*.tar.bz2|*.tbz|*.tbz2|*.tar.xz|*.txz|*.tar.zst|*.tzst|*.7z|*.rar) return 0;;
        *) return 1;;
    esac
}

open_archive() {
    local path=$1 root result status message cache='' mount_path=$1 file_error=''
    for root in "${!archive_sources[@]}"; do
        if [[ ${archive_sources[$root]} == "$path" && -d $root ]]; then
            change_directory "$root"; return
        fi
    done
    # The archive backend cannot directly read paths on other GVfs mounts.
    if is_archive_path "$path" || is_remote_path "$path"; then
        cache=$(mktemp -d "${TMPDIR:-/tmp}/fm-archive.XXXXXX") || return
        archive_pending_cache=$cache
        mount_path="$cache/${path##*/}"
        if ! file_command cp -- "$path" "$mount_path"; then
            rm -rf -- "$cache"
            notice="Cannot read archive file: $file_error"; return
        fi
    fi
    result=$(mktemp) || { [[ -n $cache ]] && rm -rf -- "$cache"; return; }
    local run_program_label="Opening archive ${path##*/}"
    trap ':' INT
    run_program 0 remote_mount archive "$mount_path" -1 "$result"
    status=$?
    trap 'exit 130' INT
    IFS= read -r root < "$result" || :
    rm -f -- "$result"
    if (( status != 0 )); then
        [[ -n $cache ]] && rm -rf -- "$cache"
        safe "${root:-cancelled}"; message=$REPLY
        notice="Cannot open archive: $message"; return
    fi
    archive_sources["$root"]=$path
    [[ -n $cache ]] && archive_cache["$root"]=$cache
    archive_pending_cache=''
    change_directory "$root"
}

is_remote_path() {
    local root
    for root in "${!remote_labels[@]}"; do
        if [[ $1 == "$root" || $1 == "$root/"* ]]; then REPLY=$root; return 0; fi
    done
    return 1
}

display_path() {
    local root
    REPLY=$1
    if [[ $1 == "$connections_root" ]]; then REPLY='Connections'; return; fi
    for root in "${!archive_sources[@]}"; do
        if [[ $1 == "$root" || $1 == "$root/"* ]]; then
            local suffix=${1#"$root"} source=${archive_sources[$root]}
            display_path "$source"
            REPLY+="!${suffix:-/}"
            return
        fi
    done
    for root in "${!remote_labels[@]}"; do
        if [[ $1 == "$root" || $1 == "$root/"* ]]; then
            REPLY="${remote_labels[$root]}:${1#"$root"}"
            [[ $1 == "$root" ]] && REPLY+='/'
            return
        fi
    done
}

connection_dialog() {
    local protocol=$1 focus=0 replace_address=1 key value style width
    remote_password=''
    while :; do
        modal_frame "${protocol^^} connection" 70 14
        modal_line 1 'Address (user@host or user@host:port):' "$CLR_DIALOG_TITLE"
        width=$((modal_w-8))
        style=$CLR_DIALOG; (( focus == 0 )) && style=$CLR_CURSOR
        value=$remote_address
        (( ${#value}>width )) && value=${value: -width}
        modal_text 2 4 "$width" "$value" "$style"
        modal_line 4 'Password:' "$CLR_DIALOG_TITLE"
        printf -v value '%*s' "${#remote_password}" ''; value=${value// /*}
        style=$CLR_DIALOG; (( focus == 1 )) && style=$CLR_CURSOR
        (( ${#value}>width )) && value=${value: -width}
        modal_text 5 4 "$width" "$value" "$style"
        if [[ $protocol == ssh ]]; then
            modal_line 7 'Empty: use keyring or SSH keys.'
        else
            modal_line 7 'Empty: use the password saved in the keyring.'
        fi
        (( modal_h >= 14 )) && modal_line 8 'Password saved in the system keyring.'
        (( modal_h >= 14 )) && modal_line 9 'Tab: switch field  Enter: connect  Esc: cancel'
        modal_rule "$((modal_h-4))"
        modal_buttons "$((focus-2))" 'Connect'
        if ! input_key; then modal_cancel 'Connection cancelled.'; return 1; fi
        key=$KEY
        case $key in
            TAB) focus=$(((focus+1)%4));;
            UP|DOWN) focus=$((1-(focus%2)));;
            ESC|F10) modal_cancel 'Connection cancelled.'; return 1;;
            ENTER)
                if (( focus == 3 )); then modal_cancel 'Connection cancelled.'; return 1; fi
                if (( focus == 0 )); then focus=1; continue; fi
                if [[ ! $remote_address =~ ^[^:@/[:space:]]+@[^/@[:space:]]+$ ]]; then
                    modal_cancel 'Invalid address: use user@host[:port].'; return 1
                fi
                needs_full=1; return 0
                ;;
            BACK)
                if (( focus == 0 )); then
                    if (( replace_address )); then remote_address=''; else remote_address=${remote_address%?}; fi
                    replace_address=0
                elif (( focus == 1 )); then remote_password=${remote_password%?}; fi
                ;;
            HOME|END|LEFT|RIGHT) replace_address=0;;
            $'\025')
                if (( focus == 0 )); then remote_address=''; replace_address=0
                elif (( focus == 1 )); then remote_password=''; fi
                ;;
            MOUSE)
                if [[ $MOUSE_ACTION == M && $MOUSE_BTN == 0 ]]; then
                    local x=$((MOUSE_X-modal_x)) y=$((MOUSE_Y-modal_y))
                    if (( x>=4 && x<modal_w-4 && y==2 )); then focus=0
                    elif (( x>=4 && x<modal_w-4 && y==5 )); then focus=1
                    elif modal_button_at; then
                        if [[ $REPLY == apply ]]; then focus=2; PENDING_CHAR=$'\r'
                        else modal_cancel 'Connection cancelled.'; return 1; fi
                    fi
                fi
                ;;
            *)
                [[ $key == F3 ]] && key=' '
                if [[ ${#key} == 1 && $key == [[:print:]] ]]; then
                    if (( focus == 0 && ${#remote_address}<200 )); then
                        if (( replace_address )); then remote_address=''; replace_address=0; fi
                        remote_address+=$key
                    elif (( focus == 1 && ${#remote_password}<200 )); then remote_password+=$key; fi
                fi
                ;;
        esac
    done
}

remote_mount() {
    /usr/bin/python3 - "$@" <<'PY'
import os
import pathlib
import sys
import time
from urllib.parse import quote, urlsplit

protocol, address, password_fd, result_file = sys.argv[1:]
password = "" if protocol == "archive" else os.fdopen(int(password_fd)).read()

def fail(message):
    pathlib.Path(result_file).write_text(message + "\n")
    print(message, file=sys.stderr)

try:
    from gi.repository import Gio, GLib
except ImportError:
    fail("GVfs support unavailable: python3-gi, gvfs-backends and gvfs-fuse are required.")
    sys.exit(1)

try:
    if protocol == "archive":
        uri = pathlib.Path(address).as_uri()
        location = Gio.File.new_for_uri("archive://" + quote(uri, safe="") + "/")
    else:
        user, host = address.rsplit("@", 1)
        if not user or any(c in user for c in ":/@?#") or any(c.isspace() for c in address):
            raise ValueError()
        scheme = "sftp" if protocol == "ssh" else "ftp"
        parsed = urlsplit(f"{scheme}://{quote(user, safe='')}@{host}/")
        if not parsed.hostname or parsed.hostname.startswith("-") or parsed.path != "/" or parsed.query or parsed.fragment:
            raise ValueError()
        if parsed.port is not None and not 1 <= parsed.port <= 65535:
            raise ValueError()
        location = Gio.File.new_for_uri(parsed.geturl())
except (ValueError, GLib.Error):
    fail("Invalid address: use user@host[:port].")
    sys.exit(1)

operation = Gio.MountOperation()
operation.set_password_save(Gio.PasswordSave.PERMANENTLY)
loop = GLib.MainLoop()
cancellable = Gio.Cancellable()
status = 1
attempted = False
auth_error = ""

def ask_password(op, message, default_user, default_domain, flags):
    global attempted, auth_error
    if protocol == "archive":
        auth_error = "Archive is protected or unreadable."
        op.reply(Gio.MountOperationResult.ABORTED)
        return
    if attempted or (protocol == "ssh" and not password):
        auth_error = "Authentication failed." if attempted else "SSH key unavailable: enter the password."
        op.reply(Gio.MountOperationResult.ABORTED)
        return
    attempted = True
    op.set_anonymous(False)
    op.set_username(user)
    op.set_domain(default_domain or "")
    op.set_password(password)
    op.set_password_save(Gio.PasswordSave.PERMANENTLY)
    op.reply(Gio.MountOperationResult.HANDLED)

def ask_question(op, message, choices):
    print(message)
    for index, choice in enumerate(choices, 1):
        print(f"{index}. {choice}")
    print("Choice (empty cancels): ", end="", flush=True)
    try:
        with open("/dev/tty") as tty:
            answer = int(tty.readline().strip()) - 1
        if not 0 <= answer < len(choices):
            raise ValueError()
        op.set_choice(answer)
        op.reply(Gio.MountOperationResult.HANDLED)
    except (ValueError, OSError, KeyboardInterrupt):
        op.reply(Gio.MountOperationResult.ABORTED)

def mounted(file, result):
    global status
    try:
        try:
            file.mount_enclosing_volume_finish(result)
        except GLib.Error as error:
            if not error.matches(Gio.io_error_quark(), Gio.IOErrorEnum.ALREADY_MOUNTED):
                raise
        if protocol == "archive":
            # The archive backend publishes its root with the inner URI quoted again.
            file = Gio.File.new_for_uri("archive://" + quote(quote(uri, safe=""), safe="") + "/")
        # Keyring authentication may finish before the FUSE export is ready.
        for _ in range(40):
            root = file.find_enclosing_mount(None).get_root().get_path()
            if root and os.path.isdir(root):
                break
            time.sleep(0.05)
        if not root or not os.path.isdir(root):
            raise RuntimeError("Remote path unavailable: check gvfs-fuse.")
        pathlib.Path(result_file).write_text(root + "\n")
        status = 0
    except (GLib.Error, RuntimeError, OSError) as error:
        fail(auth_error or getattr(error, "message", str(error)))
    loop.quit()

def timed_out():
    cancellable.cancel()
    fail("Connection timed out.")
    loop.quit()
    return False

operation.connect("ask-password", ask_password)
operation.connect("ask-question", ask_question)
GLib.timeout_add_seconds(30, timed_out)
location.mount_enclosing_volume(Gio.MountMountFlags.NONE, operation, cancellable, mounted)
try:
    loop.run()
except KeyboardInterrupt:
    fail("Connection cancelled.")
sys.exit(status)
PY
}

add_shortcut() {
    local path name destination error root protocol address relative
    if [[ $cwd == "$connections_root" ]]; then
        path=$(
            local cwd cursor scroll filter content_filter show_hidden needs_full
            local -a entries=()
            local -A marks=()
            load_pane "$((1-active_pane))"
            printf '%s' "${entries[cursor]}"
        )
    else path=${entries[cursor]}; fi
    if [[ $path == '..' || ! -d $path ]]; then
        notice='Select a directory in the pane opposite the connections root.'; return
    fi
    name="${path##*/}.lnk"
    if ! path=$(cd -P -- "$path" 2>/dev/null && pwd -P); then
        notice='Directory unavailable.'; return
    fi
    if is_archive_path "$path"; then
        notice='Choose a directory outside archives for bookmarks.'; return
    fi
    destination=$path
    if is_remote_path "$path"; then
        root=$REPLY
        protocol=${remote_protocols[$root]}; address=${remote_addresses[$root]}
        relative=${path#"$root"}; relative=${relative:-/}
        destination=$(/usr/bin/python3 - "$protocol" "$address" "$relative" <<'PYURI'
import sys
from urllib.parse import quote
protocol, address, path = sys.argv[1:]
user, host = address.rsplit('@', 1)
scheme = 'sftp' if protocol == 'ssh' else 'ftp'
print(f'{scheme}://{quote(user, safe="")}@{host}{quote(path, safe="/")}')
PYURI
        ) || return
    fi
    if [[ -e $shortcuts_dir/$name || -L $shortcuts_dir/$name ]]; then
        notice="An item with that name already exists."; return
    fi
    if error=$({ mkdir -p -- "$shortcuts_dir" && ln -s -- "$destination" "$shortcuts_dir/$name"; } 2>&1); then
        reload
        notice="Bookmark added: $name"
    else
        safe "$error"; notice="Creation failed: $REPLY"
    fi
}

open_shortcut() {
    local target root part
    local -a location=()
    target=$(readlink -- "$1") || return
    if [[ $target == sftp://* || $target == ftp://* ]]; then
        while IFS= read -r -d '' part; do location+=("$part"); done < <(/usr/bin/python3 - "$target" <<'PYURI'
import sys
import posixpath
from urllib.parse import unquote, urlsplit
try:
    uri = urlsplit(sys.argv[1])
    if uri.scheme not in ('sftp', 'ftp') or not uri.username or uri.password is not None or not uri.hostname:
        raise ValueError()
    uri.port
    address = unquote(uri.username) + '@' + uri.netloc.rsplit('@', 1)[1]
    path = posixpath.normpath('/' + unquote(uri.path).lstrip('/'))
    protocol = 'ssh' if uri.scheme == 'sftp' else 'ftp'
    sys.stdout.write('\0'.join((protocol, address, path)) + '\0')
except ValueError:
    pass
PYURI
        )
        if (( ${#location[@]} != 3 )); then notice='Invalid remote bookmark.'; return; fi
        for root in "${!remote_labels[@]}"; do
            if [[ ${remote_protocols[$root]} == "${location[0]}" && ${remote_addresses[$root]} == "${location[1]}" && -d $root ]]; then
                change_directory "$root/${location[2]#/}"
                return
            fi
        done
        connect_remote "${location[0]}" "${location[1]}" "${location[2]}"
    elif [[ -d $1 ]]; then change_directory "$1"
    else notice='Shortcut unavailable: check the destination directory.'; fi
}

# Three lines per entry: protocol, address, name. The name is never a path.
save_connection() {
    local protocol=$1 address=$2 name=${3:-} id file saved old_protocol='' old_address=''
    id=$(printf '%s\0%s' "$protocol" "$address" | sha256sum); id=${id%% *}
    file="$connections_dir/$id"
    if [[ -z $name && -r $file ]]; then
        { IFS= read -r old_protocol; IFS= read -r old_address; IFS= read -r name; } < "$file" || name=''
        [[ $old_protocol == "$protocol" && $old_address == "$address" ]] || name=''
    fi
    [[ -n $name ]] || name="${protocol^^} $address"
    saved=$(umask 077; mkdir -p -- "$connections_dir" && mktemp "$connections_dir/.saved.XXXXXX") || return 1
    if printf '%s\n%s\n%s\n' "$protocol" "$address" "$name" > "$saved" && mv -T -- "$saved" "$file"; then
        return 0
    fi
    rm -f -- "$saved"
    return 1
}

load_saved_connections() {
    local file id protocol address name
    connection_names=(); connection_protocols=(); connection_addresses=()
    # Import the last addresses from the previous version once.
    if [[ ! -d $connections_dir ]]; then
        for protocol in ssh ftp; do
            file="${connections_dir%/*}/last-$protocol"
            if [[ -r $file ]] && IFS= read -r address < "$file" &&
               [[ $address =~ ^[^:@/[:space:]]+@[^/@[:space:]]+$ ]]; then
                save_connection "$protocol" "$address" || :
            fi
        done
    fi
    for file in "$connections_dir"/*; do
        id=${file##*/}
        [[ $id =~ ^[0-9a-f]{64}$ && -f $file ]] || continue
        { IFS= read -r protocol && IFS= read -r address && IFS= read -r name; } < "$file" || continue
        [[ $protocol == ssh || $protocol == ftp ]] || continue
        [[ -n $name && $address =~ ^[^:@/[:space:]]+@[^/@[:space:]]+$ ]] || continue
        connection_names["$id"]=$name
        connection_protocols["$id"]=$protocol
        connection_addresses["$id"]=$address
        entries+=("profile:$id")
    done
}

rename_saved_connection() {
    local entry=${entries[cursor]} id name protocol address
    id=${entry#profile:}
    if [[ $entry != profile:* || ! -v connection_names["$id"] ]]; then
        notice='Select a saved connection.'; return
    fi
    protocol=${connection_protocols[$id]}; address=${connection_addresses[$id]}
    if ! rename_dialog "${connection_names[$id]}"; then return; fi
    name=$REPLY
    if [[ -z $name ]]; then notice='Invalid name.'; return; fi
    if save_connection "$protocol" "$address" "$name"; then
        reload
        notice="Connection renamed: $name"
    else notice='Cannot save the connection name.'; fi
}

delete_saved_connection() {
    local entry=${entries[cursor]} id
    if [[ $entry == "$shortcuts_dir/"* && -L $entry ]]; then
        if ! ask 'Delete only the shortcut? y/N: '; then return; fi
        if [[ $REPLY != [yY] ]]; then notice='Deletion cancelled.'; return; fi
        if rm -- "$entry" 2>/dev/null; then reload; notice='Shortcut deleted.'
        else notice='Cannot delete the shortcut.'; fi
        return
    fi
    id=${entry#profile:}
    if [[ $entry != profile:* || ! -v connection_names["$id"] ]]; then
        notice='Select a saved connection.'; return
    fi
    if ! ask 'Delete connection? y/N: '; then return; fi
    if [[ $REPLY != [yY] ]]; then notice='Deletion cancelled.'; return; fi
    if rm -f -- "$connections_dir/$id"; then
        reload
        notice='Connection deleted.'
    else notice='Cannot delete the saved connection.'; fi
}

connect_remote() {
    local protocol=$1 remote_address=${2:-} bookmark_path=${3:-/} remote_password='' password_fd result mount_path status
    local profile_dir=${XDG_CONFIG_HOME:-$HOME/.config}/fm
    if [[ -z $remote_address && -r $profile_dir/last-$protocol ]]; then
        IFS= read -r remote_address < "$profile_dir/last-$protocol"
    fi
    if ! connection_dialog "$protocol"; then return; fi
    result=$(mktemp) || return
    local run_program_label="${protocol^^} connection"
    exec {password_fd}< <(printf '%s' "$remote_password")
    trap ':' INT
    run_program 0 remote_mount "$protocol" "$remote_address" "$password_fd" "$result"
    status=$?
    trap 'exit 130' INT
    exec {password_fd}<&-
    unset remote_password
    IFS= read -r mount_path < "$result" || :
    rm -f -- "$result"
    if (( status != 0 )); then
        notice="Connection failed: ${mount_path:-cancelled}."
        return
    fi
    remote_labels["$mount_path"]="${protocol^^} $remote_address"
    remote_protocols["$mount_path"]=$protocol
    remote_addresses["$mount_path"]=$remote_address
    if ! change_directory "$mount_path"; then return; fi
    if [[ $bookmark_path != / ]] && ! change_directory "$mount_path/${bookmark_path#/}"; then return; fi
    local saved
    if saved=$(umask 077; mkdir -p -- "$profile_dir" && mktemp "$profile_dir/.last-$protocol.XXXXXX"); then
        if printf '%s\n' "$remote_address" > "$saved" && mv -T -- "$saved" "$profile_dir/last-$protocol"; then
            notice="Connected: ${protocol^^} $remote_address"
        else
            rm -f -- "$saved"
            notice="Connected; cannot remember the address."
        fi
    fi
    if ! save_connection "$protocol" "$remote_address"; then
        notice='Connected; cannot save the connection.'
    fi
}

change_directory() {
    local destination key path i saved_focus
    if [[ $1 == "$connections_root" ]]; then destination=$connections_root
    elif ! destination=$(cd -P -- "$1" 2>/dev/null && pwd -P); then
        notice='Cannot enter the directory.'
        return 1
    fi
    key="$active_pane:$cwd"
    directory_focus["$key"]=${entries[cursor]}
    directory_scroll["$key"]=$scroll
    for key in "${!directory_marks[@]}"; do
        if [[ $key == "$active_pane:"* && ${directory_marks[$key]} == "$cwd" ]]; then
            unset 'directory_marks[$key]'
        fi
    done
    for path in "${!marks[@]}"; do directory_marks["$active_pane:$path"]=$cwd; done
    cwd=$destination; filter=''; content_filter=''; cursor=1; scroll=0
    [[ $cwd == "$connections_root" ]] && cursor=0
    reload
    key="$active_pane:$cwd"
    saved_focus=${directory_focus[$key]:-}
    scroll=${directory_scroll[$key]:-0}
    for i in "${!entries[@]}"; do
        path=${entries[i]}
        [[ $path == "$saved_focus" ]] && cursor=$i
        [[ -v directory_marks["$active_pane:$path"] ]] && marks["$path"]=1
    done
    sync_scroll
    display_path "$cwd"
    notice="Directory: $REPLY"
}

go_parent() {
    local previous=$cwd i
    [[ $cwd == "$connections_root" ]] && return 0
    if [[ -v archive_sources["$cwd"] ]]; then
        previous=${archive_sources[$cwd]}
        if ! change_directory "${previous%/*}/"; then return; fi
    else
        if [[ $cwd == / || -v remote_labels["$cwd"] ]]; then change_directory "$connections_root"; return; fi
        if ! change_directory "$cwd/.."; then return; fi
    fi
    for i in "${!entries[@]}"; do
        if [[ ${entries[i]} == "$previous" ]]; then cursor=$i; break; fi
    done
    sync_scroll
}

enter_dir() {
    local path=${entries[cursor]}
    if is_archive_path "$cwd" && [[ -L $path ]]; then
        local archive_root=$REPLY resolved
        if ! resolved=$(realpath -e -- "$path") ||
           [[ $resolved != "$archive_root" && $resolved != "$archive_root/"* ]]; then
            notice='External or unavailable link in this archive.'; return
        fi
    fi
    if [[ $cwd == "$connections_root" ]]; then
        case $path in
            local) change_directory /;;
            ssh|ftp) connect_remote "$path";;
            "$shortcuts_dir/"*)
                open_shortcut "$path"
                ;;
            profile:*)
                local id=${path#profile:}
                if [[ -v connection_protocols["$id"] ]]; then
                    connect_remote "${connection_protocols[$id]}" "${connection_addresses[$id]}"
                else notice='Saved connection unavailable.'; fi
                ;;
        esac
    elif [[ $path == '..' ]]; then
        go_parent
    elif [[ -d $path ]]; then
        change_directory "$path"
    elif [[ -f $path ]] && is_archive_file "$path"; then
        open_archive "$path"
    elif [[ -f $path && -x $path ]]; then
        if is_archive_path "$cwd"; then notice='Read-only archive.'; return; fi
        run_executable
    elif [[ -f $path ]]; then
        open_document "$path"
    else
        notice='File unavailable or unsupported type.'
    fi
}

handle_mouse() {
    local idx i x y now path
    x=$MOUSE_X
    y=$MOUSE_Y
    if (( dual_pane && y >= items_y && y < items_y+visible )); then
        if (( (x > cols/2) != active_pane )); then switch_pane; fi
    fi
    if (( MOUSE_BTN == 64 )); then
        ((cursor > 0)) && ((cursor-=1))
        notice='Scroll up.'
        return
    fi
    if (( MOUSE_BTN == 65 )); then
        ((cursor + 1 < ${#entries[@]})) && ((cursor+=1))
        notice='Scroll down.'
        return
    fi
    [[ $MOUSE_ACTION != M ]] && return
    (( MOUSE_BTN != 0 )) && return
    if (( x > pane_x && x < pane_x+pane_width-1 && y >= items_y && y < items_y + visible )); then
        idx=$((scroll + y - items_y))
        if (( idx >= 0 && idx < ${#entries[@]} )); then
            cursor=$idx
            clear_filter
            idx=$cursor
            # Column 3 contains the selection mark (*).
            if (( x == pane_x+2 )) && [[ ${entries[idx]} != '..' ]]; then
                select_current
                return
            fi
            path=${entries[idx]}
            now=$(now_millis)
            if [[ $path == "$last_click_path" ]] && (( now - last_click_ms < 450 )); then
                last_click_ms=0
                last_click_path=''
                enter_dir
                return
            fi
            last_click_ms=$now
            last_click_path=$path
            notice='Row selected with the mouse.'
        fi
        return
    fi
    if (( y == actions_y )); then
        for i in "${!action_keys[@]}"; do
            if (( x >= action_starts[i] && x <= action_ends[i] )); then
                KEY=${action_keys[i]}
                return
            fi
        done
    fi
}

perform_key() {
    if is_archive_path "$cwd"; then
        case $1 in
            F1|F2|F4|F6|F7|F8|ATTRIBUTES|SYMLINK)
                notice='Read-only archive: use F5 to copy its contents.'; return 0;;
        esac
    fi
    if [[ $cwd == "$connections_root" ]]; then
        case $1 in
            F2)
                if [[ ${entries[cursor]} == "$shortcuts_dir/"* && -L ${entries[cursor]} ]]; then rename_item
                else rename_saved_connection; fi
                return 0;;
            SYMLINK) create_symlink; return 0;;
            F8) delete_saved_connection; return 0;;
            UP|DOWN|LEFT|RIGHT|BACK|HOME|END|PAGEUP|PAGEDOWN|ENTER|TAB|F10|ESC|'?'|k|j|h|l|r|R|q|Q) ;;
            *) notice='Choose This PC, SSH or FTP.'; return 0;;
        esac
    fi
    if [[ ( -n $filter || -n $content_filter ) && ( $1 == ENTER || $1 == RIGHT ) ]] && (( ${#entries[@]}<=1 )); then
        notice='No matches: Ctrl+F edits, Esc clears the filter.'; return 0
    fi
    case $1 in
        ENTER|RIGHT|l|F1|F2|F3|F4|F5|F6|F7|F8|ATTRIBUTES|SYMLINK) clear_filter;;
    esac
    case $1 in
        UP|k) ((cursor>0)) && ((cursor-=1));;
        DOWN|j) ((cursor+1<${#entries[@]})) && ((cursor+=1));;
        PAGEUP) ((cursor-=visible)); ((cursor<0)) && cursor=0;;
        PAGEDOWN) ((cursor+=visible)); ((cursor>=${#entries[@]})) && cursor=$((${#entries[@]}-1));;
        HOME) cursor=0;;
        END) cursor=$((${#entries[@]}-1));;
        ENTER|RIGHT|l) enter_dir;;
        LEFT|h|BACK) go_parent;;
        TAB) switch_pane;;
        FILTER) filter_items;;
        HIDDEN)
            show_hidden=$((1-show_hidden))
            cursor=1; scroll=0
            reload
            if (( show_hidden )); then notice='Hidden files visible.'
            else notice='Hidden files hidden.'; fi
            ;;
        F1) user_menu;;
        '?') show_help;;
        F2) rename_item;;
        F3)
            select_current
            if [[ ${entries[cursor]} != '..' ]]; then
                ((cursor+1<${#entries[@]})) && ((cursor+=1))
            fi
            ;;
        F4) edit_item;;
        F5) transfer_items copy;;
        F6) transfer_items move;;
        F7) new_dir;;
        F8) delete_items;;
        ATTRIBUTES) attributes_items;;
        SYMLINK) create_symlink;;
        BAD_CHORD) notice='Ctrl+X: C for attributes, S for symbolic link.';;
        r|R) reload; notice='List refreshed.';;
        ESC)
            if [[ -n $filter || -n $content_filter ]]; then clear_filter
            else notice='Press F10 to quit.'; fi;;
        F10) return 1;;
        *) ;;
    esac
    return 0
}

reload
(( ${#entries[@]} > 1 )) && cursor=1
while :; do
    draw
    if ! input_key; then
        if (( resized )); then resized=0; continue; fi
        break
    fi
    if (( resized )); then resized=0; draw; fi
    if (( rows < 12 || cols < 35 )); then
        [[ $KEY == F10 ]] && break
        continue
    fi
    # Batch queued navigation, then draw once.
    # The first different command stays in KEY and executes normally.
    navigation_count=0
    while (( navigation_count < 256 )) && IFS= read -rt 0 -u9; do
        case $KEY in
            UP|DOWN|PAGEUP|PAGEDOWN|HOME|END|j|k) ;;
            *) break;;
        esac
        perform_key "$KEY"
        ((navigation_count+=1))
        input_key || break
    done
    (( navigation_count )) && draw
    if [[ $KEY == MOUSE ]]; then
        KEY=''
        handle_mouse
        if [[ $KEY == F10 ]]; then break; fi
        [[ -n $KEY ]] && perform_key "$KEY" || true
        continue
    fi
    if ! perform_key "$KEY"; then
        break
    fi
done
