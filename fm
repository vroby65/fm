        (( ${#value}>width )) && value=${value: -width}
        modal_text 5 4 "$width" "$value" "$style"
        if [[ $protocol == ssh ]]; then
            modal_line 7 'Vuota: portachiavi o chiavi SSH.'
        else
            modal_line 7 'Vuota: usa la password salvata nel portachiavi.'
        fi
        (( modal_h >= 14 )) && modal_line 8 'Password ricordata nel portachiavi di sistema.'
        (( modal_h >= 14 )) && modal_line 9 'Tab: cambia campo  Invio: connetti  Esc: annulla'
        modal_rule "$((modal_h-4))"
        modal_buttons "$((focus-2))" 'Connetti'
