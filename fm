    (( modal_h >= 14 || focus == 1 || focus == 2 )) && modal_rule "$((modal_h-4))"
    modal_buttons "$((focus-3))"
}

attributes_items() {
    local path current owner='' group='' focus=0 cell=0 key spec='' mode='' digits='' new_mode
    local base_mode perms i failed=0 chmod_changed=0 chown_changed=0
    local chmod_dirty=0 file_error='' summary=''
    local user_index=0 group_index=0 user_start=0 group_start=0 list_count list_w list_y
    local -a user_names=() group_names=()
    collect
    if (( ${#targets[@]} == 0 )); then notice='Nessun elemento selezionato.'; return; fi
    base_mode=$(stat -c %a -- "${targets[0]}" 2>/dev/null) || return
    current=$(stat -c '%U:%G' -- "${targets[0]}" 2>/dev/null) || return
    perms=$((8#$base_mode))
    mapfile -t user_names < <(getent passwd | cut -d: -f1 | LC_ALL=C sort -u)
    mapfile -t group_names < <(getent group | cut -d: -f1 | LC_ALL=C sort -u)
    (( ${#user_names[@]} )) || user_names=("${current%:*}")
    (( ${#group_names[@]} )) || group_names=("${current#*:}")
    for i in "${!user_names[@]}"; do [[ ${user_names[i]} == "${current%:*}" ]] && user_index=$i; done
    for i in "${!group_names[@]}"; do [[ ${group_names[i]} == "${current#*:}" ]] && group_index=$i; done
    needs_full=1
    while :; do
        printf -v new_mode '%04o' "$perms"
        attributes_dialog
        if ! input_key; then modal_cancel 'Modifica attributi annullata.'; return; fi
        key=$KEY
        case $key in
            TAB) focus=$(((focus+1)%5));;
            UP|DOWN|LEFT|RIGHT|PAGEUP|PAGEDOWN|HOME|END)
                if (( focus == 0 )); then
                    case $key in
                        UP) cell=$(((cell+6)%9));;
                        DOWN) cell=$(((cell+3)%9));;
                        LEFT) cell=$(((cell+8)%9));;
                        RIGHT) cell=$(((cell+1)%9));;
                    esac
                elif [[ $key == LEFT || $key == RIGHT ]]; then
                    if [[ $key == LEFT ]]; then focus=$(((focus+4)%5)); else focus=$(((focus+1)%5)); fi
                elif (( focus == 1 || focus == 2 )); then
                    local index count step=1
                    if (( focus == 1 )); then index=$user_index; count=${#user_names[@]}
                    else index=$group_index; count=${#group_names[@]}; fi
                    case $key in PAGEUP|PAGEDOWN) step=$list_count;; esac
                    case $key in
                        UP|PAGEUP) ((index-=step));;
                        DOWN|PAGEDOWN) ((index+=step));;
                        HOME) index=0;;
                        END) index=$((count-1));;
                    esac
                    (( index < 0 )) && index=0
                    (( index >= count )) && index=$((count-1))
                    if (( focus == 1 )); then user_index=$index; owner=${user_names[index]}
                    else group_index=$index; group=${group_names[index]}; fi
                fi
                ;;
            F3)
                if (( focus == 0 )); then
                    perms=$((perms ^ (1 << (8-cell)))); digits=''; chmod_dirty=1
                elif (( focus >= 3 )); then PENDING_CHAR=$'\r'; fi
                ;;
            BACK)
                case $focus in 0) digits=${digits%?};; 1) owner=${owner%?};; 2) group=${group%?};; esac
                ;;
            ':') focus=2;;
            ENTER)
                if (( focus == 4 )); then modal_cancel 'Modifica attributi annullata.'; return; fi
                if [[ -n $digits && ! $digits =~ ^[0-7]{3,4}$ ]]; then
                    notice='Modo ottale non valido: usa 3 o 4 cifre da 0 a 7.'; needs_full=1; return
                fi
                if (( chmod_dirty )) || [[ -n $digits ]]; then mode=${digits:-$new_mode}; fi
                spec=$owner; [[ -n $group ]] && spec="$owner:$group"
                break
                ;;
            ESC|F10)
                modal_cancel 'Modifica attributi annullata.'; return
                ;;
            MOUSE)
                if [[ $MOUSE_ACTION == M && $MOUSE_BTN == 0 ]]; then
                    local x=$((MOUSE_X-modal_x)) y=$((MOUSE_Y-modal_y)) index
                    if (( y>=4 && y<=6 && x>=13 && x<30 && (x-13)%7<3 && (modal_h>=20 || focus==0 || focus>=3) )); then
                        cell=$(((y-4)*3+(x-13)/7)); focus=0
                        perms=$((perms ^ (1 << (8-cell)))); digits=''; chmod_dirty=1
                    elif (( y>=list_y && y<modal_h-6 && (modal_h>=20 || focus==1 || focus==2) )); then
                        if (( x>2 && x<2+list_w-1 )); then
                            index=$((user_start+y-list_y))
                            if (( index<${#user_names[@]} )); then focus=1; user_index=$index; owner=${user_names[index]}; fi
                        elif (( x>3+list_w && x<2+2*list_w )); then
                            index=$((group_start+y-list_y))
                            if (( index<${#group_names[@]} )); then focus=2; group_index=$index; group=${group_names[index]}; fi
                        fi
                    elif modal_button_at; then
                        if [[ $REPLY == apply ]]; then
                            focus=3; PENDING_CHAR=$'\r'
                        else
                            modal_cancel 'Modifica attributi annullata.'; return
                        fi
                    fi
                fi
                ;;
            *)
                if [[ $key == [[:print:]] && ${#key} == 1 && $key != [[:space:]] ]]; then
                    case $focus in
                        0) if [[ $key == [0-9] ]] && (( ${#digits}<4 )); then digits+=$key; fi;;
                        1) (( ${#owner}<128 )) && owner+=$key;;
                        2) (( ${#group}<128 )) && group+=$key;;
                    esac
                fi
                ;;
        esac
    done
    needs_full=1
    # chown puo' azzerare setuid/setgid: applica chmod dopo il proprietario.
    for path in "${targets[@]}"; do
        if [[ -n $spec ]]; then
            if file_command chown -- "$spec" "$path"; then ((chown_changed+=1)); else ((failed+=1)); fi
        fi
        if [[ -n $mode ]]; then
            if [[ -L $path ]]; then ((failed+=1))
            elif file_command chmod -- "$mode" "$path"; then ((chmod_changed+=1))
            else ((failed+=1)); fi
        fi
    done
    [[ -n $spec ]] && summary="chown $spec: modificati $chown_changed. "
    [[ -n $mode ]] && summary+="chmod $mode: modificati $chmod_changed. "
    reload
    notice="${file_error:+$file_error }${summary:-Nessuna modifica. }Non riusciti: $failed."
}

create_symlink() {
    local path=${entries[cursor]} name file_error=''
    if [[ $path == '..' ]]; then
        notice='Seleziona un file o una directory per il link.'
        return
    fi
    name="${path##*/}.lnk"
    if [[ -e $cwd/$name || -L $cwd/$name ]]; then
        notice="Esiste gia' un file o link con questo nome."
        return
    fi
    # Destinazione assoluta: il link resta valido dopo aver spostato
    # il collegamento in un altra directory (finche il target esiste).
    if file_command ln -s -- "$path" "$cwd/$name"; then
        reload
        notice="Creato link $name -> $path"
    else
        notice="Creazione link non riuscita: $file_error"
    fi
}

# Le connessioni GVfs espongono un percorso FUSE alle normali operazioni di fm.
# REPLY riceve la radice del mount per distinguere protocollo e trasferimenti interni.
is_archive_path() {
    local root
    for root in "${!archive_sources[@]}"; do
        if [[ $1 == "$root" || $1 == "$root/"* ]]; then REPLY=$root; return 0; fi
    done
    return 1
}

is_archive_file() {
    case ${1,,} in
        *.zip|*.tar|*.tar.gz|*.tgz|*.tar.bz2|*.tbz|*.tbz2|*.tar.xz|*.txz|*.tar.zst|*.tzst|*.7z|*.rar) return 0;;
        *) return 1;;
    esac
}

open_archive() {
    local path=$1 root result status message cache='' mount_path=$1 file_error=''
    for root in "${!archive_sources[@]}"; do
        if [[ ${archive_sources[$root]} == "$path" && -d $root ]]; then
            change_directory "$root"; return
        fi
    done
    # Il backend archive non puo' leggere direttamente i percorsi di altri mount GVfs.
    if is_archive_path "$path" || is_remote_path "$path"; then
        cache=$(mktemp -d "${TMPDIR:-/tmp}/fm-archive.XXXXXX") || return
        archive_pending_cache=$cache
        mount_path="$cache/${path##*/}"
        if ! file_command cp -- "$path" "$mount_path"; then
            rm -rf -- "$cache"
            notice="Impossibile leggere il file archivio: $file_error"; return
        fi
    fi
    result=$(mktemp) || { [[ -n $cache ]] && rm -rf -- "$cache"; return; }
    local run_program_label="Apertura archivio ${path##*/}"
    trap ':' INT
    run_program 0 remote_mount archive "$mount_path" -1 "$result"
    status=$?
    trap 'exit 130' INT
    IFS= read -r root < "$result" || :
    rm -f -- "$result"
    if (( status != 0 )); then
        [[ -n $cache ]] && rm -rf -- "$cache"
        safe "${root:-annullata}"; message=$REPLY
        notice="Apertura archivio non riuscita: $message"; return
    fi
    archive_sources["$root"]=$path
    [[ -n $cache ]] && archive_cache["$root"]=$cache
    archive_pending_cache=''
    change_directory "$root"
}

is_remote_path() {
    local root
    for root in "${!remote_labels[@]}"; do
        if [[ $1 == "$root" || $1 == "$root/"* ]]; then REPLY=$root; return 0; fi
    done
    return 1
}

display_path() {
    local root
    REPLY=$1
    if [[ $1 == "$connections_root" ]]; then REPLY='Connessioni'; return; fi
    for root in "${!archive_sources[@]}"; do
        if [[ $1 == "$root" || $1 == "$root/"* ]]; then
            local suffix=${1#"$root"} source=${archive_sources[$root]}
            display_path "$source"
            REPLY+="!${suffix:-/}"
            return
        fi
    done
    for root in "${!remote_labels[@]}"; do
        if [[ $1 == "$root" || $1 == "$root/"* ]]; then
            REPLY="${remote_labels[$root]}:${1#"$root"}"
            [[ $1 == "$root" ]] && REPLY+='/'
            return
        fi
    done
}

