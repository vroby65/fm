            TAB) focus=$(((focus+1)%4));;
            UP|DOWN) focus=$((1-(focus%2)));;
            ESC|F10) modal_cancel 'Connessione annullata.'; return 1;;
            ENTER)
                if (( focus == 3 )); then modal_cancel 'Connessione annullata.'; return 1; fi
                if (( focus == 0 )); then focus=1; continue; fi
                if [[ ! $remote_address =~ ^[^:@/[:space:]]+@[^/@[:space:]]+$ ]]; then
                    modal_cancel 'Indirizzo non valido: usa utente@host[:porta].'; return 1
                fi
                needs_full=1; return 0
                ;;
            BACK)
                if (( focus == 0 )); then
                    if (( replace_address )); then remote_address=''; else remote_address=${remote_address%?}; fi
                    replace_address=0
                elif (( focus == 1 )); then remote_password=${remote_password%?}; fi
                ;;
            HOME|END|LEFT|RIGHT) replace_address=0;;
            $'\025')
                if (( focus == 0 )); then remote_address=''; replace_address=0
                elif (( focus == 1 )); then remote_password=''; fi
                ;;
            MOUSE)
                if [[ $MOUSE_ACTION == M && $MOUSE_BTN == 0 ]]; then
                    local x=$((MOUSE_X-modal_x)) y=$((MOUSE_Y-modal_y))
                    if (( x>=4 && x<modal_w-4 && y==2 )); then focus=0
                    elif (( x>=4 && x<modal_w-4 && y==5 )); then focus=1
                    elif modal_button_at; then
                        if [[ $REPLY == apply ]]; then focus=2; PENDING_CHAR=$'\r'
                        else modal_cancel 'Connessione annullata.'; return 1; fi
                    fi
                fi
                ;;
            *)
                [[ $key == F3 ]] && key=' '
                if [[ ${#key} == 1 && $key == [[:print:]] ]]; then
                    if (( focus == 0 && ${#remote_address}<200 )); then
                        if (( replace_address )); then remote_address=''; replace_address=0; fi
                        remote_address+=$key
                    elif (( focus == 1 && ${#remote_password}<200 )); then remote_password+=$key; fi
                fi
                ;;
        esac
    done
}

remote_mount() {
    /usr/bin/python3 - "$@" <<'PY'
import os
import pathlib
import sys
import time
from urllib.parse import quote, urlsplit

protocol, address, password_fd, result_file = sys.argv[1:]
password = "" if protocol == "archive" else os.fdopen(int(password_fd)).read()

def fail(message):
    pathlib.Path(result_file).write_text(message + "\n")
    print(message, file=sys.stderr)

try:
    from gi.repository import Gio, GLib
except ImportError:
    fail("Supporto GVfs assente: servono python3-gi, gvfs-backends e gvfs-fuse.")
    sys.exit(1)

try:
    if protocol == "archive":
        uri = pathlib.Path(address).as_uri()
        location = Gio.File.new_for_uri("archive://" + quote(uri, safe="") + "/")
    else:
        user, host = address.rsplit("@", 1)
        if not user or any(c in user for c in ":/@?#") or any(c.isspace() for c in address):
            raise ValueError()
        scheme = "sftp" if protocol == "ssh" else "ftp"
        parsed = urlsplit(f"{scheme}://{quote(user, safe='')}@{host}/")
        if not parsed.hostname or parsed.hostname.startswith("-") or parsed.path != "/" or parsed.query or parsed.fragment:
            raise ValueError()
        if parsed.port is not None and not 1 <= parsed.port <= 65535:
            raise ValueError()
        location = Gio.File.new_for_uri(parsed.geturl())
except (ValueError, GLib.Error):
    fail("Indirizzo non valido: usa utente@host[:porta].")
    sys.exit(1)

operation = Gio.MountOperation()
operation.set_password_save(Gio.PasswordSave.PERMANENTLY)
loop = GLib.MainLoop()
cancellable = Gio.Cancellable()
status = 1
attempted = False
auth_error = ""

def ask_password(op, message, default_user, default_domain, flags):
    global attempted, auth_error
    if protocol == "archive":
        auth_error = "Archivio protetto o non leggibile."
        op.reply(Gio.MountOperationResult.ABORTED)
        return
    if attempted or (protocol == "ssh" and not password):
        auth_error = "Autenticazione non riuscita." if attempted else "Chiave SSH non disponibile: inserisci la password."
        op.reply(Gio.MountOperationResult.ABORTED)
        return
    attempted = True
    op.set_anonymous(False)
    op.set_username(user)
    op.set_domain(default_domain or "")
    op.set_password(password)
    op.set_password_save(Gio.PasswordSave.PERMANENTLY)
    op.reply(Gio.MountOperationResult.HANDLED)

def ask_question(op, message, choices):
    print(message)
    for index, choice in enumerate(choices, 1):
        print(f"{index}. {choice}")
    print("Scelta (vuoto annulla): ", end="", flush=True)
    try:
        with open("/dev/tty") as tty:
            answer = int(tty.readline().strip()) - 1
        if not 0 <= answer < len(choices):
            raise ValueError()
        op.set_choice(answer)
        op.reply(Gio.MountOperationResult.HANDLED)
    except (ValueError, OSError, KeyboardInterrupt):
        op.reply(Gio.MountOperationResult.ABORTED)

def mounted(file, result):
    global status
    try:
        try:
            file.mount_enclosing_volume_finish(result)
        except GLib.Error as error:
            if not error.matches(Gio.io_error_quark(), Gio.IOErrorEnum.ALREADY_MOUNTED):
                raise
        if protocol == "archive":
            # Il backend archive pubblica la radice con l'URI interno nuovamente quotato.
            file = Gio.File.new_for_uri("archive://" + quote(quote(uri, safe=""), safe="") + "/")
        # L'autenticazione dal portachiavi puo' finire prima dell'esportazione FUSE.
        for _ in range(40):
            root = file.find_enclosing_mount(None).get_root().get_path()
            if root and os.path.isdir(root):
                break
            time.sleep(0.05)
        if not root or not os.path.isdir(root):
            raise RuntimeError("Percorso remoto non disponibile: verifica gvfs-fuse.")
        pathlib.Path(result_file).write_text(root + "\n")
        status = 0
    except (GLib.Error, RuntimeError, OSError) as error:
        fail(auth_error or getattr(error, "message", str(error)))
    loop.quit()

def timed_out():
    cancellable.cancel()
    fail("Tempo di connessione scaduto.")
    loop.quit()
    return False

operation.connect("ask-password", ask_password)
operation.connect("ask-question", ask_question)
GLib.timeout_add_seconds(30, timed_out)
location.mount_enclosing_volume(Gio.MountMountFlags.NONE, operation, cancellable, mounted)
try:
    loop.run()
except KeyboardInterrupt:
    fail("Connessione annullata.")
sys.exit(status)
PY
}

# Tre righe per voce: protocollo, indirizzo, nome. Il nome non e' mai un percorso.
save_connection() {
    local protocol=$1 address=$2 name=${3:-} id file saved old_protocol='' old_address=''
    id=$(printf '%s\0%s' "$protocol" "$address" | sha256sum); id=${id%% *}
    file="$connections_dir/$id"
    if [[ -z $name && -r $file ]]; then
        { IFS= read -r old_protocol; IFS= read -r old_address; IFS= read -r name; } < "$file" || name=''
        [[ $old_protocol == "$protocol" && $old_address == "$address" ]] || name=''
    fi
    [[ -n $name ]] || name="${protocol^^} $address"
    saved=$(umask 077; mkdir -p -- "$connections_dir" && mktemp "$connections_dir/.saved.XXXXXX") || return 1
    if printf '%s\n%s\n%s\n' "$protocol" "$address" "$name" > "$saved" && mv -T -- "$saved" "$file"; then
        return 0
    fi
    rm -f -- "$saved"
    return 1
}

load_saved_connections() {
    local file id protocol address name
    connection_names=(); connection_protocols=(); connection_addresses=()
    # Importa una volta gli ultimi indirizzi della versione precedente.
    if [[ ! -d $connections_dir ]]; then
        for protocol in ssh ftp; do
            file="${connections_dir%/*}/last-$protocol"
            if [[ -r $file ]] && IFS= read -r address < "$file" &&
               [[ $address =~ ^[^:@/[:space:]]+@[^/@[:space:]]+$ ]]; then
                save_connection "$protocol" "$address" || :
            fi
        done
    fi
    for file in "$connections_dir"/*; do
        id=${file##*/}
        [[ $id =~ ^[0-9a-f]{64}$ && -f $file ]] || continue
        { IFS= read -r protocol && IFS= read -r address && IFS= read -r name; } < "$file" || continue
        [[ $protocol == ssh || $protocol == ftp ]] || continue
        [[ -n $name && $address =~ ^[^:@/[:space:]]+@[^/@[:space:]]+$ ]] || continue
        connection_names["$id"]=$name
        connection_protocols["$id"]=$protocol
        connection_addresses["$id"]=$address
        entries+=("profile:$id")
    done
}

rename_saved_connection() {
    local entry=${entries[cursor]} id name protocol address
    id=${entry#profile:}
    if [[ $entry != profile:* || ! -v connection_names["$id"] ]]; then
        notice='Seleziona una connessione salvata.'; return
    fi
    protocol=${connection_protocols[$id]}; address=${connection_addresses[$id]}
    if ! rename_dialog "${connection_names[$id]}"; then return; fi
    name=$REPLY
    if [[ -z $name ]]; then notice='Nome non valido.'; return; fi
    if save_connection "$protocol" "$address" "$name"; then
        reload
        notice="Connessione rinominata: $name"
    else notice='Impossibile salvare il nome della connessione.'; fi
}

delete_saved_connection() {
    local entry=${entries[cursor]} id
    id=${entry#profile:}
    if [[ $entry != profile:* || ! -v connection_names["$id"] ]]; then
        notice='Seleziona una connessione salvata.'; return
    fi
    if ! ask 'Eliminare connessione? s/N: '; then return; fi
    if [[ $REPLY != [sSyY] ]]; then notice='Eliminazione annullata.'; return; fi
    if rm -f -- "$connections_dir/$id"; then
        reload
        notice='Connessione eliminata.'
    else notice='Impossibile eliminare la connessione salvata.'; fi
}

connect_remote() {
    local protocol=$1 remote_address=${2:-} remote_password='' password_fd result mount_path status
    local profile_dir=${XDG_CONFIG_HOME:-$HOME/.config}/fm
    if [[ -z $remote_address && -r $profile_dir/last-$protocol ]]; then
        IFS= read -r remote_address < "$profile_dir/last-$protocol"
    fi
    if ! connection_dialog "$protocol"; then return; fi
    result=$(mktemp) || return
    local run_program_label="Connessione ${protocol^^}"
    exec {password_fd}< <(printf '%s' "$remote_password")
    trap ':' INT
    run_program 0 remote_mount "$protocol" "$remote_address" "$password_fd" "$result"
    status=$?
    trap 'exit 130' INT
    exec {password_fd}<&-
    unset remote_password
    IFS= read -r mount_path < "$result" || :
    rm -f -- "$result"
    if (( status != 0 )); then
        notice="Connessione non riuscita: ${mount_path:-annullata}."
        return
    fi
    remote_labels["$mount_path"]="${protocol^^} $remote_address"
    remote_protocols["$mount_path"]=$protocol
    if ! change_directory "$mount_path"; then return; fi
    local saved
    if saved=$(umask 077; mkdir -p -- "$profile_dir" && mktemp "$profile_dir/.last-$protocol.XXXXXX"); then
        if printf '%s\n' "$remote_address" > "$saved" && mv -T -- "$saved" "$profile_dir/last-$protocol"; then
            notice="Connesso: ${protocol^^} $remote_address"
        else
            rm -f -- "$saved"
            notice="Connesso; impossibile ricordare l'indirizzo."
        fi
    fi
    if ! save_connection "$protocol" "$remote_address"; then
        notice='Connesso; impossibile salvare la connessione.'
    fi
}

change_directory() {
    local destination key path i saved_focus
    if [[ $1 == "$connections_root" ]]; then destination=$connections_root
    elif ! destination=$(cd -P -- "$1" 2>/dev/null && pwd -P); then
        notice='Impossibile entrare nella directory.'
        return 1
    fi
    key="$active_pane:$cwd"
    directory_focus["$key"]=${entries[cursor]}
    directory_scroll["$key"]=$scroll
    for key in "${!directory_marks[@]}"; do
        if [[ $key == "$active_pane:"* && ${directory_marks[$key]} == "$cwd" ]]; then
            unset 'directory_marks[$key]'
        fi
    done
    for path in "${!marks[@]}"; do directory_marks["$active_pane:$path"]=$cwd; done
    cwd=$destination; filter=''; filter_editing=0; cursor=1; scroll=0
    [[ $cwd == "$connections_root" ]] && cursor=0
    reload
    key="$active_pane:$cwd"
    saved_focus=${directory_focus[$key]:-}
    scroll=${directory_scroll[$key]:-0}
    for i in "${!entries[@]}"; do
        path=${entries[i]}
        [[ $path == "$saved_focus" ]] && cursor=$i
        [[ -v directory_marks["$active_pane:$path"] ]] && marks["$path"]=1
    done
    sync_scroll
    display_path "$cwd"
    notice="Directory: $REPLY"
}

go_parent() {
    local previous=$cwd i
    [[ $cwd == "$connections_root" ]] && return 0
    if [[ -v archive_sources["$cwd"] ]]; then
        previous=${archive_sources[$cwd]}
        if ! change_directory "${previous%/*}/"; then return; fi
    else
        if [[ $cwd == / || -v remote_labels["$cwd"] ]]; then change_directory "$connections_root"; return; fi
        if ! change_directory "$cwd/.."; then return; fi
    fi
    for i in "${!entries[@]}"; do
        if [[ ${entries[i]} == "$previous" ]]; then cursor=$i; break; fi
    done
    sync_scroll
}

enter_dir() {
    local path=${entries[cursor]}
    if is_archive_path "$cwd" && [[ -L $path ]]; then
        local archive_root=$REPLY resolved
        if ! resolved=$(realpath -e -- "$path") ||
           [[ $resolved != "$archive_root" && $resolved != "$archive_root/"* ]]; then
            notice='Link esterno o non disponibile in questo archivio.'; return
        fi
    fi
    if [[ $cwd == "$connections_root" ]]; then
        case $path in
            local) change_directory /;;
            ssh|ftp) connect_remote "$path";;
            profile:*)
                local id=${path#profile:}
                if [[ -v connection_protocols["$id"] ]]; then
                    connect_remote "${connection_protocols[$id]}" "${connection_addresses[$id]}"
                else notice='Connessione salvata non disponibile.'; fi
                ;;
        esac
    elif [[ $path == '..' ]]; then
        go_parent
    elif [[ -d $path ]]; then
        change_directory "$path"
    elif [[ -f $path ]] && is_archive_file "$path"; then
        open_archive "$path"
    elif [[ -f $path && -x $path ]]; then
        if is_archive_path "$cwd"; then notice='Archivio in sola lettura.'; return; fi
        run_executable
    else
        notice="Non e' una directory o un file eseguibile."
    fi
}

handle_mouse() {
    local idx i x y now path
    x=$MOUSE_X
    y=$MOUSE_Y
    if (( dual_pane && y >= items_y && y < items_y+visible )); then
        if (( (x > cols/2) != active_pane )); then switch_pane; fi
    fi
    if (( MOUSE_BTN == 64 )); then
        ((cursor > 0)) && ((cursor-=1))
        notice='Rotella su.'
        return
    fi
    if (( MOUSE_BTN == 65 )); then
        ((cursor + 1 < ${#entries[@]})) && ((cursor+=1))
        notice='Rotella giu.'
        return
    fi
    [[ $MOUSE_ACTION != M ]] && return
    (( MOUSE_BTN != 0 )) && return
    if (( x > pane_x && x < pane_x+pane_width-1 && y >= items_y && y < items_y + visible )); then
        idx=$((scroll + y - items_y))
        if (( idx >= 0 && idx < ${#entries[@]} )); then
            cursor=$idx
            clear_filter
            idx=$cursor
            # La colonna 3 contiene il simbolo di marcatura (*).
            if (( x == pane_x+2 )) && [[ ${entries[idx]} != '..' ]]; then
                select_current
                return
            fi
            path=${entries[idx]}
            now=$(now_millis)
            if [[ $path == "$last_click_path" ]] && (( now - last_click_ms < 450 )); then
                last_click_ms=0
                last_click_path=''
                enter_dir
                return
            fi
            last_click_ms=$now
            last_click_path=$path
            notice='Riga selezionata con mouse.'
        fi
        return
    fi
    if (( y == actions_y )); then
        for i in "${!action_keys[@]}"; do
            if (( x >= action_starts[i] && x <= action_ends[i] )); then
                KEY=${action_keys[i]}
                return
            fi
        done
    fi
}

perform_key() {
    if is_archive_path "$cwd"; then
        case $1 in
            F1|F2|F4|F6|F7|F8|ATTRIBUTES|SYMLINK)
                notice='Archivio in sola lettura: usa F5 per copiare i contenuti.'; return 0;;
        esac
    fi
    if [[ $cwd == "$connections_root" ]]; then
        case $1 in
            F2) rename_saved_connection; return 0;;
            F8) delete_saved_connection; return 0;;
            UP|DOWN|LEFT|RIGHT|BACK|HOME|END|PAGEUP|PAGEDOWN|ENTER|TAB|F10|ESC|k|j|h|l|r|R|q|Q) ;;
            *) notice='Scegli Questo PC, SSH o FTP.'; return 0;;
        esac
    fi
    if (( filter_editing )); then
        local changed=0
        case $1 in
            ESC) clear_filter; notice='Filtro rimosso.'; return 0;;
            ENTER|RIGHT)
                if [[ -n $filter ]] && (( ${#entries[@]} <= 1 )); then
                    notice='Nessuna corrispondenza: modifica il filtro o premi Esc.'
                    return 0
                fi
                filter_editing=0
                ;;
            BACK) filter=${filter%?}; changed=1;;
            FILTER) filter=''; changed=1;;
            UP|DOWN|PAGEUP|PAGEDOWN|HOME|END) ;;
            *)
                if [[ ${#1} == 1 && $1 == [[:print:]] ]]; then
                    (( ${#filter} < 200 )) && filter+=$1
                    changed=1
                else
                    filter_editing=0
                fi
                ;;
        esac
        if (( changed )); then
            cursor=1; scroll=0
            reload
            notice="Filtro: ${filter:-tutti} | Invio apre, Esc annulla."
            return 0
        fi
    fi
    case $1 in
        ENTER|RIGHT|l|F1|F2|F3|F4|F5|F6|F7|F8|ATTRIBUTES|SYMLINK) clear_filter;;
    esac
    case $1 in
        UP|k) ((cursor>0)) && ((cursor-=1));;
        DOWN|j) ((cursor+1<${#entries[@]})) && ((cursor+=1));;
        PAGEUP) ((cursor-=visible)); ((cursor<0)) && cursor=0;;
        PAGEDOWN) ((cursor+=visible)); ((cursor>=${#entries[@]})) && cursor=$((${#entries[@]}-1));;
        HOME) cursor=0;;
        END) cursor=$((${#entries[@]}-1));;
        ENTER|RIGHT|l) enter_dir;;
        LEFT|h|BACK) go_parent;;
        TAB) switch_pane;;
        FILTER) filter_items;;
        HIDDEN)
            show_hidden=$((1-show_hidden))
            cursor=1; scroll=0
            reload
            if (( show_hidden )); then notice='File nascosti visibili.'
            else notice='File nascosti non visibili.'; fi
            ;;
        F1) user_menu;;
        F2) rename_item;;
        F3)
            select_current
            if [[ ${entries[cursor]} != '..' ]]; then
                ((cursor+1<${#entries[@]})) && ((cursor+=1))
            fi
            ;;
        F4) edit_item;;
        F5) transfer_items copy;;
        F6) transfer_items move;;
        F7) new_dir;;
        F8) delete_items;;
        ATTRIBUTES) attributes_items;;
        SYMLINK) create_symlink;;
        BAD_CHORD) notice='Ctrl+X: C per attributi, S per link simbolico.';;
        r|R) reload; notice='Elenco aggiornato.';;
        ESC) notice='Premi F10 per uscire.';;
        F10) return 1;;
        *) ;;
    esac
    return 0
}

reload
(( ${#entries[@]} > 1 )) && cursor=1
while :; do
    draw
    if ! input_key; then
        if (( resized )); then resized=0; continue; fi
        break
    fi
    if (( resized )); then resized=0; draw; fi
    if (( rows < 12 || cols < 35 )); then
        [[ $KEY == F10 ]] && break
        continue
    fi
    # Applica in blocco la navigazione gia' in coda, poi disegna una sola volta.
    # Il primo comando diverso rimane in KEY e viene eseguito normalmente.
    navigation_count=0
    while (( !filter_editing && navigation_count < 256 )) && IFS= read -rt 0 -u9; do
        case $KEY in
            UP|DOWN|PAGEUP|PAGEDOWN|HOME|END|j|k) ;;
            *) break;;
        esac
        perform_key "$KEY"
        ((navigation_count+=1))
        input_key || break
    done
    (( navigation_count )) && draw
    if [[ $KEY == MOUSE ]]; then
        KEY=''
        handle_mouse
        if [[ $KEY == F10 ]]; then break; fi
        [[ -n $KEY ]] && perform_key "$KEY" || true
        continue
    fi
    if ! perform_key "$KEY"; then
        break
    fi
done
